#!/usr/bin/env node

import { parseLocation } from '../src/parser.js';
import { geocode } from '../src/geocode.js';
import { fetchWeather } from '../src/weather.js';
import { output } from '../src/output.js';

async function main() {
  const args = process.argv.slice(2);

  if (args.length === 0) {
    console.error('Usage: weather [location]');
    console.error('  location: Norwegian place name or "lat lon" coordinates');
    process.exit(1);
  }

  const location = parseLocation(args);

  if (!location) {
    console.error('Usage: weather [location]');
    process.exit(1);
  }

  let locationName;
  let lat, lon;

  try {
    if (location.type === 'coordinates') {
      lat = location.lat;
      lon = location.lon;
      locationName = `${lat} ${lon}`;
    } else {
      const geo = await geocode(location.name);
      lat = geo.lat;
      lon = geo.lon;
      locationName = geo.placeName;
    }

    const weather = await fetchWeather(lat, lon);
    output(locationName, weather);
  } catch (err) {
    console.error(`Error: ${err.message}`);
    process.exit(1);
  }
}

main();

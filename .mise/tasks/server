#!/usr/bin/env python3
# mise description="Start the OpenAI-compatible HTTP server on port 8080"
"""Dispatch to mlx_lm.server or mlx_vlm.server based on MLX_SERVER_TYPE.

mlx-lm (default): text-only models — Qwen, GLM, Mistral, Granite, etc.
mlx-vlm:          gemma4_unified and other multimodal architectures.

Set MLX_SERVER_TYPE = "mlx-vlm" in the profile [params] to use mlx-vlm.
Set MLX_CHAT_TEMPLATE to a path to override the model's chat template.

Profile params are always re-read from disk at server startup so that
changes to a profile take effect without needing to re-run model-use.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _profiles as P

# ---------------------------------------------------------------------------
# Read the active profile from disk so the server always reflects current
# profile state, not stale mise.local.toml values. Defaults come from
# _profiles.OPTIONAL_DEFAULTS — never redeclared here.
# ---------------------------------------------------------------------------
active_profile = os.environ.get("MLX_ACTIVE_PROFILE", "").strip()
if active_profile:
    cfg = P.params_for(active_profile)
    os.environ.update(cfg)
    print(f"✓ Synced params from profiles/{active_profile}.toml")
    ignored = P.warn_ignored(active_profile, cfg)
    if ignored:
        print(f"⚠  {cfg['MLX_SERVER_TYPE']} cannot apply these profile params — they have NO effect:")
        for name in ignored:
            print(f"     {name} = {cfg[name]}")
        if cfg["MLX_SERVER_TYPE"] == "omlx":
            print("   oMLX reads its own ~/.omlx/settings.json for context/temperature.")
else:
    print("⚠  MLX_ACTIVE_PROFILE not set — using env as-is (run 'mise run model-use' to select a profile)", file=sys.stderr)

# Port is configurable so a logging proxy can sit on the default port while the
# real server moves behind it. opencode would not talk to a non-default port under
# the sandbox, so capturing its traffic means moving the server, not the client.
port          = os.environ.get("MLX_SERVER_PORT", "8080")
model         = os.environ["MLX_MODEL"]
max_tokens    = os.environ.get("MLX_MAX_TOKENS", "32768")
cache_bytes   = os.environ.get("MLX_CACHE_BYTES", "")
cache_size    = os.environ.get("MLX_CACHE_SIZE", "")
server_type   = os.environ.get("MLX_SERVER_TYPE", "mlx-lm").strip()
chat_template = os.environ.get("MLX_CHAT_TEMPLATE", "").strip()
# Extra args forwarded to tokenizer's apply_chat_template as JSON, e.g.:
#   '{"enable_thinking": false}'  — disables <think> blocks in GLM/Qwen3 thinking models
chat_template_args = os.environ.get("MLX_CHAT_TEMPLATE_ARGS", "").strip()
# Sampling temperature. mlx_lm.server defaults to 0.0 (greedy), which causes
# infinite repetition loops — once a high-probability token pattern starts, greedy
# decoding reinforces it and the model cannot escape. 0.6 is the standard coding
# trade-off: low enough to keep outputs deterministic and structured, high enough
# to break degenerate loops. Observed symptom at temp=0.0: 'node:util: JSON.stringify
# (9;' repeated endlessly during GLM-4.7-Flash evaluation (2026-06-19).
# Override per-model via MLX_TEMP in [params] if a model needs different behaviour.
temp  = os.environ.get("MLX_TEMP", "0.6").strip()
# Nucleus sampling top-p. Override via MLX_TOP_P in [params] (default 1.0 = full distribution).
top_p = os.environ.get("MLX_TOP_P", "1.0").strip()
# Additional sampling knobs — several model cards publish recommended values
# (e.g. Qwen: top_k 20, min_p 0). 0 / 0.0 disables each.
top_k = os.environ.get("MLX_TOP_K", "0").strip()
min_p = os.environ.get("MLX_MIN_P", "0.0").strip()
# Speculative decoding for mlx-lm: a small model drafts tokens the big one verifies.
# This is the mlx-lm equivalent of the MTP drafter oMLX uses (2-3x on Qwen3.8).
draft_model  = os.environ.get("MLX_DRAFT_MODEL", "").strip()
num_draft    = os.environ.get("MLX_NUM_DRAFT_TOKENS", "").strip()
# Prefill batch size. Lower values shrink the activation spike during prompt
# processing — the spike that OOM'd GLM-4.7-Flash and Qwen3.5-27B on rig A.
prefill_step = os.environ.get("MLX_PREFILL_STEP_SIZE", "").strip()
trust_remote = os.environ.get("MLX_TRUST_REMOTE_CODE", "").strip()

# Resolve chat_template relative to workspace root if it's a relative path
if chat_template and not os.path.isabs(chat_template):
    workspace = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    chat_template = os.path.join(workspace, chat_template)

if server_type == "omlx":
    print(f"→ Starting omlx server (model requires oMLX)")
    print(f"  model:      {model}")
    print(f"  Note: oMLX auto-discovers from Hugging Face cache.")
    cmd = ["omlx", "serve", "--port", port]
    for flag, var in (
        ("--memory-guard",            "MLX_OMLX_MEMORY_GUARD"),
        ("--memory-guard-gb",         "MLX_OMLX_MEMORY_GUARD_GB"),
        ("--hot-cache-max-size",      "MLX_OMLX_HOT_CACHE_MAX_SIZE"),
        ("--paged-ssd-cache-max-size", "MLX_OMLX_SSD_CACHE_MAX_SIZE"),
    ):
        val = os.environ.get(var, "").strip()
        if val:
            cmd += [flag, val]
            print(f"  {flag}: {val}")
elif server_type == "mlx-vlm":
    print(f"→ Starting mlx_vlm.server  (model_type requires mlx-vlm)")
    print(f"  model:      {model}")
    print(f"  max-tokens: {max_tokens}")
    print(f"  Note: mlx-vlm does not support prompt-cache-bytes/size — using default caching")
    print()
    cmd = [
        "python", "-m", "mlx_vlm.server",
        "--model", model,
        "--port", port,
        "--max-tokens", max_tokens,
    ]
else:
    print(f"→ Starting mlx_lm.server")
    print(f"  model:       {model}")
    print(f"  max-tokens:  {max_tokens}")
    print(f"  temp:        {temp}")
    print(f"  top-p:       {top_p}")
    if top_k != "0":
        print(f"  top-k:       {top_k}")
    if min_p != "0.0":
        print(f"  min-p:       {min_p}")
    if draft_model:
        print(f"  draft-model: {draft_model}  (speculative decoding)")
    if prefill_step:
        print(f"  prefill-step-size: {prefill_step}")
    print(f"  cache-bytes: {cache_bytes}")
    print(f"  cache-size:  {cache_size}")
    if chat_template:
        print(f"  chat-template: {chat_template}")
    if chat_template_args:
        print(f"  chat-template-args: {chat_template_args}")
    print()
    cmd = [
        "mlx_lm.server",
        "--model", model,
        "--port", port,
        "--max-tokens", max_tokens,
        "--temp", temp,
        "--top-p", top_p,
    ]
    if cache_size:
        cmd += ["--prompt-cache-size", cache_size]
    if cache_bytes:
        cmd += ["--prompt-cache-bytes", cache_bytes]
    if chat_template:
        cmd += ["--chat-template", chat_template]
    if chat_template_args:
        cmd += ["--chat-template-args", chat_template_args]
    if top_k != "0":
        cmd += ["--top-k", top_k]
    if min_p != "0.0":
        cmd += ["--min-p", min_p]
    if draft_model:
        cmd += ["--draft-model", draft_model]
        if num_draft:
            cmd += ["--num-draft-tokens", num_draft]
    if prefill_step:
        cmd += ["--prefill-step-size", prefill_step]
    if trust_remote:
        cmd += ["--trust-remote-code"]

os.execvp(cmd[0], cmd)

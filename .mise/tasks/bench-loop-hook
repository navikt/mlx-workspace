#!/usr/bin/env python3
# mise description="Does the #939 loop-guard hook work inside cplt? One provoked-loop cloud Copilot session through nav-pilot. Usage: mise run bench-loop-hook -- [cloud-model]"
"""navikt/copilot#939 writes ~/.copilot/hooks/nav-pilot-loop-guard.json at launch; the
hook runs `nav-pilot hook loop-guard` after every tool call. It first kept its count in
~/.nav-pilot/hook-state/, which cplt denies (read and write) along with the config, so
inside the sandbox it failed open on every call. Since the fix it keeps the count in the
session's own dir, ~/.copilot/session-state/<id>/nav-pilot-loop-guard.json, and takes its
settings from the hook command when the config is out of reach.

One cloud session (default gpt-5-mini) in a scratch git repo, told to re-read a file
that never changes, with only the view tool. Pass when both hold:
  - the model saw "[nav-pilot loop guard]" in a tool result (the session's own events.jsonl)
  - a state file for that session appeared (session dir, or the old ~/.nav-pilot/hook-state)
Writes bench/loop-hook-<stamp>.json always, also on timeout. Exit 0 when a session ran
(pass or fail is in the file), 1 when none did. Takes no queue lock: no GPU, no local server.
To test a build's hook, put that nav-pilot first on PATH: the hook finds it there.
"""
import errno
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
sys.path.insert(0, str(HERE))
HOME = Path.home()
MARK = "[nav-pilot loop guard]"
STATE_DIR = HOME / ".nav-pilot" / "hook-state"  # before the fix
STATE_NAME = "nav-pilot-loop-guard.json"  # in the session dir, after it
SESSIONS = HOME / ".copilot" / "session-state"
HOOK_FILE = HOME / ".copilot" / "hooks" / "nav-pilot-loop-guard.json"
CAP = int(os.environ.get("LOOP_HOOK_TIMEOUT", "600"))


def tree(pid):
    """pid and its descendants, children first."""
    kids = subprocess.run(["pgrep", "-P", str(pid)], capture_output=True, text=True).stdout.split()
    return [d for k in kids for d in tree(int(k))] + [pid]


def kill_tree(pid):
    """Stop a process tree by pid. os.killpg fails with EPERM once cplt has sandboxed
    part of the group, which lost the night-2 result; signal each pid instead and
    ignore the ones that are gone or refuse."""
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for p in tree(pid):
            try:
                os.kill(p, sig)
            except OSError as e:
                if e.errno not in (errno.ESRCH, errno.EPERM):
                    raise
        time.sleep(5)


def main():
    from _np_checks import SESSIONS as PROMPTS
    model = sys.argv[1] if len(sys.argv) > 1 else "gpt-5-mini"
    np = os.environ.get("BENCH_NAV_PILOT") or str(sorted((ROOT / ".bench-logs" / "bin").glob("nav-pilot-main-*"),
                                                         key=lambda p: p.stat().st_mtime)[-1])
    stamp = time.strftime("%Y%m%d-%H%M%S")
    out = ROOT / "bench" / f"loop-hook-{stamp}.json"
    work = ROOT / ".bench-logs" / "loop-hook-work" / stamp
    work.mkdir(parents=True)
    files, prompt = PROMPTS["loop"]
    for name, body in files.items():
        (work / name).write_text(body)
    # cplt takes the project from the git root; a repo of its own keeps it to this dir.
    for cmd in (["git", "init", "-q"], ["git", "add", "-A"],
                ["git", "-c", "commit.gpgsign=false", "-c", "user.name=bench", "-c", "user.email=bench@localhost",
                 "commit", "-qm", "loop-hook fixture"]):
        subprocess.run(cmd, cwd=work, check=True)

    # A scratch nav-pilot config: no auto-update, no local server. The launch writes the
    # hook settings from it into the hook command; inside cplt the hook cannot read any
    # config (NAV_PILOT_CONFIG is not passed and ~/.nav-pilot is denied) and uses those.
    cfg = ROOT / ".bench-logs" / f"loop-hook-{stamp}.config.toml"
    user = (HOME / ".nav-pilot" / "config.toml").read_text().splitlines()
    keep = [l for l in user if l.split("=")[0].strip() not in ("auto_update", "local_enabled", "local_autostart")]
    cfg.write_text("auto_update = false\nlocal_enabled = false\nlocal_autostart = false\n" + "\n".join(keep) + "\n")
    env = {**os.environ, "NAV_PILOT_CONFIG": str(cfg)}
    tok = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True).stdout.strip()
    if tok:
        env["COPILOT_GITHUB_TOKEN"] = tok

    state_before = {p.name: p.stat().st_mtime for p in STATE_DIR.glob("*")} if STATE_DIR.exists() else {}
    sessions_before = {p.name for p in SESSIONS.iterdir()} if SESSIONS.exists() else set()
    log = ROOT / ".bench-logs" / f"loop-hook-{stamp}.log"
    argv = [np, "--client", "copilot", "--model", model, "--", "--allow-all-tools", "--excluded-tools=bash",
            "--deny-tool=shell", "--no-ask-user", "-p", prompt]
    started = time.time()
    timed_out = False
    with log.open("w") as fh:
        fh.write(f"# argv: {argv!r}\n# cwd: {work}\n")
        fh.flush()
        proc = subprocess.Popen(argv, cwd=work, stdout=fh, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                env=env, start_new_session=True)
        try:
            rc = proc.wait(timeout=CAP)
        except subprocess.TimeoutExpired:
            timed_out = True
            kill_tree(proc.pid)
            try:
                rc = proc.wait(timeout=30)
            except subprocess.TimeoutExpired:
                rc = None
    cfg.unlink(missing_ok=True)
    text = log.read_text(errors="replace")

    # Only session dirs that are new since the launch, and only the one started in our dir.
    events, sid = [], None
    for d in sorted((SESSIONS.iterdir() if SESSIONS.exists() else []), key=lambda p: p.stat().st_mtime, reverse=True):
        f = d / "events.jsonl"
        if d.name in sessions_before or not f.exists():
            continue
        first = json.loads(f.open().readline() or "{}")
        ctx = (first.get("data") or {}).get("context") or {}
        if str(work) in (ctx.get("cwd"), ctx.get("gitRoot")):
            events = [json.loads(l) for l in f.open() if l.strip()]
            sid = (first.get("data") or {}).get("sessionId") or d.name
            break
    marked = [e["type"] for e in events if MARK in json.dumps(e)]
    in_tool_result = any(e["type"] == "tool.execution_complete" and MARK in json.dumps(e.get("data")) for e in events)
    views = sum(1 for e in events if e["type"] == "tool.execution_complete")
    hook_starts = sum(1 for e in events if e["type"] == "hook.start")
    session_state = SESSIONS / sid / STATE_NAME if sid else None

    state_new = sorted(p.name for p in STATE_DIR.glob("*")
                       if p.name not in state_before or p.stat().st_mtime > state_before[p.name]) if STATE_DIR.exists() else []
    state_for_session = [n for n in state_new if sid and sid.replace("-", "") in n.replace("-", "")]
    if session_state and session_state.exists():
        state_for_session.append(str(session_state))
    try:  # what the sandbox grants on ~/.nav-pilot, for a FAIL's why
        profile = subprocess.run(["cplt", "--print-profile"], cwd=work, capture_output=True, text=True, timeout=60)
        nav_pilot_rules = [l.strip() for l in (profile.stdout + profile.stderr).splitlines() if ".nav-pilot" in l][:20]
    except (OSError, subprocess.TimeoutExpired) as e:
        nav_pilot_rules = [f"cplt --print-profile failed: {e}"]

    rec = {
        "model": model, "nav_pilot": np, "hook_on_path": subprocess.run(["sh", "-c", "command -v nav-pilot"],
                                                                         capture_output=True, text=True).stdout.strip(),
        "started": time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(started)),
        "seconds": round(time.time() - started, 1), "exit": rc, "timed_out": timed_out,
        "log": str(log.relative_to(ROOT)), "work": str(work),
        "hook_file": HOOK_FILE.read_text() if HOOK_FILE.exists() else None,
        "in_sandbox": "Starting Copilot in sandbox" in text,
        "session_id": sid, "tool_calls": views, "hook_events": hook_starts,
        "state_dir": str(session_state.parent) if session_state else None,
        "marker_event_types": marked, "marker_in_tool_result": in_tool_result,
        "hook_state_new": state_new, "hook_state_for_session": state_for_session,
        "cplt_profile_nav_pilot_rules": nav_pilot_rules,
    }
    rec["pass"] = bool(in_tool_result and state_for_session)
    rec["verdict"] = (
        "PASS: the hook ran inside the sandbox, kept its state and the model saw the warning" if rec["pass"] and rec["in_sandbox"] else
        "PASS (outside the sandbox)" if rec["pass"] else
        "no session: see the log" if not events else
        f"FAIL: session made {views} tool calls; marker {'seen' if in_tool_result else 'not seen'}, "
        f"state file {'written' if state_for_session else 'not written'}"
        + ("; the hook failed open (state dir not writable inside cplt?)" if not state_new else ""))
    out.write_text(json.dumps(rec, indent=2) + "\n")
    print(json.dumps(rec, indent=2))
    print(f"{'✓' if rec['pass'] else '✗'} {rec['verdict']} · {out.relative_to(ROOT)}")
    sys.exit(0 if events else 1)


if __name__ == "__main__":
    main()

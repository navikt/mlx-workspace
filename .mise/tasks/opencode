#!/usr/bin/env python3
# mise description="Start opencode in workspaces/<model-key>/ for per-model output isolation"
"""Launch opencode from workspaces/<active-profile-key>/.

Each model's sessions, generated files, and outputs stay in their own directory,
making it easy to compare results across models later.
"""
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _sandbox as S

key = os.environ.get("MLX_ACTIVE_PROFILE", "").strip()
if not key:
    print("✗ MLX_ACTIVE_PROFILE not set — run: mise run model-use", file=sys.stderr)
    sys.exit(1)

workspace = Path(__file__).resolve().parents[2]  # repo root
workspace_dir = workspace / "workspaces" / key
workspace_dir.mkdir(parents=True, exist_ok=True)

# Provision the weather-cli challenge spec into the model workspace
weather_cli_dir = workspace_dir / "weather-cli"
weather_cli_dir.mkdir(exist_ok=True)
shutil.copy2(workspace / "WEATHER_CLI_SPEC.md", weather_cli_dir / "WEATHER_CLI_SPEC.md")

# opencode reads AGENTS.md from its working directory, which is workspaces/<key>/,
# not the repo root. Copy the current rules in on every launch so rule edits
# at the root always reach the model being tested.
S.check_prompt(workspace / "AGENTS.md")
shutil.copy2(workspace / "AGENTS.md", workspace_dir / "AGENTS.md")

print(f"→ Starting opencode in {workspace_dir.relative_to(workspace)}/")

# Write fresh opencode.json into the workspace dir (points at the local AGENTS.md)
result = subprocess.run(
    ["mise", "run", "opencode-init", str(workspace_dir)],
    cwd=str(workspace),
)
if result.returncode != 0:
    print("✗ opencode-init failed", file=sys.stderr)
    sys.exit(result.returncode)

# Launch opencode with workspaces/<key> as working directory, inside the cplt
# sandbox. Flag construction lives in _sandbox.py so headless runs cannot end up
# with a different, weaker policy than interactive ones.
server_port = os.environ.get("MLX_SERVER_PORT", "8080")
os.chdir(workspace_dir)

os.environ.update(S.bench_env(os.environ))
argv = S.cplt_argv(workspace_dir, workspace, server_port)
if argv:
    os.execvp("cplt", argv + ["--", "--pure", *sys.argv[1:]])

S.warn_unsandboxed(sys.stderr)
os.execvp("opencode", ["opencode", "--pure"] + sys.argv[1:])

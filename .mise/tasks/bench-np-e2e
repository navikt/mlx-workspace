#!/usr/bin/env bash
# mise description="Refutation checks for shipping a profile in nav-pilot: E2E through the loop guard, peak memory, latency. Usage: mise run bench-np-e2e -- <profile> [--latency-only]"
#
# PLAN.md section 12. Everything here runs against nav-pilot's OWN server, started
# by `nav-pilot alpha local start` from nav-pilot's venv, because that is the runtime
# a developer gets (mlx-lm 0.31.3 today, where the workspace server runs 0.32.0).
#
#   lock -> model-use -> stop :8080 -> manifest entry gets the profile's params
#   -> nav-pilot alpha local start -> sanity -> footprint sampler
#   -> latency / classifier / reasoning_effort probes
#   -> bench-copilot rungs through nav-pilot, classifier on then off (unless --latency-only)
#   -> verdicts -> stop, restore the manifest
#
# The manifest: nav-pilot starts whatever entry matches the configured model id,
# and nopin shares its HF id with the pinned qwen3.8-27b-8bit-mlx entry. So the
# cached manifest (~/.nav-pilot/local-models.json) has that entry's params swapped
# for the profile's for the duration, and `start` is kept off the network so it
# reads the cache instead of refetching. Restored on exit, whatever the exit.
set -uo pipefail
cd "$(dirname "$0")/../.." || exit 1

profile="${1:-}"; mode="${2:-}"
[ -f "profiles/$profile.toml" ] || { echo "usage: mise run bench-np-e2e -- <profile> [--latency-only]"; exit 2; }
case "$mode" in ""|--latency-only) ;; *) echo "unknown flag $mode"; exit 2 ;; esac
NP="${BENCH_NAV_PILOT:-$PWD/.bench-logs/bin/nav-pilot-e72319e0}"
[ -x "$NP" ] || { echo "✗ no nav-pilot binary at $NP (build feat/local-system-one-loop-guard there, or set BENCH_NAV_PILOT)"; exit 2; }

# Same lock and wait semantics as bench-models; see the reasoning there.
LOCKDIR=".bench-logs/.queue.lock"
while ! mkdir "$LOCKDIR" 2>/dev/null; do
  holder=$(cat "$LOCKDIR/pid" 2>/dev/null)
  [ -n "$holder" ] || [ $(( $(date +%s) - $(stat -f %m "$LOCKDIR") )) -gt 10 ] || { sleep 1; continue; }
  if kill -0 "$holder" 2>/dev/null; then
    [ -n "${BENCH_WAIT:-}" ] && { sleep 60; continue; }
    echo "✗ another benchmark queue is running (pid $holder). Two queues share one port and"
    echo "  will kill each other's servers mid-task. Wait for it, or stop it first."
    echo "  BENCH_WAIT=1 queues behind it instead."
    exit 1
  fi
  echo "→ clearing a stale lock from pid $holder, which is gone"
  rm -rf "$LOCKDIR"
done
echo $$ > "$LOCKDIR/pid"

STAMP="$(date +%Y%m%d-%H%M%S)"
LOG=".bench-logs/np-e2e-$profile-$STAMP.log"
OUT="bench/np-e2e-$profile-$STAMP.json"
FPLOG=".bench-logs/np-e2e-$profile-$STAMP.footprint"
export NAV_PILOT_CONFIG="$PWD/.bench-logs/np-e2e-$STAMP.config.toml"
export BENCH_NAV_PILOT="$NP"
CACHE="$HOME/.nav-pilot/local-models.json"
BACKUP="$CACHE.np-e2e-$$"
started_np="" sampler=""

say() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$LOG"; }

cleanup() {
  [ -n "$sampler" ] && kill "$sampler" 2>/dev/null
  [ -n "$started_np" ] && "$NP" alpha local stop >>"$LOG" 2>&1
  [ -f "$BACKUP" ] && mv -f "$BACKUP" "$CACHE"
  rm -f "$NAV_PILOT_CONFIG"
  rm -rf "$LOCKDIR"
}
# EXIT does the work; INT/TERM only exit, so an interrupted run does not carry on
# after the lock is gone.
trap cleanup EXIT
trap 'exit 130' INT TERM

say "=== bench-np-e2e $profile ${mode:-full} · nav-pilot $NP"
mise run server-stop >>"$LOG" 2>&1
mise run model-use "$profile" >>"$LOG" 2>&1 || { say "✗ could not switch profile"; exit 1; }
MODEL=$(python3 -c "
import sys; sys.path.insert(0,'.mise/tasks'); import _profiles as P
print(P.load('$profile')[1]['MLX_MODEL'])")
WANT_ARGS=$(python3 -c "
import sys; sys.path.insert(0,'.mise/tasks'); import _profiles as P
print(P.load('$profile')[1].get('MLX_CHAT_TEMPLATE_ARGS',''))")

# A nav-pilot server already up is someone's session, not ours to kill.
STATE="$HOME/.nav-pilot/local/server.json"
if [ -f "$STATE" ] && kill -0 "$(python3 -c "import json; print(json.load(open('$STATE'))['pid'])")" 2>/dev/null; then
  say "✗ a nav-pilot local server is already running ($STATE); refusing to measure beside it"; exit 1
fi

{ echo 'auto_update = false'; echo 'local_enabled = true'; echo 'local_autostart = false'
  echo "local_model = \"$MODEL\""
  grep -vE '^(auto_update|local_enabled|local_autostart|local_model)[[:space:]]*=' "$HOME/.nav-pilot/config.toml"
} > "$NAV_PILOT_CONFIG"

cp "$CACHE" "$BACKUP" || { say "✗ could not back up $CACHE"; exit 1; }
python3 .mise/tasks/_np_checks.py manifest "$profile" "$CACHE" >>"$LOG" 2>&1 || { say "✗ manifest"; exit 1; }

# Unreachable proxy: Resolve's fetch fails and start falls back to the cache we
# just wrote. Go never proxies 127.0.0.1, so the readiness probe is unaffected.
started_np=1
if ! HTTPS_PROXY=http://127.0.0.1:9 HTTP_PROXY=http://127.0.0.1:9 "$NP" alpha local start >>"$LOG" 2>&1; then
  say "✗ nav-pilot alpha local start failed, see $LOG"; exit 1
fi
read -r SPID PORT SMODEL < <(python3 -c "
import json,os; s=json.load(open('$STATE'))
print(s.get('pid'), s.get('port'), s.get('model'))")
ARGV=$(ps -ww -o command= -p "$SPID")
say "  server pid $SPID port $PORT model $SMODEL"
say "  argv: $ARGV"
[ "$SMODEL" = "$MODEL" ] || { say "✗ nav-pilot serves $SMODEL, profile names $MODEL"; exit 1; }
case "$ARGV" in *"--chat-template-args $WANT_ARGS"*) ;; *) say "✗ server argv lacks --chat-template-args $WANT_ARGS"; exit 1 ;; esac

reply=$(curl -s -m 300 "http://127.0.0.1:$PORT/v1/chat/completions" -H 'Content-Type: application/json' \
  -d "{\"model\":\"$MODEL\",\"max_tokens\":16,\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: OK\"}]}" \
  | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: print('NO-JSON'); raise SystemExit
c=d.get('choices'); print((c[0]['message'].get('content') or '').strip() if c else 'ERROR:'+str(d)[:80])")
case "$reply" in *OK*) say "  sanity ok" ;; *) say "✗ server answered $(printf '%q' "$reply") — refusing to measure"; exit 1 ;; esac

( while :; do
    b=$(footprint -p "$SPID" -f bytes --noCategories 2>/dev/null | sed -n 's/.*Footprint: \([0-9]*\) B.*/\1/p')
    [ -n "$b" ] && echo "$(date +%s) $b"
    sleep 2
  done ) > "$FPLOG" &
sampler=$!

python3 - "$OUT" "$profile" "$MODEL" "$NP" "$ARGV" <<'EOF'
import json, subprocess, sys
out, profile, model, np, argv = sys.argv[1:]
venv = subprocess.run([__import__("os").path.expanduser("~/.nav-pilot/local/venv/bin/python"), "-c",
                       "import mlx_lm, mlx.core as mx; print(mlx_lm.__version__, mx.__version__)"],
                      capture_output=True, text=True).stdout.split()
sysctl = lambda k: subprocess.run(["sysctl", "-n", k], capture_output=True, text=True).stdout.strip()
json.dump({"profile": profile, "model": model, "nav_pilot": np,
           "nav_pilot_commit": "e72319e0" if np.endswith("e72319e0") else None,
           "server_argv": argv, "mlx_lm": venv[:1], "mlx": venv[1:],
           "chip": sysctl("machdep.cpu.brand_string"), "ram_bytes": int(sysctl("hw.memsize")),
           "wired_limit_mb": sysctl("iogpu.wired_limit_mb")}, open(out, "w"), indent=2)
EOF

say "--- latency, classifier and reasoning_effort probes"
PYTHONUNBUFFERED=1 python3 .mise/tasks/_np_checks.py probe "$OUT" "$PORT" "$MODEL" 2>&1 | tee -a "$LOG"

if [ "$mode" != "--latency-only" ]; then
  for state in on off; do
    say "--- E2E through nav-pilot, classifier $state"
    NAV_PILOT_LOOP_CLASSIFIER=$state PYTHONUNBUFFERED=1 \
      python3 .mise/tasks/_np_checks.py e2e "$OUT" "$state" 2>&1 | tee -a "$LOG"
  done
fi

kill "$sampler" 2>/dev/null; sampler=""
say "--- verdicts (PLAN.md section 12)"
python3 .mise/tasks/_np_checks.py finish "$OUT" "$FPLOG" 2>&1 | tee -a "$LOG"
say "=== done: $OUT"

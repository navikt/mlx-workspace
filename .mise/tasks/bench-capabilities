#!/usr/bin/env python3
# mise description="Apply the local-vs-cloud bar to bench results and write manifest/capabilities.json. Usage: mise run bench-capabilities [--check] [--self-check]"
"""The bar from reports/2026-09-24-local-vs-cloud-routing/design.md §2.1.

A class C is trusted for model m in mode M when, under ONE condition:

  1. floor     >= 5 runs and >= 2 distinct tasks
  2. quality   wilson_lower(k, n, one-sided 90%) >= X * p_cloud(C)
               X = 0.90 where a failure gets caught, 0.95 where it is silent;
               p_cloud is the pooled cloud point estimate, 1.0 with no cloud arm
  3. delegate  the pooled hybrid/control cost ratio is at most 1: the median cost of
               every dispatched sample over the median of every paired control
               sample, across all of the class's priced cells

Verdicts per class and mode:

  trusted   all three hold
  not-yet   the point estimate clears the bar, the evidence does not yet
  cloud     no data, the point estimate is already below the bar, or
            delegating saves nothing

A model's verdict for a class is the best one any single condition gives it,
and the evidence reported is that condition's. Conditions are never pooled.
# ponytail: best-of-conditions treats every condition as one users get. Weight
# by the production condition (temperature 0, the shipped profile) once there
# is enough data at it for that to matter.

Output: manifest/capabilities.json, keyed by the Hugging Face model id so
`model-manifest` can attach a block to each offered entry by its MLX_MODEL.
The file carries the evidence (k/n, LB, runs, source files); the block that
reaches nav-pilot carries enums and counts only (design §3a, trust boundary).

Bench-only trust (#147): a worker whose shipped block trusts nothing never arms
the dispatch gate, so its delegation can only be measured under a trust overlay
(BENCH_CAPABILITIES_OVERRIDE). Those samples go to `delegate_probe`, a separate
tally marked shipped: false. They never reach `models` or `manifest_blocks`, and
model-manifest reads neither this key nor the frontier's feed. A person promotes a
class by hand when its tally clears the delegate bar.
"""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
import _by_class as B  # noqa: E402

ROOT = Path(__file__).resolve().parents[2]
OUT = ROOT / "manifest" / "capabilities.json"

CLASSES = ["read-qa", "edit-single", "edit-multi-mechanical", "create-file", "debug"]
SILENT = {"read-qa", "debug"}  # a wrong answer or diagnosis looks like a right one
BAR = {"confidence": 0.90, "x_caught": 0.90, "x_silent": 0.95, "min_runs": 5, "min_tasks": 2}
RANK = {"cloud": 0, "not-yet": 1, "trusted": 2}


def verdict(cls, mode, k, n, tasks, runs, p_cloud, ratio):
    if n == 0:
        return "cloud", None
    bar = (BAR["x_silent"] if cls in SILENT else BAR["x_caught"]) * p_cloud
    if k / n < bar:
        return "cloud", bar
    if mode == "delegate" and ratio is not None and ratio > 1:
        return "cloud", bar  # delegating saves nothing, so take no risk for it
    if (runs < BAR["min_runs"] or tasks < BAR["min_tasks"] or B.wilson_lower(k, n) < bar
            or (mode == "delegate" and ratio is None)):
        return "not-yet", bar
    return "trusted", bar


def p_clouds(rows):
    """{class: pooled cloud pass rate}, 1.0 for a class with no cloud arm."""
    cloud = {}
    for r in rows:
        if r["mode"] == "cloud":
            k, n = cloud.get(r["class"], (0, 0))
            cloud[r["class"]] = (k + r["k"], n + r["n"])
    return {c: (cloud[c][0] / cloud[c][1] if cloud.get(c, (0, 0))[1] else 1.0) for c in CLASSES}


def score(rows):
    """rows: list of B.as_json rows. Returns {model: {class: {mode: evidence}}}."""
    pc = p_clouds(rows)
    models = sorted({r["model"] for r in rows if r["mode"] != "cloud"})
    out = {}
    for m in models:
        out[m] = {}
        for cls in CLASSES:
            p_cloud = pc[cls]
            out[m][cls] = {}
            for mode in ("delegate", "local"):
                best = {"verdict": "cloud", "k": 0, "n": 0, "note": "no data"}
                for r in rows:
                    if (r["model"], r["class"], r["mode"]) != (m, cls, mode):
                        continue
                    v, bar = verdict(cls, mode, r["k"], r["n"], len(r["tasks"]), r["runs"],
                                     p_cloud, r.get("pooled_cost_ratio"))
                    cand = {"verdict": v, "k": r["k"], "n": r["n"], "lb": r["lb"],
                            "bar": bar and round(bar, 3), "p_cloud": round(p_cloud, 3),
                            "runs": r["runs"], "tasks": r["tasks"], "condition": r["condition"],
                            "cost_ratios": r["cost_ratios"],
                            "pooled_cost_ratio": r.get("pooled_cost_ratio"), "files": r["files"]}
                    if (RANK[v], r["n"]) > (RANK[best["verdict"]], best["n"]):
                        best = cand
                out[m][cls][mode] = best
    return out


def probe_tally(probe_rows, rows):
    """Overlay rows (mode delegate-probe) per model and class, each with the verdict the
    delegate bar would give it. Not shipped: nothing here reaches a manifest block."""
    if any(r["mode"] != "delegate-probe" for r in probe_rows):
        raise SystemExit("✗ probe_tally got a row that is not a bench-only overlay row")
    pc = p_clouds(rows)
    out = {}
    for r in sorted(probe_rows, key=lambda r: (r["model"], r["class"], r["condition"])):
        v, bar = verdict(r["class"], "delegate", r["k"], r["n"], len(r["tasks"]), r["runs"],
                         pc[r["class"]], r.get("pooled_cost_ratio"))
        out.setdefault(r["model"], {}).setdefault(r["class"], []).append(
            {**r, "shipped": False, "bar_verdict": v, "bar": bar and round(bar, 3)})
    return {"note": "Bench-only trust overlay samples (BENCH_CAPABILITIES_OVERRIDE, #147). NOT SHIPPED: "
                    "never in models or manifest_blocks. Promote a class by hand when bar_verdict is trusted.",
            "models": out}


def manifest_block(per_class):
    """What nav-pilot reads: enums and integers, nothing else."""
    return {
        "bar": BAR,
        "classes": {cls: {"delegate": v["delegate"]["verdict"], "local": v["local"]["verdict"],
                          "delegate_k": v["delegate"]["k"], "delegate_n": v["delegate"]["n"],
                          "local_k": v["local"]["k"], "local_n": v["local"]["n"]}
                    for cls, v in per_class.items()},
    }


def build():
    rows = [B.as_json(r) for r in B.rows().values()]
    probe = [B.as_json(r) for r in B.rows(probe=True).values()]
    models = score(rows)
    none = {"verdict": "cloud", "k": 0, "n": 0}
    return {
        "note": "Generated by 'mise run bench-capabilities' from bench/. Do not edit by hand. "
                "Rules: reports/2026-09-24-local-vs-cloud-routing/design.md §2.",
        "bar": BAR,
        "excluded_tasks": {t: v["reason"] for t, v in json.loads(
            (B.BENCH / "task-classes.json").read_text())["tasks"].items()
            if v.get("exclude_from_bar")},
        # What model-manifest copies into each entry, by MLX_MODEL. A model with
        # no runs gets the unmeasured block: cloud everywhere, never no block.
        "manifest_blocks": {m: manifest_block(v) for m, v in models.items()},
        "unmeasured_block": manifest_block({c: {"delegate": none, "local": none} for c in CLASSES}),
        "models": models,
        "delegate_probe": probe_tally(probe, rows),
    }


def self_check():
    v = lambda *a: verdict(*a)[0]  # noqa: E731
    # design §2.2, row by row
    assert v("edit-multi-mechanical", "delegate", 35, 35, 2, 35, 1.0, 0.62) == "trusted"
    assert v("edit-single", "delegate", 3, 3, 1, 3, 1.0, 1.02) == "cloud"        # saves nothing
    assert v("edit-multi-mechanical", "delegate", 35, 35, 2, 35, 1.0, 1.0) == "trusted"  # pooled 1.00 counts
    assert v("read-qa", "delegate", 0, 0, 0, 0, 1.0, None) == "cloud"                 # never delegated
    assert v("create-file", "delegate", 1, 2, 1, 2, 1.0, None) == "cloud"
    assert v("read-qa", "local", 12, 12, 3, 4, 1.0, None) == "not-yet"               # floor: 4 runs
    assert v("read-qa", "local", 15, 15, 3, 15, 1.0, None) == "not-yet"              # 0.901 < 0.95
    assert v("edit-single", "local", 15, 15, 2, 15, 1.0, None) == "trusted"          # 0.901 >= 0.90
    assert v("edit-single", "local", 10, 11, 2, 11, 1.0, None) == "not-yet"          # 0.739
    assert v("edit-multi-mechanical", "local", 7, 8, 2, 4, 1.0, None) == "cloud"     # 0.875 < 0.90
    assert v("debug", "local", 0, 3, 3, 3, 1.0, None) == "cloud"
    # a weaker cloud lowers the bar; silent classes need more
    assert v("edit-single", "local", 9, 11, 2, 11, 0.5, None) == "trusted"
    assert v("debug", "local", 16, 16, 2, 16, 1.0, None) == "not-yet"
    # a trusted delegate needs a measured saving
    assert v("edit-multi-mechanical", "delegate", 35, 35, 2, 35, 1.0, None) == "not-yet"
    # best condition wins, conditions are not pooled
    rows = [
        {"class": "edit-single", "model": "m", "mode": "local", "condition": "a", "k": 7, "n": 8,
         "tasks": ["E1", "E3"], "runs": 4, "lb": 0.66, "cost_ratios": {}, "files": ["a.json"]},
        {"class": "edit-single", "model": "m", "mode": "local", "condition": "b", "k": 3, "n": 3,
         "tasks": ["E1"], "runs": 3, "lb": 0.646, "cost_ratios": {}, "files": ["b.json"]},
    ]
    s = score(rows)["m"]
    assert s["edit-single"]["local"]["verdict"] == "not-yet", s
    assert s["edit-single"]["local"]["condition"] == "b"
    assert s["debug"]["local"] == {"verdict": "cloud", "k": 0, "n": 0, "note": "no data"}
    blk = manifest_block(s)
    assert blk["classes"]["edit-single"] == {"delegate": "cloud", "local": "not-yet", "delegate_k": 0,
                                              "delegate_n": 0, "local_k": 3, "local_n": 3}
    assert all(isinstance(x, (str, int)) for c in blk["classes"].values() for x in c.values())
    overlay_check()
    print("✓ bench-capabilities self-check passed")


def overlay_check():
    """#147: samples under a bench-only trust overlay are tallied apart and change no
    verdict, no manifest block and nothing model-manifest copies."""
    import tempfile
    real = B.BENCH
    with tempfile.TemporaryDirectory() as t:
        B.BENCH = Path(t)
        try:
            for f in ("task-classes.json", "tasks.json"):
                (B.BENCH / f).write_text((real / f).read_text())
            tid = next(k for k, v in json.loads((real / "task-classes.json").read_text())["tasks"].items()
                       if v["class"] == "edit-multi-mechanical" and not v.get("exclude_from_bar"))
            snap = {"cloud_model": "c", "local_model": "w"}
            smp = lambda cost, **kw: {"valid": True, "verified": True, "preflight": 0, "cloud_cost_usd": cost,
                                      "policy": {"sha256": "ab" * 32}, **kw}
            ctrl = {"arm": "control", "tag": "t", "rung": 4, "task": tid, "preflight": [snap],
                    "samples": [smp(1.0), smp(1.0)]}
            (B.BENCH / "hybrid-t-4-control.json").write_text(json.dumps(ctrl))
            hyb = {"arm": "hybrid", "tag": "t", "rung": 4, "task": tid, "worker_profile": "w", "preflight": [snap],
                   "samples": [smp(0.5, local_calls=2) for _ in range(6)]}

            def write(over):
                hyb["preflight"][0] = {**snap, "bench_capabilities_override": over}
                (B.BENCH / "hybrid-t-w-4-hybrid.json").write_text(json.dumps(hyb))
                return build()

            shipped = write(None)       # the same samples without an overlay: they count
            assert shipped["models"]["w"]["edit-multi-mechanical"]["delegate"]["n"] == 6, shipped["models"]
            assert shipped["delegate_probe"]["models"] == {}
            probed = write({"classes": {"edit-multi-mechanical": {"delegate": "trusted"}}})
            # Nothing of the overlay reaches a verdict, a block or the unmeasured block.
            assert "w" not in probed["models"] and "w" not in probed["manifest_blocks"], probed["models"]
            assert probed["unmeasured_block"] == shipped["unmeasured_block"]
            assert not any(r["mode"] == "delegate-probe" for r in B.rows().values())
            tally = probed["delegate_probe"]["models"]["w"]["edit-multi-mechanical"]
            assert len(tally) == 1 and tally[0]["shipped"] is False and tally[0]["k"] == tally[0]["n"] == 6, tally
            assert tally[0]["mode"] == "delegate-probe" and tally[0]["dispatch"]["k"] == 6, tally
            # Over one task the floor is not met, so even a clean tally reads not-yet.
            assert tally[0]["bar_verdict"] == "not-yet", tally
            # The overlay's control samples do not feed p_cloud either.
            ctrl["preflight"][0] = {**snap, "bench_capabilities_override": {"classes": {}}}
            (B.BENCH / "hybrid-t-4-control.json").write_text(json.dumps(ctrl))
            assert not any(r["mode"] == "cloud" for r in B.rows().values())
            # ...nor a verdict row's control or cost ratio.
            write(None)
            row = next(r for r in B.rows().values() if r["mode"] == "delegate")
            assert row["control"] == [0, 0] and row["cost_ratios"] == {}, row
            assert next(iter(B.rows(probe=True).values()), None) is None
            try:
                probe_tally([{"mode": "delegate"}], [])
                raise AssertionError("a verdict row entered the probe tally")
            except SystemExit:
                pass
        finally:
            B.BENCH = real


def main():
    ap = argparse.ArgumentParser(prog="mise run bench-capabilities")
    ap.add_argument("--check", action="store_true", help="fail if the committed file is stale")
    ap.add_argument("--self-check", action="store_true")
    args = ap.parse_args()
    if args.self_check:
        self_check()
        return 0
    doc = build()
    text = json.dumps(doc, indent=2) + "\n"
    if args.check:
        if not OUT.exists() or OUT.read_text() != text:
            print(f"✗ {OUT.relative_to(ROOT)} differs from a fresh computation. "
                  "Run: mise run bench-capabilities && mise run model-manifest")
            return 1
        print(f"✓ {OUT.relative_to(ROOT)} is current")
        return 0
    OUT.parent.mkdir(exist_ok=True)
    tmp = OUT.with_suffix(".json.tmp")
    tmp.write_text(text)
    tmp.replace(OUT)
    print(f"✓ {OUT.relative_to(ROOT)}")
    print(f"  {'model':28} {'class':22} {'delegate':>18} {'local':>18}")
    for m, per in doc["models"].items():
        for cls, v in per.items():
            d, lo = v["delegate"], v["local"]
            print(f"  {m.split('/')[-1][:28]:28} {cls:22} "
                  f"{d['verdict']:>8} {d['k']:>3}/{d['n']:<3}   {lo['verdict']:>8} {lo['k']:>3}/{lo['n']:<3}")
    for m, per in doc["delegate_probe"]["models"].items():
        for cls, rs in per.items():
            for r in rs:
                print(f"  NOT SHIPPED overlay {m.split('/')[-1][:28]:28} {cls:22} "
                      f"{r['k']:>3}/{r['n']:<3} {r['bar_verdict']} ({r['condition']})")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
# mise description="Stop the running MLX server on the inference port"
"""Shut the inference server down cleanly and confirm the port is free.

Exists because the alternative is remembering the right pkill pattern for three
different backends, and getting it wrong once killed a download instead.
"""
import os
import subprocess
import sys
import time

port = os.environ.get("MLX_SERVER_PORT", "8080")
pids = subprocess.run(["/usr/sbin/lsof", "-tiTCP:" + port, "-sTCP:LISTEN"],
                      capture_output=True, text=True).stdout.split()
if not pids:
    print(f"✓ Nothing listening on port {port}")
    sys.exit(0)

for pid in pids:
    subprocess.run(["kill", pid])
for _ in range(20):
    time.sleep(0.5)
    if not subprocess.run(["/usr/sbin/lsof", "-tiTCP:" + port, "-sTCP:LISTEN"],
                          capture_output=True, text=True).stdout.strip():
        print(f"✓ Stopped {', '.join(pids)}, port {port} free")
        sys.exit(0)
sys.exit(f"✗ Port {port} still held by {', '.join(pids)} after 10s")

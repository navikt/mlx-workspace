#!/usr/bin/env python3
# mise description="Generate manifest/models.json from profiles/, for nav-pilot to fetch, and the README table from it. --check: fail if either is stale"
"""Publish the model configurations nav-pilot serves to alpha users.

nav-pilot fetches this file at `alpha local init` and on demand, so a new model
or a corrected sampling parameter reaches users without shipping a new binary.
That only works if the manifest is boring: a fixed schema, no fields a client is
required to understand, and nothing in it that can execute.

Profiles are the source of truth. This task derives the manifest from them so a
model cannot be offered to users without also being runnable here.
"""
import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(__file__))
import _profiles as P

ROOT = Path(__file__).resolve().parents[2]
OUT = ROOT / "manifest" / "models.json"

# Bump when the shape changes. A client refuses a manifest whose major version
# it does not know, which is what keeps a pushed config from breaking an old
# install: the whole point of pushing configs is lost if a push can brick one.
SCHEMA_VERSION = 1

# Only these orgs. The manifest names weights that a user's machine downloads
# and loads, so the set of publishers stays a decision made here, in review,
# rather than one made by whoever can edit a file we serve.
ALLOWED_ORGS = {"mlx-community", "lmstudio-community"}

# Models we are willing to put in front of an alpha user, and what to say about
# each. A profile is not an offer: the repo carries profiles for models we have
# rejected, and those must never reach the manifest.
OFFERED = {
    "qwen3.6-35b-a3b-optiq": {
        "default": True,
        "role": "Sub-agent worker for focused tasks",
        "evidence": "reports/2026-09-23-local-model-evaluation/decision.md",
        # Claim-injection flips 9/27 = 33% against Qwen3.8's 58%:
        # bench/decide-limits-20260925-014512.md.
        "recommended_for": ["decide-untrusted-evidence"],
        # Written from manifest/capabilities.json, not from impressions: the one class
        # that clears the bar is a delegated mechanical multi-file edit.
        "expect": "Takes a scoped task from the main agent and returns in seconds. Measured strength: a mechanical change across several files, such as a rename or the same edit in many places, handed over by a cloud agent, which verified in 35 of 35 runs. Not yet trusted for answers and explanations about code, single-file edits, debugging or creating new files: too few measured runs, or too many failures. Keep those on the cloud model. Unreliable in long multi-turn work.",
    },
    # Qwen3.8-27B, an 8-bit and a 4-bit build, offered on request and never as the
    # default. People are asking for it by name, and refusing to serve a model
    # they can download themselves in one command is not a safety measure — it
    # just means they run it without our sampling parameters or our numbers.
    #
    # Both are tuned for the 36 GB wired tier (48 GB machines), measured on
    # 2026-09-24: reports/2026-09-23-local-model-evaluation/qwen38-tuning.md.
    # The 8-bit died with a Metal OOM at about 51k context with mlx-lm's
    # 2048-token prefill step, so it gets 48k context, a 4k reply, a 3.25 GiB
    # prompt cache that holds one whole session and a 512-token prefill step
    # (38.3 GB peak at 45k; honoured only by nav-pilot with navikt/copilot#936).
    # The 4-bit gets 64k, an 8k reply and an 8 GiB cache (37.2 GB peak at 57k).
    # The 4-bit slot serves the OptiQ build (mixed 4/8-bit) since 2026-09-24, by
    # the rule set before that night: it replaces the plain 4-bit if its cheap-ops
    # pass rate is at least as high with no more loops or timeouts. It scored
    # 18/30 with no timeouts against 11/20 with 4. The key follows the profile, so
    # it changed too; nav-pilot selects by model id and never reads the key.
    #
    # What the expect text has to carry is the speed and the instability,
    # because that is what a user cannot see for themselves in a short trial.
    "qwen3.8-27b-optiq-4bit": {
        "default": False,
        "role": "Opt-in alternative, slower, the more robust 4-bit build",
        "evidence": "reports/2026-09-23-local-model-evaluation/qwen38-tuning.md#10-optiq-4bit-replaces-the-plain-4-bit",
        # 82-88% on nuanced yes/no against 55-70% for the default:
        # bench/decide-limits-20260925-014512.md, bench/decide-sets-20260925-225356.md.
        "recommended_for": ["decide-nuanced"],
        "expect": "Opt-in, never the default, and much slower: median task about 50 seconds against about 12. The OptiQ build, mixed precision: sensitive layers at 8-bit, the rest at 4-bit. More robust than the plain 4-bit it replaces: 18 of 30 cheap tasks against 11 of 20, no seven-minute timeouts against 4, and 12 of 12 Copilot sessions verified. Decodes about 15% slower, 21 tokens a second at 30k. Context is 64k with an 8k reply, and a full session measured 37.2 GB at peak.",
    },
    "qwen3.8-27b-8bit-mlx": {
        "default": False,
        "role": "Opt-in alternative, the 8-bit build, slowest here",
        "evidence": "reports/2026-09-23-local-model-evaluation/qwen38-tuning.md",
        "expect": "Opt-in, never the default. About ten times slower than the default per task (median 115 seconds against 12) and about 14 tokens a second; a cold 30k-token prompt takes about a minute to read, 45k about 85 seconds. Quality was level with the default, 31 of 40 against 28. Context is 48k with a 4k reply, read in 512-token steps so a long prompt fits the 36 GB wired limit. nav-pilot releases older than 2026.09.24-110317 ignore the step and can run out of memory near 48k: update first. If you want one Qwen3.8, take the 4-bit.",
    },
}


# Removed model ids and the OFFERED key that replaces each. Only for a swap of
# weights under the same settings: nav-pilot keeps serving a local_model naming a
# removed id, with the replacement's params, while only the old weights are
# downloaded, and moves to the replacement once it is. It says so once and never
# rewrites the user's config.
REPLACED = {
    # qwen38-tuning.md §10: OptiQ-4bit replaced the plain 4-bit on 2026-09-24.
    "mlx-community/Qwen3.8-27B-4bit": "qwen3.8-27b-optiq-4bit",
}

# recommended_for keys nav-pilot knows (local.Recommendations in navikt/copilot).
# nav-pilot ignores any other key and owns every sentence, so this only catches
# typos before they silently do nothing.
# Being the general-purpose choice is what "default": true says, so it has no key.
RECOMMENDED_KEYS = {"decide-untrusted-evidence", "decide-nuanced"}


# nav-pilot refuses a manifest whose params carry a key outside this namespace,
# and it refuses the whole file rather than the entry. That rule exists because
# params become the environment of the inference process, where PYTHONPATH would
# execute code and HF_ENDPOINT would move the download to another host.
#
# The check is repeated here because the consumer is fail-closed and lives in
# another repository: a key added here that nav-pilot rejects would silently
# strand every installed client on its embedded copy of this file. Failing the
# generator is a broken build for us. Failing the client is a fleet-wide event
# nobody notices.
PARAM_KEY = re.compile(r"^MLX_[A-Z0-9_]+$")


# The first nav-pilot release that honours each param, for params that are
# unsafe to ignore. A client older than that accepts the key and silently
# ignores it, which for MLX_PREFILL_STEP_SIZE means a Metal OOM near 48k
# context. An entry's min_nav_pilot is the newest release any of its params
# needs, and a nav-pilot that reads the field (navikt/copilot#943 and later)
# withholds the entry from an older binary. Clients older than that ignore
# min_nav_pilot like any unknown field, so nothing here can protect them: the
# schema major above stays the emergency brake.
#
# Params that are harmless to ignore stay out of the table, so they never gate
# an entry. That matters because the default cannot be gated (see below):
# - MLX_NAV_PILOT_TEMPERATURE and MLX_NAV_PILOT_TOP_P (navikt/copilot#934,
#   2026.09.24-124554-f1507ca): an older client keeps greedy sampling, as
#   before.
# - The capabilities block (#941, 2026.09.24-154750-6f3e003): an older client
#   ignores it and keeps its broader dispatch text.
#
# Each tag was checked with `git merge-base --is-ancestor <PR merge> <release>`
# against the release before it. When nav-pilot learns a new param, add it here
# only if an older client ignoring it is unsafe.
MIN_NAV_PILOT = {
    "MLX_PREFILL_STEP_SIZE": "2026.09.24-110317-3596754",  # navikt/copilot#936
}


def with_min_version(e: dict) -> dict:
    # Release versions are fixed-width date-time first, so max() orders them.
    need = [MIN_NAV_PILOT[k] for k in e["params"] if k in MIN_NAV_PILOT]
    if need:
        # A client that withholds the default has no default left and refuses
        # the whole manifest, which is the schema-major brake by accident.
        if e["default"]:
            raise SystemExit(
                f"\u2717 {e['key']} is the default and needs nav-pilot {max(need)}; "
                "gating the default makes older clients refuse the whole manifest")
        e["min_nav_pilot"] = max(need)
    return e


def entry(key: str) -> dict:
    meta, params = P.load(key)
    hf_id = params["MLX_MODEL"]
    org = hf_id.split("/")[0]
    if org not in ALLOWED_ORGS:
        raise SystemExit(f"✗ {key} publishes {hf_id}, and {org} is not an allowed org")
    offer = OFFERED[key]
    return {
        "key": key,
        "name": meta["name"],
        "model": hf_id,
        "backend": params.get("MLX_SERVER_TYPE", "mlx-lm"),
        "default": offer["default"],
        "role": offer["role"],
        "expect": offer["expect"],
        "weights_gb": meta.get("model_vram_gb"),
        # The floor a machine has to clear, now that nav-pilot refuses below it
        # rather than only printing it. 48 was hardcoded here for every entry,
        # which was harmless while nothing read the field and wrong the moment
        # something did: it would refuse a 36 GB machine a model measured to fit
        # one. A profile may state its own; the default is the wired limit plus
        # the 12 GB nav-pilot reserves for the rest of the system, which is the
        # same arithmetic the check applies.
        "min_ram_gb": int(meta.get("machine_min_ram_gb")
                          or meta["gpu_wired_limit_gb"] + 12),
        "wired_limit_gb": meta.get("gpu_wired_limit_gb"),
        # Everything the server and the clients need, already validated here.
        "params": check_params({k: v for k, v in params.items() if k.startswith("MLX_")}, key),
        **({"recommended_for": check_recommended(offer["recommended_for"], key)} if offer.get("recommended_for") else {}),
    }


def check_recommended(keys: list, key: str) -> list:
    bad = sorted(set(keys) - RECOMMENDED_KEYS)
    if bad:
        raise SystemExit(f"\u2717 {key} has recommended_for keys nav-pilot does not know: {', '.join(bad)}")
    return keys


# nav-pilot's own limit (maxProseRunes in internal/local/local.go). Role and
# expect are pasted into the main agent's system prompt, so it caps them, and it
# refuses the whole manifest over one entry that exceeds the cap — falling back
# to the last cached copy, which is how a machine ended up being offered
# yesterday's models. Checked here because here is where the text is written.
MAX_PROSE = 600


def check_prose(e: dict) -> dict:
    for field in ("role", "expect"):
        n = len(e[field])
        if n > MAX_PROSE:
            raise SystemExit(
                f"\u2717 {e['key']} has a {field} of {n} characters, and nav-pilot refuses "
                f"the manifest over {MAX_PROSE}. Shorten it: every entry goes down with it")
    return e


def check_params(params: dict, key: str) -> dict:
    bad = sorted(k for k in params if not PARAM_KEY.match(k))
    if bad:
        raise SystemExit(f"\u2717 {key} declares params nav-pilot would refuse: {', '.join(bad)}")
    return params


# Verdicts per task class from `mise run bench-capabilities` (design §3a,
# reports/2026-09-24-local-vs-cloud-routing/design.md). Enums and integers only:
# nav-pilot owns every sentence the verdicts turn into. An offered model with no
# measured runs gets `cloud` everywhere, never the absence of a block, because a
# missing block makes nav-pilot fall back to its old, broader dispatch text.
# schema_version stays 1: nav-pilot's Parse ignores unknown fields.
CAPS = ROOT / "manifest" / "capabilities.json"


def with_capabilities(e: dict) -> dict:
    if CAPS.exists():
        caps = json.loads(CAPS.read_text())
        e["capabilities"] = caps["manifest_blocks"].get(e["model"], caps["unmeasured_block"])
    return e


manifest = {
    "schema_version": SCHEMA_VERSION,
    "channel": "alpha",
    "note": "Generated from profiles/ by 'mise run model-manifest'. Do not edit by hand.",
    "models": [with_min_version(with_capabilities(check_prose(entry(k)))) for k in OFFERED],
    "replaced": REPLACED,
}

for old, new in REPLACED.items():
    if new not in OFFERED:
        raise SystemExit(f"\u2717 {old} is replaced by {new}, which is not offered")
    if any(m["model"] == old for m in manifest["models"]):
        raise SystemExit(f"\u2717 {old} is listed as replaced but is still offered")

missing = [k for k in OFFERED if k not in P.list_keys()]
if missing:
    raise SystemExit(f"✗ offered but no profile exists: {missing}")
if sum(1 for m in manifest["models"] if m["default"]) != 1:
    raise SystemExit("✗ exactly one model must be the default")

# The README table of what users get, rendered from the manifest above so it
# cannot drift from it. `evidence` lives in OFFERED and stays out of models.json.
README = ROOT / "README.md"
TABLE = re.compile(r"(<!-- models:start -->\n).*?(<!-- models:end -->)", re.S)
CLASS_WORDS = {
    "read-qa": "answers about code",
    "edit-single": "single-file edits",
    "edit-multi-mechanical": "mechanical multi-file edits",
    "create-file": "creating files",
    "debug": "debugging",
}
MODE_WORDS = {"delegate": "handed over by the cloud agent", "local": "as the main agent"}


def trusted_for(m: dict) -> str:
    out = [f"{CLASS_WORDS[c].capitalize()}, {MODE_WORDS[mode]} ({v[mode + '_k']}/{v[mode + '_n']} verified)"
           for c, v in m.get("capabilities", {}).get("classes", {}).items()
           for mode in MODE_WORDS if v[mode] == "trusted"]
    return "; ".join(out) or "Nothing yet: every task class stays on the cloud model"


def row(m: dict) -> str:
    p = m["params"]
    k = lambda v: f"{int(v) // 1024}k"
    tuning = [f"temp {p['MLX_NAV_PILOT_TEMPERATURE']}, top_p {p['MLX_NAV_PILOT_TOP_P']}"
              if "MLX_NAV_PILOT_TEMPERATURE" in p else "greedy"]
    if "MLX_PREFILL_STEP_SIZE" in p:
        tuning.append(f"prefill step {p['MLX_PREFILL_STEP_SIZE']}")
    tuning.append(f"prompt cache {p['MLX_CACHE_SIZE']} \u00d7 {int(p['MLX_CACHE_BYTES']) / 2**30:g} GiB")
    ev = OFFERED[m["key"]]["evidence"]
    return " | ".join([
        f"| **{m['name']}**<br>[`{m['model']}`](https://huggingface.co/{m['model']})",
        "default" if m["default"] else "opt-in",
        f"{k(p['MLX_OPENCODE_CONTEXT'])} / {k(p['MLX_OPENCODE_OUTPUT'])}",
        "; ".join(tuning),
        f"{m['min_ram_gb']} GB / {m['wired_limit_gb']} GB",
        f"`{m['min_nav_pilot']}`" if "min_nav_pilot" in m else "any",
        trusted_for(m),
        f"[{Path(ev).name}]({ev}) |",
    ])


def readme(text: str) -> str:
    table = "\n".join([
        "| Model | Status | Context / reply | Key tuning | RAM / wired limit | Min nav-pilot | Trusted for | Evidence |",
        "|---|---|---|---|---|---|---|---|",
        *map(row, manifest["models"]),
    ])
    if not TABLE.search(text):
        raise SystemExit("\u2717 README.md has no <!-- models:start --> / <!-- models:end --> markers")
    return TABLE.sub(lambda mt: mt[1] + table + "\n" + mt[2], text)


outputs = {OUT: json.dumps(manifest, indent=2) + "\n", README: readme(README.read_text())}
if "--check" in sys.argv[1:]:
    stale = [p.relative_to(ROOT) for p, t in outputs.items() if not p.exists() or p.read_text() != t]
    if stale:
        raise SystemExit(f"\u2717 stale: {', '.join(map(str, stale))}. Run: mise run model-manifest")
    print("\u2713 manifest/models.json and the README table are current")
    sys.exit(0)

OUT.parent.mkdir(exist_ok=True)
for path, text in outputs.items():
    path.write_text(text)
print(f"\u2713 {OUT.relative_to(ROOT)}  schema {SCHEMA_VERSION}, {len(manifest['models'])} models; README table")
for m in manifest["models"]:
    print(f"   {'*' if m['default'] else ' '} {m['key']:20s} {m['model']}")

def run(argv, timeout, **kw):
    """(rc, output, timed_out). Kills the whole process group on timeout."""
    try:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             text=True, start_new_session=True, **kw)
    except OSError as e:
        return 127, str(e), False
    try:
        out, _ = p.communicate(timeout=timeout)
        return p.returncode, out, False
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        out, _ = p.communicate()
        return -9, out or "", True


def real(prog):
    """The binary a firewall rule has to name."""
    p = shutil.which(prog) or prog
    return os.path.realpath(p)


def ok_code(c):
    return c.isdigit() and 100 <= int(c) < 500


# ── L1: curl per host ────────────────────────────────────────────────────────

CURL_CAUSE = {6: "DNS does not resolve: resolver, VPN or the firewall's DNS filter",
              7: "connection refused: nothing listening, or a firewall rejecting",
              35: "TLS handshake fails: TLS interception or a firewall cutting the handshake",
              60: "TLS certificate not trusted: a TLS-intercepting proxy"}


def l1(host):
    rc, out, to = run(["curl", "-sS", "-o", "/dev/null", "--connect-timeout", str(T), "--max-time", str(T),
                       "-w", "%{http_code} %{time_namelookup} %{time_connect} %{time_appconnect}",
                       f"https://{host}/"], T + 5)
    f = (out.strip().splitlines() or [""])[-1].split()
    code = f[0] if f and f[0].isdigit() else "000"
    if ok_code(code):
        return "PASS", f"HTTP {code}", ""
    if to:
        return "FAIL", "no answer", f"curl hung past {T + 5}s: packets silently dropped (firewall deny) or host down"
    if code.startswith("5"):
        return "FAIL", f"HTTP {code}", "the host answers with a server error: upstream outage, not the firewall"
    if rc == 28:
        dns, conn = (float(x) for x in f[1:3]) if len(f) >= 3 else (0.0, 0.0)
        if dns == 0:
            return "FAIL", "timeout in DNS", "DNS lookup times out: resolver or VPN"
        if conn == 0:
            return "FAIL", "DNS ok, TCP connect timed out", "DNS resolves but the connection times out: " \
                "firewall rule for curl (Little Snitch/LuLu deny) or the network"
        return "FAIL", "TCP ok, TLS/HTTP timed out", "connected but TLS or the response times out: firewall or network"
    return "FAIL", f"curl exit {rc}", CURL_CAUSE.get(rc, (out.strip().splitlines() or ["?"])[-1][:120])



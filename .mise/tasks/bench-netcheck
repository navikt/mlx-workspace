def run_l3(argv):
    ws = ensure_ws()
    user = Path.home() / ".nav-pilot" / "config.toml"
    keep = [l for l in (user.read_text().splitlines() if user.exists() else [])
            if not re.match(r"^(auto_update|local_enabled|local_autostart)\s*=", l)]
    cfg = Path(tempfile.mkdtemp()) / "config.toml"
    # No local server, no self-update: a cloud session and nothing else.
    cfg.write_text("\n".join(["auto_update = false", "local_enabled = false", "local_autostart = false", *keep]) + "\n")
    t0 = time.time()
    rc, out, to = run(argv, L3_TIMEOUT, cwd=str(ws), env={**os.environ, "NAV_PILOT_CONFIG": str(cfg)})
    log = ROOT / ".bench-logs" / f"netcheck-l3-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}-{len(argv)}.log"
    log.parent.mkdir(exist_ok=True)
    log.write_text(f"# argv: {argv!r}\n# rc={rc} timed_out={to} seconds={time.time() - t0:.0f}\n{out}")
    text = "".join(json.loads(l).get("part", {}).get("text", "") for l in out.splitlines()
                   if l.startswith("{") and '"text"' in l) or out
    return rc, out, to, bool(re.search(r"\bOK\b", text)), log


# ── diagnosis ────────────────────────────────────────────────────────────────

def diagnose(rows, kinds):
    by = {}
    for r in rows:
        by.setdefault(r["target"], []).append(r)
    for r in rows:
        if r["status"] != "FAIL":
            continue
        peers = by.get(r["target"], [])
        curl = next((p for p in peers if p["id"] == "curl"), None)
        passed = [p for p in peers if p["status"] == "PASS" and p is not r]
        if r["level"] == 1:
            if any(p["level"] == 2 and not p.get("soft_only") for p in passed):
                who = ", ".join(sorted({p["id"] for p in passed if p["level"] == 2}))
                r["status"] = "WARN"
                r["cause"] = f"curl is blocked but {who} gets through, and that is what the benchmark uses: " \
                             f"a curl-only firewall rule"
            continue
        if r["level"] == 3:
            continue
        if r["detail"].startswith("probe broke"):
            r["cause"] = "the probe itself did not run, so this says nothing about the network; run it by hand"
            continue
        via_cplt = "cplt" in r["id"]
        direct_ok = [p["id"] for p in passed if "cplt" not in p["id"]]
        if via_cplt and direct_ok:
            rc, out, _ = run(["cplt", "--agent", "copilot" if "copilot" in r["id"] else "opencode", "-d", str(WS),
                              "check", "net", r["target"]], 30)
            if "BLOCKED" in out.upper() and "ALLOWED" not in out.upper():
                r["cause"] = f"direct OK ({', '.join(direct_ok)}) but cplt's policy blocks it: " \
                             f"`cplt check net {r['target']}` for the fix"
            else:
                r["cause"] = f"direct OK ({', '.join(direct_ok)}) but through cplt it fails, and cplt's policy allows " \
                             f"it: the firewall rule for cplt ({r['program']}), which makes the proxy's connections"
        elif curl and curl["status"] == "PASS":
            r["cause"] = f"curl reaches it but {r['id']} doesn't: per-app firewall rule for {r['program']}"
        elif curl:
            r["cause"] = f"curl fails too ({curl['detail']}): blocked for every app checked, or the host is down; " \
                         f"allow it for {r['program']}"
        else:
            r["cause"] = f"allow {r['target']} for {r['program']} in the firewall"


def hardness(hard, soft, kinds):
    h, s = set(hard.split()), set(soft.split())
    if h & kinds:
        return "hard"
    return "soft" if s & kinds else None


def check(kinds, l3=False):
    plan = plan_hosts()
    rows = []
    ep = {h: (hard, soft, used, prog) for h, hard, soft, used, prog in ENDPOINTS}

    def row(level, cid, program, target, status, detail, hard, soft_only=False, cause=""):
        rows.append({"level": level, "id": cid, "program": program, "target": target, "status": status,
                     "detail": detail, "need": hard, "soft_only": soft_only, "cause": cause})

    for key in ("{plan-api}", "{plan-telemetry}"):
        if key not in plan and hardness(*ep[key][:2], kinds):
            row(1, "plan-lookup", real("gh"), key, "FAIL", "gh api /copilot_internal/user gave no endpoints",
                hardness(*ep[key][:2], kinds), cause="gh auth or api.github.com; the plan hosts go unchecked")
    hosts = {plan.get(h, h): h for h, *_ in ENDPOINTS if hardness(*ep[h][:2], kinds) and plan.get(h, h)[0] != "{"}
    with cf.ThreadPoolExecutor(16) as ex:
        l1f = {ex.submit(l1, h): h for h in hosts}
        probes = [p for p in multi_probes(plan) if any(hardness(*ep.get(hosts.get(h, h), ("", ""))[:2], kinds)
                                                       for h in p[3]) or p[0] == "hf-python" and
                  hardness("download", "ops frontier-local e2e decide", kinds)]
        l2m = [ex.submit(run_multi, p) for p in probes]
        singles = [s for s in single_probes() if hardness(s[4], s[5], kinds)]
        l2s = {ex.submit(run, s[2], T * 2 + 20): s for s in singles}
        for f, h in l1f.items():
            st, detail, cause = f.result()
            row(1, "curl", real("curl"), h, st, detail, hardness(*ep[hosts[h]][:2], kinds), cause=cause)
        for f in l2m:
            for pid, prog, h, st, detail, soft in f.result():
                key = hosts.get(h, h)
                need = hardness(*ep[key][:2], kinds) if key in ep else hardness("download", "", kinds) or "soft"
                if need is None:
                    continue
                row(2, pid, prog, h, st, detail, "soft" if soft else need, soft_only=soft)
        for f, (sid, prog, argv, target, hard, soft) in l2s.items():
            rc, out, to = f.result()
            last = (out.strip().splitlines() or [""])[-1][:100]
            st, detail = ("PASS", last if sid == "gh-api" else "ok") if rc == 0 else \
                ("FAIL", "timed out" if to else f"exit {rc}: {last}")
            if sid == "hf-whoami" and rc == 0:
                detail = "authenticated"   # the account name is harmless, but keep output uniform
            row(2, sid, prog, target, st, detail, hardness(hard, soft, kinds))
    if l3:
        for name, ks, argv, l2id in l3_sessions(kinds):
            rc, out, to, said_ok, log = run_l3(argv)
            need = hardness(ks, "", kinds)
            if rc == 0 and said_ok:
                row(3, name, argv[0], "session", "PASS", f"replied OK · {log.name}", need)
                continue
            l2_bad = [r for r in rows if r["id"] == l2id and r["status"] == "FAIL" and r["need"] == "hard"]
            m = re.search(r"Model not found: [^\n\"]{0,160}", out)
            if m:
                cause = f"not a network fault: {m.group(0)}. Set FRONTIER_CLOUD_MODEL to a listed model"
            elif "Bad Gateway" in out or " 502" in out:
                cause = "cplt's proxy got no answer upstream: firewall rule for cplt, or an upstream outage"
            elif l2_bad:
                cause = f"the network path already fails at L2 ({l2id}: {', '.join(r['target'] for r in l2_bad)})"
            elif to:
                cause = f"no reply in {L3_TIMEOUT}s with L2 clean: a stalled client or model; see the log"
            else:
                cause = "reachable at L2 but the session failed: auth, model entitlement or the client; see the log"
            row(3, name, argv[0], "session", "FAIL", f"{'timeout' if to else f'exit {rc}'} · {log}", need, cause=cause)
    else:
        for name, ks, *_ in l3_sessions(kinds):
            row(3, name, "nav-pilot", "session", "SKIP", "pass --l3 to run (~$0.04)", hardness(ks, "", kinds))
    diagnose(rows, kinds)
    for r in rows:
        if r["status"] == "FAIL" and r["need"] == "soft":
            r["status"] = "WARN"
    return rows


def report(rows, kinds):
    print(f"bench-netcheck for {', '.join(sorted(kinds))} (timeout {T}s)")
    for r in sorted(rows, key=lambda r: (r["level"], r["id"], r["target"])):
        print(f"{r['status']:4}  L{r['level']} {r['id']:<20} {r['target']:<38} {r['need'] or '':<4}  {r['detail']}")
        if r["cause"] and r["status"] != "PASS":
            print(f"{'':30}→ {r['cause']}")
    bad = [r for r in rows if r["status"] == "FAIL"]
    print(f"bench-netcheck: {'FAIL, ' + str(len(bad)) + ' hard failure(s)' if bad else 'PASS'}")


def inventory():
    print("| Endpoint | Used by | Program that connects | Hard for | Soft for |\n|---|---|---|---|---|")
    for h, hard, soft, used, prog in ENDPOINTS:
        print(f"| {h} | {used} | {prog} | {hard or '-'} | {soft or '-'} |")


# ── selftest: stub programs on PATH ──────────────────────────────────────────

STUB = r"""#!/bin/bash
# $FAKE_BLOCK: space-separated prog:host pairs that fail; prog:* blocks all; $FAKE_SLOW: progs that hang
me=$(basename "$0")
case " $FAKE_SLOW " in *" $me "*) [ "$1" = --exec-path ] || sleep 30 ;; esac
blocked() { case " $FAKE_BLOCK " in *" $me:$1 "*|*" $me:* "*) return 0 ;; esac; return 1; }
hosts=()
for a in "$@"; do case "$a" in https://*) h=${a#https://}; hosts+=("${h%%/*}") ;; *.*) [[ $a =~ ^[a-z0-9.-]+$ ]] && hosts+=("$a") ;; esac; done
case "$me" in
  curl) h=${hosts[0]}; blocked "$h" && { printf '000 0.01 0 0'; exit 28; }; printf '404 0.01 0.02 0.03'; exit 0 ;;
  git) [ "$1" = --exec-path ] && { echo /stub/git-core; exit 0; }; blocked github.com && exit 128; echo "abc HEAD"; exit 0 ;;
  gh) [ "$2" = /copilot_internal/user ] && { echo '{"endpoints":{"api":"https://api.business.githubcopilot.com","telemetry":"https://telemetry.business.githubcopilot.com"}}'; exit 0; }
      blocked api.github.com && exit 1; echo 4999; exit 0 ;;
  cplt) [ "$(printf '%s ' "$@" | grep -c ' check net ')" = 1 ] && { echo "ALLOWED"; exit 0; }
        for h in "${hosts[@]}"; do blocked "$h" && echo "NC $h 000" || echo "NC $h 404"; done; exit 0 ;;
  env) while [[ $1 == *=* ]]; do export "$1"; shift; done; exec "$@" ;;
  opencode|java) for h in "${hosts[@]}"; do blocked "$h" && echo "NC $h 000 TimeoutError" || echo "NC $h 200"; done; exit 0 ;;
  fnox) shift 2; exec "$@" ;;
  hf) echo user; exit 0 ;;
  python) for h in huggingface.co cas-server.xethub.hf.co us.aws.cdn.hf.co; do blocked "$h" && echo "NC $h 000" || echo "NC $h 206"; done; exit 0 ;;
  mise) exit 1 ;;
esac
"""


def selftest():
    global T
    T = 1
    d = Path(tempfile.mkdtemp())
    for p in ("curl", "git", "gh", "cplt", "opencode", "env", "fnox", "hf", "python", "mise", "java"):
        (d / p).write_text(STUB.replace("#!/bin/bash", f"#!{shutil.which('bash')}"))
        (d / p).chmod(0o755)
    (d / "hf").write_text(f"#!{d / 'python'}\n")
    os.environ.update(PATH=f"{d}:/usr/bin:/bin", NETCHECK_WS=str(d / "ws"), NETCHECK_JAVA="")
    globals()["WS"] = d / "ws"
    (d / "ws" / ".git").mkdir(parents=True)

    def go(kinds, block="", slow=""):
        os.environ["FAKE_BLOCK"], os.environ["FAKE_SLOW"] = block, slow
        return {(r["id"], r["target"]): r for r in check(set(kinds.split()))}

    # 1. everything answers
    rs = go("hybrid e2e")
    assert all(r["status"] in ("PASS", "SKIP") for r in rs.values()), [r for r in rs.values() if r["status"] != "PASS"]
    assert ("copilot-cplt-proxy", "api.business.githubcopilot.com") in rs, "plan host resolved from gh"
    # 2. per-app: curl reaches api.githubcopilot.com, opencode (direct) does not -> soft WARN naming opencode;
    #    cplt reaches it, so the benchmark path is fine and the run passes
    rs = go("hybrid", block="opencode:api.githubcopilot.com")
    r = rs[("opencode-direct", "api.githubcopilot.com")]
    assert r["status"] == "WARN" and "per-app firewall rule" in r["cause"], r
    assert not any(r["status"] == "FAIL" for r in rs.values())
    # 3. cplt-only: direct opencode and curl fine, through cplt it fails -> hard FAIL, cause names cplt
    rs = go("frontier-cloud", block="cplt:api.githubcopilot.com")
    r = rs[("opencode-in-cplt", "api.githubcopilot.com")]
    assert r["status"] == "FAIL" and "firewall rule for cplt" in r["cause"], r
    # 4. curl-only block downgraded: curl can't reach models.dev but cplt can
    rs = go("frontier-cloud", block="curl:api.githubcopilot.com")
    assert rs[("curl", "api.githubcopilot.com")]["status"] == "WARN"
    # 5. timeout: git hangs -> FAIL "timed out" within the deadline
    t0 = time.time()
    rs = go("hybrid", slow="git")
    assert rs[("git-ls-remote-pilot", "github.com")]["status"] == "FAIL"
    assert "timed out" in rs[("git-ls-remote-pilot", "github.com")]["detail"] and time.time() - t0 < 40
    # 6. kind filter: download only checks HF, and a blocked xet host is hard there
    rs = go("download", block="python:cas-server.xethub.hf.co curl:cas-server.xethub.hf.co")
    assert not any(k[0].startswith(("opencode", "copilot", "git-ls-remote-pilot")) for k in rs), list(rs)
    assert rs[("hf-python", "cas-server.xethub.hf.co")]["status"] == "FAIL", rs[("hf-python", "cas-server.xethub.hf.co")]
    assert rs[("curl", "cas-server.xethub.hf.co")]["status"] == "FAIL"
    print("bench-netcheck selftest: 6 scenarios pass")


def main():
    a = sys.argv[1:]
    if a[:1] == ["selftest"]:
        return selftest()
    if "--inventory" in a:
        return inventory()
    kinds = set(KINDS)
    if "--for" in a:
        kinds = set(a[a.index("--for") + 1].replace(",", " ").split())
        if kinds - set(KINDS):
            sys.exit(f"✗ unknown kind(s) {', '.join(kinds - set(KINDS))}; known: {', '.join(KINDS)}")
    rows = check(kinds, l3="--l3" in a)
    if "--json" in a:
        print(json.dumps({"kinds": sorted(kinds), "ok": not any(r["status"] == "FAIL" for r in rows), "rows": rows},
                         indent=1))
    else:
        report(rows, kinds)
    return 1 if any(r["status"] == "FAIL" for r in rows) else 0


if __name__ == "__main__":
    sys.exit(main())

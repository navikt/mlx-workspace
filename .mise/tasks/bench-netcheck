def run_multi(probe):
    pid, prog, argv, hosts, soft, env = probe
    rc, out, to = run(argv, T * 2 + 20, env=env)
    got = parse_nc(out)
    if pid == "hf-python":
        hosts = list(dict.fromkeys([*got, *hosts]))
    rows = []
    if not got:
        last = "timed out" if to else (out.strip().splitlines() or [""])[-1][:120]
        return [(pid, prog, h, "FAIL", f"probe broke (exit {rc}): {last}", soft) for h in hosts]
    for h in hosts:
        c = got.get(h, "000")
        if ok_code(c):
            rows.append((pid, prog, h, "PASS", f"HTTP {c}", soft))
        else:
            why = f"no answer ({c})" if h in got else f"no answer within {T}s"
            rows.append((pid, prog, h, "FAIL", why, soft))
    return rows



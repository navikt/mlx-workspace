#!/usr/bin/env python3
# mise description="What every recorded arm actually contains: valid, discarded, verified, cost, steps, dispatch. Usage: mise run bench-results [--filter next] [--why] [--json] [--by-class]"
"""Read the result files, so nobody writes that one-liner again.

Every question asked of these files during a run is the same handful:

  did this arm finish            valid against the quota
  is the data any good           how many samples were discarded, and why
  did the model do the work      verified, and how many calls went local
  what does it cost              median cloud cost and steps

Those were retyped as an inline json/glob/statistics snippet twenty times in one
day, each version slightly different, one of them wrong (it counted total
samples where it meant valid ones and reported an arm as finished when it had
produced nothing). This is that snippet, once, with the definitions fixed.

Two rules encoded here rather than remembered:

  A discarded sample is not a result. It is counted and shown, never averaged
  in, and an arm that discarded more than it kept says so loudly, because that
  is the signature of a broken harness rather than a weak model.

  An arm where BOTH sides verify nothing is a broken task, not a model finding.
  Sixteen samples were published-adjacent before that was noticed.
"""
import argparse
import json
import pathlib
import statistics as st
import sys
from collections import Counter

ROOT = pathlib.Path(__file__).resolve().parents[2]


def load(path):
    """("samples", list) for hybrid/copilot/refactor files, ("tasks", dict) for a
    bench-cheap-ops file keyed by task id, or None for anything else."""
    try:
        doc = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return None
    if not isinstance(doc, dict):
        return None
    if isinstance(doc.get("samples"), list):
        return "samples", doc["samples"]
    tasks = {k: v for k, v in doc.items() if isinstance(v, dict) and "verified" in v}
    return ("tasks", tasks) if tasks and len(tasks) == len(doc) else None


def median(values):
    return st.median(values) if values else 0.0


def summarise(path, samples):
    valid = [s for s in samples if s.get("valid")]
    invalid = [s for s in samples if not s.get("valid")]
    verified = sum(1 for s in valid if s.get("verified") is True)
    judged = sum(1 for s in valid if s.get("verified") is not None)
    return {
        "file": path.name,
        "valid": len(valid),
        "discarded": len(invalid),
        "verified": verified,
        "judged": judged,
        "dispatched": sum(1 for s in valid if s.get("local_calls")),
        "cost": median([s.get("cloud_cost_usd") or 0 for s in valid]),
        "steps": median([s.get("cloud_steps") or 0 for s in valid]),
        "seconds": median([s.get("seconds") or 0 for s in valid]),
        "reasons": Counter(str(s.get("invalid_reason"))[:52] for s in invalid),
    }


def summarise_tasks(path, tasks):
    """A bench-cheap-ops run. verified None means timed out or needs a human,
    so it is neither a pass nor a fail."""
    t = list(tasks.values())
    return {
        "file": path.name,
        "model": next((x["served_model"] for x in t if x.get("served_model")), "?"),
        "tasks": len(t),
        "passed": sum(1 for x in t if x.get("verified") is True),
        "failed": sum(1 for x in t if x.get("verified") is False),
        "timeout": sum(1 for x in t if x.get("timed_out")),
        "unjudged": sum(1 for x in t if x.get("verified") is None and not x.get("timed_out")),
        "looped": sum(1 for x in t if x.get("looped_on")),
        "seconds": median([x.get("seconds") or 0 for x in t]),
    }


def warnings_for(row):
    """The two failure signatures worth interrupting someone about."""
    out = []
    if row["discarded"] > row["valid"]:
        out.append("discarded more than it kept — suspect the harness, not the model")
    if row["valid"] >= 4 and row["judged"] and row["verified"] == 0:
        out.append("nothing verified — if the other arm is also 0, the task is broken")
    return out


def main():
    ap = argparse.ArgumentParser(prog="mise run bench-results")
    ap.add_argument("--filter", default="", help="substring of the filename, e.g. spring or next")
    ap.add_argument("--why", action="store_true", help="show why samples were discarded")
    ap.add_argument("--json", action="store_true", help="machine-readable, for another script")
    ap.add_argument("--by-class", action="store_true",
                    help="class x model x mode x condition: k/n, tasks, runs, Wilson LB (design §4.1)")
    ap.add_argument("--self-check", action="store_true")
    args = ap.parse_args()

    if args.by_class:
        return by_class(args)

    if args.self_check:
        rows = [
            {"valid": 8, "discarded": 0, "verified": 8, "judged": 8},
            {"valid": 2, "discarded": 18, "verified": 2, "judged": 2},
            {"valid": 8, "discarded": 0, "verified": 0, "judged": 8},
        ]
        assert warnings_for(rows[0]) == []
        assert "discarded more" in warnings_for(rows[1])[0]
        assert "nothing verified" in warnings_for(rows[2])[0]
        # A sample with no verdict must not count as verified.
        s = summarise(pathlib.Path("x.json"), [{"valid": True, "verified": None}])
        assert s["verified"] == 0 and s["judged"] == 0, s
        # A sample that ran but failed is valid, not discarded.
        s = summarise(pathlib.Path("x.json"), [{"valid": True, "verified": False}])
        assert s["valid"] == 1 and s["discarded"] == 0 and s["judged"] == 1, s
        t = summarise_tasks(pathlib.Path("x.json"), {
            "A": {"verified": True, "seconds": 10}, "B": {"verified": False, "seconds": 20},
            "C": {"verified": None, "timed_out": True, "seconds": 900},
            "D": {"verified": None, "looped_on": "read", "seconds": 30}})
        assert (t["passed"], t["failed"], t["timeout"], t["unjudged"], t["looped"]) == (1, 1, 1, 1, 1), t
        assert t["seconds"] == 25, t
        print("✓ self-check passed")
        return 0

    rows, runs = [], []
    for path in sorted((ROOT / "bench").glob("*.json")):
        if args.filter and args.filter not in path.name:
            continue
        loaded = load(path)
        if not loaded or not loaded[1]:
            continue
        if loaded[0] == "samples":
            rows.append(summarise(path, loaded[1]))
        else:
            runs.append(summarise_tasks(path, loaded[1]))

    if args.json:
        for r in rows:
            r["reasons"] = dict(r["reasons"])
        print(json.dumps({"samples": rows, "cheap_ops": runs}, indent=2))
        return 0

    if not rows and not runs:
        print("no result files matched")
        return 0

    if runs:
        print(f"{'cheap-ops run':52} {'pass':>5} {'fail':>3} {'t/o':>4} {'?':>3} {'loop':>4} {'med s':>6}  served")
        for r in runs:
            name = r["file"].replace("results-", "").replace(".json", "")[:52]
            print(f"{name:52} {r['passed']:>2}/{r['tasks']:<2}{r['failed']:4} {r['timeout']:4} "
                  f"{r['unjudged']:3} {r['looped']:4} {r['seconds']:6.0f}  {r['model']}")
        if not rows:
            return 0
        print()

    print(f"{'arm':52} {'valid':>5} {'disc':>5} {'ok':>7} {'disp':>5} {'cost$':>7} {'steps':>5}")
    for r in rows:
        name = r["file"].replace("hybrid-", "").replace(".json", "")[:52]
        ok = f"{r['verified']}/{r['judged']}" if r["judged"] else "—"
        print(f"{name:52} {r['valid']:5} {r['discarded']:5} {ok:>7} {r['dispatched']:5} "
              f"{r['cost']:7.3f} {r['steps']:5.0f}")
        for w in warnings_for(r):
            print(f"{'':52} ⚠ {w}")
        if args.why and r["reasons"]:
            for reason, n in r["reasons"].most_common(3):
                print(f"{'':52}   {n}× {reason}")

    total_valid = sum(r["valid"] for r in rows)
    total_disc = sum(r["discarded"] for r in rows)
    share = total_disc / (total_valid + total_disc) if (total_valid + total_disc) else 0
    print(f"\n{total_valid} valid, {total_disc} discarded ({share:.0%} of everything run)")
    return 0


def by_class(args):
    """A separate path: the per-file views above are left exactly as they were."""
    sys.path.insert(0, str(pathlib.Path(__file__).parent))
    import _by_class as B

    out = sorted((B.as_json(r) for r in B.rows().values()),
                 key=lambda r: (r["class"], r["model"], r["mode"], r["condition"]))
    if args.filter:
        out = [r for r in out if any(args.filter in f for f in r["files"])]
    if args.json:
        print(json.dumps(out, indent=2))
        return 0
    print(f"{'class':22} {'model':28} {'mode':8} {'k/n':>7} {'tasks':>5} {'runs':>4} {'LB':>5} {'med s':>5}  condition")
    for r in out:
        lb = "—" if r["lb"] is None else f"{r['lb']:.3f}"
        med = "—" if r["median_seconds"] is None else str(r["median_seconds"])
        model = r["model"].split("/")[-1][:28]
        print(f"{r['class']:22} {model:28} {r['mode']:8} {r['k']:>3}/{r['n']:<3} {len(r['tasks']):5} "
              f"{r['runs']:4} {lb:>5} {med:>5}  {r['condition']}")
        if r["cost_ratios"]:
            print(f"{'':22} cost ratio hybrid/control: "
                  + ", ".join(f"{k} {v}x" for k, v in sorted(r["cost_ratios"].items())))
    print("\nLB = one-sided 90% Wilson lower bound. Rows pool only within one condition.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

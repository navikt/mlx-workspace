def summarise(files):
    """{(class, model, variant, condition): {rungs: {r: {...}}, frontier, fit}}."""
    rows = {}
    for f in files:
        d = json.loads(Path(f).read_text())
        m = d["meta"]
        params = m.get("profile_params") or {}
        cond = (f"temp={params.get('MLX_TEMP', '0.6')} ctx={params.get('MLX_OPENCODE_CONTEXT', '?')} "
                f"harness={m['harness_sha']} tasks={m['tasks_sha']}") if not m.get("cloud_model") else \
            f"cloud harness={m['harness_sha']} tasks={m['tasks_sha']}"
        mode = "cloud" if m.get("cloud_model") else "local"
        for s in d["samples"]:
            if not s.get("valid", True) or s["verified"] is None:
                continue
            key = (s["class"], m["key"], m["variant"], cond, mode)
            r = rows.setdefault(key, {"rungs": {}, "points": [], "files": set()})
            g = r["rungs"].setdefault(s["rung"], {"k": 0, "n": 0, "tasks": set(), "runs": set(),
                                                  "seconds": [], "cost": [], "d": []})
            g["k"] += bool(s["verified"])
            g["n"] += 1
            g["tasks"].add(s["task"])
            g["runs"].add((Path(f).name, s["run"]))
            g["seconds"].append(s["seconds"])
            g["d"].append(s["d"])
            if s.get("cost_usd") is not None:
                g["cost"].append(s["cost_usd"])
            r["points"].append((s["d"], bool(s["verified"])))
            r["files"].add(Path(f).name)
    # p_cloud per (class, rung): the pooled cloud point estimate, 1.0 where none.
    pc = {}
    for (cls, _m, _v, _c, mode), r in rows.items():
        if mode == "cloud":
            for rung, g in r["rungs"].items():
                k, n = pc.get((cls, rung), (0, 0))
                pc[(cls, rung)] = (k + g["k"], n + g["n"])
    out = {}
    for key, r in rows.items():
        cls = key[0]
        lbs = F.monotone_lower({rung: (g["k"], g["n"]) for rung, g in r["rungs"].items()})
        verdicts, rung_out = {}, {}
        for rung, g in sorted(r["rungs"].items()):
            ck, cn = pc.get((cls, rung), (0, 0))
            p_cloud = ck / cn if cn else 1.0
            bar = F.bar_for(cls, p_cloud)
            v = F.rung_verdict(g["k"], g["n"], len(g["runs"]), len(g["tasks"]), bar, lbs[rung])
            verdicts[rung] = v
            lo, hi = F.wilson(g["k"], g["n"])
            rung_out[rung] = {"k": g["k"], "n": g["n"], "lb": round(lo, 3), "ub": round(hi, 3),
                              "lb_monotone": round(lbs[rung], 3), "bar": round(bar, 3), "p_cloud": round(p_cloud, 3),
                              "verdict": v, "tasks": sorted(g["tasks"]), "runs": len(g["runs"]),
                              "median_seconds": round(st.median(g["seconds"])),
                              "median_cost_usd": round(st.median(g["cost"]), 4) if g["cost"] else None,
                              "d": sorted(set(g["d"]))}
        fit = F.fit_summary(F.logistic_fit(r["points"]), F.bar_for(cls), [p[0] for p in r["points"]])
        out[key] = {"class": cls, "model": key[1], "variant": key[2], "condition": key[3], "mode": key[4],
                    "rungs": rung_out, "frontier": F.frontiers(verdicts), "fit": fit,
                    "files": sorted(r["files"])}
    return out


def cmd_summary(args):
    files = sorted((ROOT / "bench").glob(args.glob))
    if not files:
        print("no frontier result files yet")
        return 0
    res = summarise(files)
    for cls in ("edit-multi-mechanical", "edit-single", "read-qa", "create-file", "debug"):
        rows = [r for r in res.values() if r["class"] == cls]
        if not rows:
            continue
        rungs = sorted({g for r in rows for g in r["rungs"]})
        print(f"\n### {cls} (bar {F.bar_for(cls):.2f} × p_cloud; cell: k/n, monotone LB, verdict)\n")
        print("| Model | Variant | Mode | " + " | ".join(f"r{g}" for g in rungs)
              + " | Frontier trusted / open | First break | d50 | d at bar |")
        print("|---|---|---|" + "---|" * len(rungs) + "---|---|---|---|")
        for r in sorted(rows, key=lambda r: (r["mode"], r["model"], r["variant"])):
            cells = []
            for g in rungs:
                x = r["rungs"].get(g)
                cells.append(f"{x['k']}/{x['n']} {x['lb_monotone']:.2f} {x['verdict']}" if x else "")
            fr, fit = r["frontier"], r["fit"]
            print(f"| {r['model']} | {r['variant']} | {r['mode']} | " + " | ".join(cells)
                  + f" | {fr['trusted']} / {fr['open']} | {fr['first_break'] or 'none'} | "
                  f"{fit['d50'] or '–'} | {(str(fit['d_bar']) + ('+' if fit['beyond'] else '')) if fit['d_bar'] else '–'} |")
    # The harvest table: does a variant move the frontier over base, same model and condition?
    print("\n### Harvest: frontier (open) by variant against base\n")
    base = {(r["class"], r["model"]): r["frontier"]["open"] for r in res.values() if r["variant"] == "base"}
    for r in sorted(res.values(), key=lambda r: (r["class"], r["model"], r["variant"])):
        if r["variant"] != "base" and (r["class"], r["model"]) in base:
            b = base[(r["class"], r["model"])]
            print(f"- {r['class']} · {r['model']} · {r['variant']}: {b} → {r['frontier']['open']} "
                  f"({'moves it' if r['frontier']['open'] > b else 'no gain'})")
    if args.json:
        out = ROOT / "bench" / "frontier-summary.json"
        feed = {"note": "Generated by `mise run bench-frontier -- summary --json`. Read by nobody yet: "
                        "the capabilities feed designed in reports/2026-09-25-quality-frontier/design.md §7.",
                "rows": [{**r, "rungs": {str(k): v for k, v in r["rungs"].items()}} for r in res.values()]}
        out.write_text(json.dumps(feed, indent=1) + "\n")
        print(f"\n✓ {out.relative_to(ROOT)}")
    return 0



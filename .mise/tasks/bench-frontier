def static_check(repo, doc):
    """Reference passes, known-bad fails, on a scratch copy of repo. Returns failures."""
    bad = []
    with tempfile.TemporaryDirectory() as tmp:
        for t in doc["tasks"]:
            v = t["verify"]
            if v["kind"] == "answer-set":
                ok = F.verify_answer_set("ANSWER: " + ", ".join(v["expected"]), v)[0]
                drop = F.verify_answer_set("ANSWER: " + ", ".join(v["expected"][1:]), v)[0]
                extra = F.verify_answer_set("ANSWER: " + ", ".join(v["expected"] + ["Nope.kt"]), v)[0]
                if not ok or drop or extra:
                    bad.append(f"{t['id']}: answer-set verifier ok={ok} missing-one={drop} extra-one={extra}")
                continue
            if v["kind"] == "new-test":
                for m in v["mutants"]:
                    n = (Path(repo) / m["file"]).read_text().count(m["find"])
                    if n != 1:
                        bad.append(f"{t['id']}: mutant site for {m['function']} appears {n} times")
                work = Path(tmp) / t["id"]
                (work / v["path"]).parent.mkdir(parents=True, exist_ok=True)
                (work / v["path"]).write_text(t["reference"])
                if not F.verify_new_test_static(work, v, [v["path"]])[0]:
                    bad.append(f"{t['id']}: the reference test fails the file check")
                if F.verify_new_test_static(work, v, [v["path"], "src/main/x.kt"])[0]:
                    bad.append(f"{t['id']}: a stray edit next to the test passed the file check")
                continue
            if v["kind"] == "debug":
                text = (Path(repo) / t["break"]["file"]).read_text()
                if text.count(t["break"]["find"]) != 1:
                    bad.append(f"{t['id']}: break site appears {text.count(t['break']['find'])} times")
                continue
            for label, kw in [("reference", {})] + F.known_bad(v):
                work = Path(tmp) / t["id"]
                shutil.rmtree(work, ignore_errors=True)
                shutil.copytree(Path(repo) / "src", work / "src")
                if kw is not None:
                    F.apply_thread_arg(work, v, **kw)
                changed = v["allowed_files"] if kw is not None else []
                ok = F.verify_thread_arg(work, v, changed)[0]
                if ok != (label == "reference"):
                    bad.append(f"{t['id']}: {label} scored {ok}")
    for b in bad:
        print(f"  ✗ {b}")
    return bad



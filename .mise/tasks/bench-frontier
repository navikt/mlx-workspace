def cmd_gen(args):
    repo = Path(args.repo).resolve()
    base = json.loads((REAL_ROOT / "bench" / "tasks.json").read_text())
    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=repo, capture_output=True, text=True).stdout.strip()
    if head != base["ref"] and not args.any_ref:
        raise SystemExit(f"✗ {repo} is at {head[:8]}, the pinned ref is {base['ref'][:8]}")

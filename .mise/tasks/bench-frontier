# ── variants ─────────────────────────────────────────────────────────────────

def parse_variant(v):
    """'base' or tokens joined by '+': capN, retryK, example, trim, decompose."""
    out = {"cap": None, "retry": 0, "example": False, "trim": False, "decompose": False}
    for tok in v.split("+"):
        if tok == "base":
            continue
        if m := re.fullmatch(r"cap(\d+)", tok):
            out["cap"] = int(m.group(1))
        elif m := re.fullmatch(r"retry(\d)", tok):
            out["retry"] = int(m.group(1))
        elif tok in ("example", "trim", "decompose"):
            out[tok] = True
        else:
            raise SystemExit(f"✗ unknown variant token {tok!r} in {v!r}")
    return out


def applies(task, var):
    """A variant that does not apply to a task is not run under that name."""
    if var["decompose"] and not task.get("decompose"):
        return False
    # A verifier's feedback on an answer leaks the gold answer, and a silent class
    # has no verifier in production, so retries apply to caught classes only.
    if var["retry"] and task["class"] == "read-qa":
        return False
    return True


def prompts_for(task, var, failing_test):
    kind = "edit" if task["class"].startswith("edit") else task["class"]
    pre = (PREFIX["example"][kind] if var["example"] else "") + (PREFIX["trim"] if var["trim"] else "")
    body = task["decompose"] if var["decompose"] else [task["prompt"]]
    return [pre + p.replace("{failing_test}", failing_test or "?") for p in body]


# ── the borrowed harness ─────────────────────────────────────────────────────

def harness(key, cfg):
    """bench-cheap-ops' helpers, bound to this profile's workspace."""
    import _profiles as P
    ns = {"json": json, "os": os, "re": re, "shutil": shutil, "subprocess": subprocess, "sys": sys,
          "time": time, "tempfile": tempfile, "hashlib": hashlib, "Path": Path, "P": P,
          "ROOT": ROOT, "CFG": cfg, "key": key, "ws": ws_for(key), "repo": ws_for(key) / "kotlin",
          "JDK": Path(os.path.expanduser(cfg.get("jdk", "~"))), "GIT_STASH": None, "SERVED": None}
    src = HERE / "bench-cheap-ops"
    tree = ast.parse(src.read_text())
    fns = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in BORROWED]
    missing = set(BORROWED) - {f.name for f in fns}
    if missing:
        raise SystemExit(f"✗ bench-cheap-ops no longer defines {sorted(missing)}, which bench-frontier "
                         f"borrows. Update BORROWED to match.")
    exec(compile(ast.Module(fns, []), str(src), "exec"), ns)  # noqa: S102  (our own file)
    return ns


def ws_for(key):
    return CLOUD_WS / key if key.startswith("cloud-") else ROOT / "workspaces" / key


def cloud_ws(ws):
    """Make ws the project cplt picks for a nav-pilot session started in it.

    An empty repository at ws is the git root cplt and opencode find, so the
    sandbox is ws (not $HOME, which is a git repo too) and opencode, seeing a
    git project, lists the tree with kotlin/ in it, as the local arm's opencode
    does. No commits, so no history to read. It is made after
    assert_workspace_is_clean, which would call .git stray.
    """
    ws.mkdir(parents=True, exist_ok=True)
    shutil.copy2(REAL_ROOT / "bench" / "agents-prompt.md", ws / "AGENTS.md")
    subprocess.run(["git", "init", "-q", str(ws)], check=True)


def cplt_project(text):
    m = re.search(r"^\[cplt\] Project:\s+(.+)$", re.sub(r"\x1b\[[0-9;]*m", "", text), re.MULTILINE)
    return m and m.group(1).strip()


def harness_sha(tasks_file):
    h = hashlib.sha256()
    for f in (HERE / "bench-frontier", HERE / "_frontier.py", HERE / "bench-cheap-ops",
              HERE / "_sandbox.py", HERE / "_profiles.py", tasks_file, REAL_ROOT / "bench" / "agents-prompt.md"):
        h.update(f.name.encode())
        h.update(f.read_bytes() if f.exists() else b"<missing>")
    return h.hexdigest()[:12]


def build(repo, cfg, which, only=None):
    """(ok, tail of the output) for the task set's compile or test command.
    only: a test class filter, so a create-file check runs one class, not the suite."""
    cmd = FAKE_BUILD or cfg[f"{which}_cmd"] + (f" --tests '{only}'" if only else "")
    r = subprocess.run(["bash", "-c", cmd], cwd=str(repo), capture_output=True, text=True, timeout=1800)
    return r.returncode == 0, "\n".join((r.stdout + r.stderr).strip().splitlines()[-30:])


def failing_tests(repo, output):
    """Test classes with a failure: Gradle's XML reports, else the console lines."""
    xml = sorted(Path(repo).glob("build/test-results/test/TEST-*.xml"))
    names = {f.stem[5:].rsplit(".", 1)[-1] for f in xml if "<failure" in f.read_text(errors="replace")}
    return sorted(names or set(re.findall(r"(\w+Test) > .* FAILED", output)))


def changed_all(repo):
    """Changed and new files, one per line: untracked directories expanded, which the
    borrowed changed_files() does not do and a new test file needs."""
    r = subprocess.run(["git", "status", "--porcelain", "-uall"], cwd=str(repo), capture_output=True, text=True)
    return [line[3:].strip() for line in r.stdout.splitlines() if line.strip()]


def queue_lock():
    """The mkdir lock every benchmark queue shares; BENCH_WAIT=1 waits for it."""
    lock = ROOT / ".bench-logs" / ".queue.lock"
    lock.parent.mkdir(parents=True, exist_ok=True)
    while True:
        try:
            lock.mkdir()
            break
        except FileExistsError:
            holder = (lock / "pid").read_text().strip() if (lock / "pid").exists() else ""
            alive = holder.isdigit() and _alive(int(holder))
            if not holder and time.time() - lock.stat().st_mtime < 10:
                time.sleep(1)
                continue
            if alive:
                if os.environ.get("BENCH_WAIT"):
                    time.sleep(60)
                    continue
                raise SystemExit(f"✗ another benchmark queue holds the lock (pid {holder}). BENCH_WAIT=1 waits.")
            shutil.rmtree(lock, ignore_errors=True)
    (lock / "pid").write_text(str(os.getpid()))
    return lock


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


# ── agents ───────────────────────────────────────────────────────────────────

def log_text_and_tools(path):
    """The full reply and tool calls from an opencode JSONL log. opencode-headless
    prints only the first 300 characters of the reply, and the ANSWER line is last."""
    text, tools, cost, steps = [], 0, 0.0, 0
    for line in Path(path).read_text(errors="replace").splitlines():
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        part = ev.get("part") or {}
        if ev.get("type") == "text" and isinstance(part.get("text"), str):
            text.append(part["text"])
        elif ev.get("type") == "tool_use":
            tools += 1
        elif ev.get("type") == "step_finish":
            steps += 1
            cost += float(part.get("cost") or 0)
    return "\n".join(text), tools, round(cost, 4), steps


def agent_local(H, prompt, cont, cap):
    H["hide_git"]()
    timed_out = False
    try:
        r = H["sh"](["mise", "run", "opencode-headless", *(["--continue"] if cont else []), prompt],
                    cwd=ROOT, timeout=cap)
        out = r.stdout + r.stderr
    except subprocess.TimeoutExpired as e:
        timed_out = True
        out = (e.stdout or b"").decode("utf8", "replace") + (e.stderr or b"").decode("utf8", "replace")
        subprocess.run(["/usr/bin/pkill", "-f", "opencode --pure"], capture_output=True)
        subprocess.run(["/usr/bin/pkill", "-f", "cplt --agent opencode"], capture_output=True)
    finally:
        H["restore_git"]()

    def grab(pat):
        m = re.search(pat, out)
        return int(m.group(1).replace(",", "")) if m and not timed_out else None
    m = re.search(r"log: (\S+\.jsonl)", out)
    reply = log_text_and_tools(ROOT / m.group(1))[0] if m and (ROOT / m.group(1)).exists() else ""
    return {"out": out, "reply": reply, "timed_out": timed_out, "turns": grab(r"· (\d+) turns"),
            "tool_calls": grab(r"· (\d+) tool calls"), "tokens_in": grab(r"in ([\d,]+) ·"),
            "tokens_out": grab(r"out ([\d,]+) ·"), "cost_usd": 0.0, "loop": H["loop_check"](out)}


def agent_cloud(H, prompt, cont, cap, model):
    """One cloud-only session through nav-pilot, as bench-hybrid's control arm runs it."""
    log = ROOT / ".bench-logs" / f"frontier-cloud-{time.strftime('%Y%m%d-%H%M%S')}.jsonl"
    argv = [NAV_PILOT, "--client", "opencode", "--model", model, "--", "--pure", "run",
            *(["--continue"] if cont else []), "--format", "json", prompt]
    log.parent.mkdir(exist_ok=True)
    H["hide_git"]()
    timed_out = False
    try:
        with log.open("w") as fh:
            fh.write(f"# argv: {argv!r}\n")
            fh.flush()
            p = subprocess.Popen(argv, cwd=str(H["ws"]), stdin=subprocess.DEVNULL, stdout=fh,
                                 stderr=subprocess.STDOUT, start_new_session=True)
            try:
                p.wait(timeout=cap)
            except subprocess.TimeoutExpired:
                timed_out = True
                os.killpg(p.pid, signal.SIGTERM)
                time.sleep(3)
                if p.poll() is None:
                    os.killpg(p.pid, signal.SIGKILL)
    finally:
        H["restore_git"]()
    text = log.read_text(errors="replace")
    reply, tools, cost, steps = log_text_and_tools(log)
    project = cplt_project(text)
    return {"out": text, "reply": reply, "timed_out": timed_out, "turns": None if timed_out else steps,
            "tool_calls": tools, "tokens_in": None, "tokens_out": None,
            "cost_usd": cost, "cost_partial": timed_out, "loop": {},
            "dispatched": "Local dispatch: nav-pilot ends a turn" in text,
            "misscoped": project and Path(project).resolve() != H["ws"].resolve() and project}


def agent_fake(H, task, prompt, cont, cap, attempt):
    r = subprocess.run([FAKE], input=prompt, capture_output=True, text=True, timeout=cap,
                       env={**os.environ, "FAKE_TASK": json.dumps(task), "FAKE_REPO": str(H["repo"]),
                            "FAKE_CONT": "1" if cont else "", "FAKE_ATTEMPT": str(attempt)})
    return {"out": r.stdout, "reply": r.stdout, "timed_out": False, "turns": 1, "tool_calls": 1,
            "tokens_in": 1, "tokens_out": 1, "cost_usd": float(os.environ.get("FAKE_COST", "0")), "loop": {}}


# ── one sample ───────────────────────────────────────────────────────────────

def verify(H, cfg, task, reply):
    """(ok, note, build tail). The model's own claims count for nothing."""
    v = task["verify"]
    changed = changed_all(H["repo"])
    if v["kind"] == "answer-set":
        if changed:
            return False, f"a read task changed files: {', '.join(changed[:3])}", ""
        ok, note = F.verify_answer_set(reply, v)
        return ok, note, ""
    if v["kind"] == "debug":
        # No "changed nothing" check here: the break is uncommitted, so an exact fix
        # leaves a clean tree. bench-cheap-ops' debug verify fails that perfect fix as
        # "no changes made"; the suite decides instead, and doing nothing leaves it red.
        if [c for c in changed if F.is_test_path(c)]:
            return False, "edited a test file instead of the code", ""
        ok, tail = build(H["repo"], cfg, "test")
        return ok, "suite green" if ok else "suite still failing", tail
    if not changed:
        return False, "no changes made", ""
    if v["kind"] == "new-test":
        return verify_new_test(H["repo"], cfg, v, changed)
    ok, note = F.verify_thread_arg(H["repo"], v, changed)
    if not ok:
        return False, note, ""
    ok, tail = build(H["repo"], cfg, "compile")
    return ok, note + (" and compiles" if ok else ", compile failed"), tail


def verify_new_test(repo, cfg, v, changed):
    """One new file, green on its own, and red on every mutant of what it tests."""
    ok, note = F.verify_new_test_static(repo, v, changed)
    if not ok:
        return False, note, ""
    ok, tail = build(repo, cfg, "test", only=v["test_class"])
    if not ok:
        return False, "the new test does not pass (or does not run)", tail
    survived = []
    for m in v["mutants"]:
        f = Path(repo) / m["file"]
        orig = f.read_text()
        if orig.count(m["find"]) != 1:
            return False, f"mutant site for {m['function']} not found once: the task is broken", ""
        f.write_text(orig.replace(m["find"], m["replace"]))
        try:
            killed = not build(repo, cfg, "test", only=v["test_class"])[0]
        finally:
            f.write_text(orig)
        if not killed:
            survived.append(m["function"])
    if survived:
        return False, f"green, but a bug in {', '.join(survived)} goes unnoticed (mutant survived)", ""
    return True, f"{note}, green, kills {len(v['mutants'])}/{len(v['mutants'])} mutants", ""


def run_sample(H, cfg, task, var, run_i, cloud, failing_test):
    if not cloud and not FAKE and os.environ.get("BENCH_RESTART_SERVER", "1") == "1":
        H["restart_server"]()
    H["reset_repo"]()
    if task.get("break"):
        H["apply_break"](task)
    cap = var["cap"] or BASE_CAP[task["class"]]
    started = time.time()
    agg = {"turns": 0, "tool_calls": 0, "tokens_in": 0, "tokens_out": 0, "cost_usd": 0.0}
    reply, loops, timed_out, dispatched, misscoped = "", [], False, False, None
    attempts = 0

    def call(prompt, cont):
        nonlocal reply, timed_out, dispatched, misscoped
        if FAKE:
            a = agent_fake(H, task, prompt, cont, cap, attempts)
        elif cloud:
            a = agent_cloud(H, prompt, cont, cap, cloud)
            dispatched = dispatched or a["dispatched"]
            misscoped = misscoped or a["misscoped"]
        else:
            a = agent_local(H, prompt, cont, cap)
        reply = a["reply"]
        timed_out = timed_out or a["timed_out"]
        for k in agg:
            agg[k] = None if agg[k] is None or a[k] is None else agg[k] + a[k]
        if a["loop"]:
            loops.append(a["loop"])

    for p in prompts_for(task, var, failing_test):  # decompose: one fresh session per file
        attempts += 1
        call(p, False)
    ok, note, tail = (False, "timed out", "") if timed_out else verify(H, cfg, task, reply)
    retries = 0
    while not ok and not timed_out and retries < var["retry"]:
        retries += 1
        attempts += 1
        call(f"The change is not done yet: {note}.\n{tail}\nFix it. Change nothing else.", True)
        ok, note, tail = (False, "timed out", "") if timed_out else verify(H, cfg, task, reply)
    return {
        "task": task["id"], "class": task["class"], "family": task["family"], "rung": task["rung"],
        "d": task["difficulty"]["d"], "difficulty": task["difficulty"], "run": run_i,
        "seconds": round(time.time() - started, 1), "cap_per_attempt": cap,
        "attempts": attempts, "retries": retries, "timed_out": timed_out,
        **agg,
        "longest_identical_run": max((x.get("longest_identical_run", 0) for x in loops), default=0),
        "looped_on": next((x["looped_on"] for x in loops if x.get("looped_on")), None),
        "files_changed": len(H["changed_files"]()),
        "verified": ok, "note": note, "build_tail": "" if ok else tail[-1500:],
        "valid": not (dispatched or misscoped),
        **({"invalid_reason": "cloud arm dispatched to a local worker"} if dispatched else {}),
        **({"invalid_reason": f"cplt scoped the session to {misscoped}, not the workspace"} if misscoped else {}),
    }


# ── selection ────────────────────────────────────────────────────────────────

def load_tasks(path):
    doc = json.loads(Path(path).read_text())
    return doc, F.tasks_sha({k: v for k, v in doc.items() if k != "_note"})


def validation_path(sha):
    return TASKS.parent / f"validated-{sha}.json"


def select(doc, sha, classes, rungs, unvalidated):
    """USE_PER_RUNG tasks per (class, rung): the first ones validation passed."""
    val = {}
    vp = validation_path(sha)
    if vp.exists():
        val = json.loads(vp.read_text())["tasks"]
    elif not unvalidated:
        raise SystemExit(f"✗ no {vp.relative_to(ROOT)}: run `mise run bench-frontier -- validate` first "
                         f"(or --unvalidated for a dry run)")
    picked, groups = [], {}
    for t in doc["tasks"]:
        if t["class"] in classes and (not rungs or t["rung"] in rungs):
            groups.setdefault((t["class"], t["rung"]), []).append(t)
    for key in sorted(groups):
        ok = [t for t in groups[key] if unvalidated or val.get(t["id"], {}).get("ok")]
        picked += ok[:F.USE_PER_RUNG]
        if len(ok) < F.USE_PER_RUNG:
            print(f"  ⚠ {key[0]} rung {key[1]}: {len(ok)} valid task(s), want {F.USE_PER_RUNG}")
    return picked, val


def past_frontier(cls, glob, sha):
    """The two rungs just past the base frontier: where a harness lever could move it.
    None when the class never broke (nothing to move) or has no base data."""
    files = [f for f in sorted((ROOT / "bench").glob(glob))
             if json.loads(f.read_text())["meta"]["tasks_sha"] == sha]
    rows = [r for r in summarise(files).values() if r["class"] == cls and r["mode"] == "local"]
    if not rows:
        print(f"  {cls}: no base results match {glob}; skipped")
        return None
    r = max(rows, key=lambda r: sum(g["n"] for g in r["rungs"].values()))
    top, fr = max(r["rungs"]), r["frontier"]
    if fr["first_break"] is None and fr["open"] == top:
        print(f"  {cls}: open frontier is the top rung ({top}); skipped")
        return None
    rungs = {x for x in (fr["open"] + 1, fr["open"] + 2) if x <= top}
    print(f"  {cls}: base frontier {fr['open']}, first break {fr['first_break']} → rungs {sorted(rungs)}")
    return rungs


def parse_rungs(s):
    if not s:
        return None
    out = set()
    for part in s.split(","):
        a, _, b = part.partition("-")
        out |= set(range(int(a), int(b or a) + 1))
    return out



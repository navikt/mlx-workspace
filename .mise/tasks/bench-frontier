           "started": time.strftime("%Y-%m-%dT%H:%M:%S"), "tasks": {}}
    vp = validation_path(sha)
    lock = None if FAKE else queue_lock()
    try:
        H["reset_repo"]()
        ok, tail = build(H["repo"], doc, "test")
        out["baseline_test"] = ok
        print(f"  baseline suite: {'green' if ok else 'RED'}")
        if not ok:
            raise SystemExit(f"✗ the untouched checkout's suite is red; nothing is measurable.\n{tail}")
        family_bad_done = set()
        groups = {}
        for t in doc["tasks"]:
            groups.setdefault((t["class"], t["rung"]), []).append(t)
        for (cls, rung), ts in sorted(groups.items()):
            good = 0
            for t in ts:
                if good >= F.USE_PER_RUNG and t["verify"]["kind"] != "debug":
                    out["tasks"][t["id"]] = {"ok": False, "note": "spare, not needed"}
                    continue
                res = validate_one(H, doc, t, family_bad_done)
                out["tasks"][t["id"]] = res
                good += res["ok"]
                print(f"  {'✓' if res['ok'] else '✗'} {t['id']:12} {res['note']}")
                vp.write_text(json.dumps(out, indent=1) + "\n")
        H["reset_repo"]()
    finally:
        if lock:
            shutil.rmtree(lock, ignore_errors=True)
    print(f"✓ {sum(v['ok'] for v in out['tasks'].values())}/{len(out['tasks'])} valid → {vp}")
    return 0


def validate_one(H, cfg, t, family_bad_done):
    v = t["verify"]
    H["reset_repo"]()
    if v["kind"] == "answer-set":
        return {"ok": True, "note": "answer-set, static only"}
    if v["kind"] == "debug":
        # A rung shares its break with the other rungs, so each break is run once.
        cached = next((r for tid, r in VALIDATED.items() if tid.endswith(t["break_id"])), None)
        if cached:
            return cached
        H["apply_break"](t)
        ok, tail = build(H["repo"], cfg, "test")
        fails = failing_tests(H["repo"], tail) if not ok else []
        # Rung 2 names the failing class, so a break whose failure cannot be named is
        # usable at the other rungs only.
        res = {"ok": not ok and (bool(fails) or "{failing_test}" not in t["prompt"]), "failing_tests": fails,
               "note": ("suite fails: " + (", ".join(fails) or "no class named")) if not ok
               else "suite still green: the break is not caught"}
        VALIDATED[t["id"]] = res
        return res
    if v["kind"] == "new-test":
        p = Path(H["repo"]) / v["path"]
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(t["reference"])
        ok, note, tail = verify_new_test(H["repo"], cfg, v, changed_all(H["repo"]))
        if not ok:
            return {"ok": False, "note": f"reference test rejected: {note} {tail.splitlines()[-1][:100] if tail else ''}"}
        p.write_text(F.vacuous_test(t["reference"]))
        bad, bnote, _ = verify_new_test(H["repo"], cfg, v, changed_all(H["repo"]))
        if bad:
            return {"ok": False, "note": "a test with no assertions passed: the mutants catch nothing"}
        return {"ok": True, "note": f"reference passes ({note}); vacuous test rejected ({bnote[:60]})"}
    F.apply_thread_arg(H["repo"], v)
    ok, tail = build(H["repo"], cfg, "compile")
    if not ok:
        return {"ok": False, "note": "reference solution does not compile: " + tail.splitlines()[-1][:120]
                if tail else "reference solution does not compile"}
    if t["family"] not in family_bad_done:
        H["reset_repo"]()
        F.apply_thread_arg(H["repo"], v, def_only=True)
        bad_ok, _ = build(H["repo"], cfg, "compile")
        if bad_ok:
            return {"ok": False, "note": "definition-only change still compiles: the build cannot catch misses"}
        family_bad_done.add(t["family"])
    return {"ok": True, "note": "reference compiles"}



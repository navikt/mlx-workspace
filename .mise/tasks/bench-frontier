def plan_minutes(tasks, runs, key):
    f = next((v for k, v in MODEL_FACTOR.items() if key.startswith(k)), 2.0)
    return sum(EST_MIN[t["class"]] * (1 if t["class"] == "debug" else f) for t in tasks) * runs


def cmd_run(args):
    doc, sha = load_tasks(args.tasks)
    classes = args.classes.split(",")
    var = parse_variant(args.variant)
    if args.rungs == "past-frontier":
        tasks, val = [], {}
        for cls in classes:
            rungs = past_frontier(cls, args.base_glob, sha)
            if rungs:
                t, val = select(doc, sha, [cls], rungs, args.unvalidated or args.dry_run)
                tasks += t
        if not tasks:
            print("→ no class broke within its ladder at base, or no base data: nothing for a lever to move")
            return 0
    else:
        tasks, val = select(doc, sha, classes, parse_rungs(args.rungs), args.unvalidated or args.dry_run)
    tasks = [t for t in tasks if applies(t, var)]
    if args.cloud:
        key = "cloud-" + re.sub(r"[^a-z0-9.]+", "-", args.cloud.lower()).strip("-")
    else:
        key = args.profile or os.environ.get("MLX_ACTIVE_PROFILE", "")
        if not key:
            raise SystemExit("✗ --profile or --cloud is required")
    n = len(tasks) * args.runs
    mins = plan_minutes(tasks, args.runs, key)
    print(f"→ {key} · variant {args.variant} · {len(tasks)} tasks × {args.runs} runs = {n} samples · "
          f"~{mins / 60:.1f} h (estimate)")
    for t in tasks:
        print(f"   {t['class']:22} r{t['rung']} {t['id']:12} d={t['difficulty']['d']}")
    if args.dry_run:
        import _profiles as P
        if not args.cloud and not FAKE:
            P.load(key)
            print(f"  ✓ profile {key} loads")
        print(f"  {'✓' if validation_path(sha).exists() else '✗'} validation {validation_path(sha).name}")
        ws = ws_for(key)
        print(f"  {'✓' if (ws / 'kotlin' / '.git').exists() else '·'} workspace {ws} "
              f"{'present' if (ws / 'kotlin').exists() else 'missing (cloned at start, needs network)'}")
        return 0

    H = harness(key, doc)
    lock = None if FAKE else queue_lock()
    stamp = time.strftime("%Y%m%d-%H%M%S")
    vslug = args.variant.replace("+", "_")
    out_path = ROOT / "bench" / f"frontier-{key}-{vslug}-{stamp}.json"
    try:
        if not FAKE and not args.cloud:
            subprocess.run(["mise", "run", "server-stop"], cwd=str(ROOT), capture_output=True)
            if subprocess.run(["mise", "run", "model-use", key], cwd=str(ROOT)).returncode != 0:
                raise SystemExit(f"✗ model-use {key} failed; refusing to measure the previous model")
        if args.cloud and not FAKE:
            shutil.rmtree(H["ws"] / ".git", ignore_errors=True)  # ours, from the last run
            subprocess.run([NAV_PILOT, "alpha", "local", "off"], capture_output=True)
        if not FAKE:
            H["assert_workspace_is_clean"]()
            H["ensure_clone"]()
        if args.cloud and not FAKE:
            cloud_ws(H["ws"])
        import _profiles as P
        meta = {"key": key, "variant": args.variant, "variant_parsed": var, "cloud_model": args.cloud,
                "profile_params": None if args.cloud or FAKE else P.params_for(key),
                "tasks_file": str(Path(args.tasks).name), "tasks_sha": sha,
                "harness_sha": harness_sha(Path(args.tasks)), "started": stamp,
                "nav_pilot": NAV_PILOT if args.cloud else None}
        doc_out = {"meta": meta, "samples": []}
        ledger = Path(args.cost_ledger) if args.cost_ledger else None
        spent = json.loads(ledger.read_text())["spent_usd"] if ledger and ledger.exists() else 0.0
        stop = None
        for run_i in range(1, args.runs + 1):
            # Round-robin over the ladder, not rung by rung: a run cut short by its
            # watchdog then has every rung at n-1 instead of the top rungs at zero.
            for t in tasks:
                # The cap is checked before a sample, against what was spent, plus the
                # median sample so far, so the last sample cannot blow through it.
                costs = [x["cost_usd"] for x in doc_out["samples"] if x.get("cost_usd")]
                nxt = st.median(costs) if costs else 0.0
                if args.cost_cap is not None and spent + nxt > args.cost_cap:
                    stop = f"cost cap ${args.cost_cap:.2f}: ${spent:.2f} spent, next sample ~${nxt:.2f}"
                    break
                ft = (val.get(t["id"]) or {}).get("failing_tests") or []
                rec = run_sample(H, doc, t, var, run_i, args.cloud, ", ".join(ft))
                rec["served_model"] = H.get("SERVED") or args.cloud
                doc_out["samples"].append(rec)
                spent += rec.get("cost_usd") or 0.0
                meta["spent_usd"] = round(spent, 4)
                if ledger:
                    ledger.write_text(json.dumps({"spent_usd": round(spent, 4), "cap_usd": args.cost_cap}) + "\n")
                out_path.write_text(json.dumps(doc_out, indent=1) + "\n")
                flag = "✓" if rec["verified"] else "✗"
                print(f"   {flag} run {run_i} {t['id']:12} {rec['seconds']:>6}s · {rec['attempts']} att · "
                      f"{rec['tool_calls']} tools · {rec['note']}", flush=True)
            if stop:
                meta["stopped"] = stop
                out_path.write_text(json.dumps(doc_out, indent=1) + "\n")
                print(f"   COST CAP: {stop}; recorded in the file, stopping", flush=True)
                break
        H["reset_repo"]()
    finally:
        if lock:
            shutil.rmtree(lock, ignore_errors=True)
        if not FAKE and not args.cloud:
            subprocess.run(["mise", "run", "server-stop"], cwd=str(ROOT), capture_output=True)
    print(f"✓ {out_path.relative_to(ROOT)}")
    return 0



def cmd_selftest(_args):
    """Everything but the model and Gradle, on a three-file fixture repo."""
    F.self_check()
    # night 3: the cloud arm's workspace sat inside this repo, so cplt scoped the session to it
    assert not ws_for("cloud-x").resolve().is_relative_to(REAL_ROOT.resolve())
    assert cplt_project("\x1b[2m[cplt] Project:  /a/b\x1b[0m\n") == "/a/b" and cplt_project("no banner") is None
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        repo = tmp / "fixture"
        for rel, text in FIXTURE.items():
            (repo / rel).parent.mkdir(parents=True, exist_ok=True)
            (repo / rel).write_text(text)
        # 1. the scanner and the generator on the fixture
        cands = {c["name"]: c for c in F.survey(F.sources(repo))}
        assert cands["formatName"]["sites"] == {"src/main/kotlin/a/Service.kt": 2,
                                                "src/test/kotlin/a/ServiceTest.kt": 1}, cands["formatName"]
        assert cands["localHelper"]["sites"] == {"src/main/kotlin/a/Util.kt": 3}, cands["localHelper"]
        doc = F.generate(repo, {"repo": "fixture", "ref": "x"})
        ids = {t["id"]: t for t in doc["tasks"]}
        fm = next(t for t in doc["tasks"] if t["verify"].get("name") == "formatName" and t["class"].startswith("edit-m"))
        fs = next(t for t in doc["tasks"] if t["verify"].get("name") == "localHelper")
        assert fm["rung"] == 2 and fs["class"] == "edit-single" and fs["rung"] == 2, (fm["rung"], fs)
        assert any(t["class"] == "read-qa" for t in doc["tasks"])
        assert len(fm["decompose"]) == 3, fm["decompose"]
        # 2. reference passes, every known-bad fixture fails (static half)
        doc_static = {"tasks": [t for t in doc["tasks"] if t["class"] != "debug"]}
        assert static_check(repo, doc_static) == [], "static check failed on the fixture"
        # 3. the reference edit is what a person would write
        work = tmp / "ref"
        shutil.copytree(repo, work)
        F.apply_thread_arg(work, fm["verify"])
        svc = (work / "src/main/kotlin/a/Service.kt").read_text()
        assert 'formatName("Service", "a", "b")' in svc and 'formatName("Service",\n        "c"' in svc, svc
        assert 'fun formatName(origin: String, first: String' in (work / "src/main/kotlin/a/Util.kt").read_text()
        assert "// formatName( in a comment" in svc
        print("✓ generator and static verifiers on the fixture")

        # 4. the runner end to end, fake models and a fake build, in a scratch ROOT
        root = tmp / "root"
        (root / "bench" / "frontier").mkdir(parents=True)
        ws = root / "workspaces" / "fake"
        shutil.copytree(repo, ws / "kotlin")
        (ws / "kotlin" / "src/main/kotlin/a/Calc.kt").write_text(
            "package a\n\nfun half(x: Int): Int = x / 2\n")
        g = lambda *a: subprocess.run(["git", *a], cwd=ws / "kotlin", capture_output=True, check=True)  # noqa: E731
        g("init", "-q")
        g("-c", "user.email=t@t", "-c", "user.name=t", "add", "-A")
        g("-c", "user.email=t@t", "-c", "user.name=t", "-c", "commit.gpgsign=false", "commit", "-qm", "fixture")
        dbg = {"id": "db-r1-bx", "class": "debug", "family": "break", "rung": 1,
               "difficulty": {"d": 1, "hint": 1, "distance": "adjacent"}, "break_id": "bx",
               "prompt": F.DEBUG_PROMPTS[2], "verify": {"kind": "debug", "build": "test"},
               "break": {"file": "src/main/kotlin/a/Calc.kt", "find": "x / 2", "replace": "x / 3"}}
        doc = F.generate(ws / "kotlin", {"repo": "fixture", "ref": "x", "compile_cmd": "true", "test_cmd": "true"})
        ref = F.reference_test("HalfTest", ["dagerMellomDatoer"]).replace("dagerMellomDatoer", "half")
        cf = {"id": "cf-r1-a", "class": "create-file", "family": "new-test", "rung": 1,
              "difficulty": {"d": 1, "functions": 1}, "prompt": "write HalfTest", "reference": ref,
              "verify": {"kind": "new-test", "path": F.T + "HalfTest.kt", "test_class": "no.nav.syfo.frontier.HalfTest",
                         "functions": ["half"], "build": "test",
                         "mutants": [{"function": "half", "file": "src/main/kotlin/a/Calc.kt",
                                      "find": "x / 2", "replace": "x / 3"}]}}
        doc["tasks"] = [t for t in doc["tasks"] if t["class"] not in ("debug", "create-file")] + [dbg, cf]
        tasks_file = root / "bench" / "frontier" / "tasks-isoppfolgingstilfelle.json"
        tasks_file.write_text(json.dumps(doc, indent=1))
        fake = tmp / "fake-agent"
        fake.write_text(FAKE_SCRIPT)
        fake.chmod(0o755)
        me = str(HERE / "bench-frontier")
        # The fake build reports a failing test only while the break is in.
        # The fake Gradle. "Compile" fails when a function takes `origin: String` and a
        # call does not pass a string first; "test" is red while the bug is in, unless
        # the only test around is one that asserts nothing.
        fb = tmp / "fake-build"
        fb.write_text(FAKE_BUILD_SCRIPT)
        fb.chmod(0o755)
        fake_build = f"{sys.executable} {fb}"
        env = {**os.environ, "FRONTIER_ROOT": str(root), "FRONTIER_FAKE_AGENT": str(fake),
               "FRONTIER_FAKE_BUILD": fake_build, "FRONTIER_LIB": str(HERE), "BENCH_RESTART_SERVER": "0"}

        def bf(*a, mode="good"):
            r = subprocess.run([sys.executable, me, *a], env={**env, "FAKE_MODE": mode},
                               capture_output=True, text=True, timeout=300)
            assert r.returncode == 0, f"bench-frontier {' '.join(a)} failed:\n{r.stdout}\n{r.stderr}"
            return r.stdout
        out = bf("validate", "--workspace-key", "fake")
        assert "baseline suite: green" in out and "✓ db-r1-bx" in out, out
        val = json.loads(next((root / "bench" / "frontier").glob("validated-*.json")).read_text())
        assert val["tasks"]["db-r1-bx"]["failing_tests"] == ["CalcTest"], val["tasks"]["db-r1-bx"]
        assert val["tasks"]["cf-r1-a"]["ok"] and "vacuous test rejected" in val["tasks"]["cf-r1-a"]["note"], val
        # the fake build really can tell a vacuous test from a real one
        assert "✓ cf-r1-a" in out, out
        # the prompt names the failing test validation found
        classes = "edit-multi-mechanical,edit-single,read-qa,create-file,debug"
        out = bf("run", "--profile", "fake", "--classes", classes, "--runs", "2", "--dry-run")
        assert "samples" in out, out
        results = {}
        for mode, variant in (("good", "base"), ("lazy", "base"), ("sloppy", "base"), ("sloppy", "retry2"),
                              ("wrong", "base"), ("good", "decompose")):
            before = set((root / "bench").glob("frontier-*.json"))
            out = bf("run", "--profile", "fake", "--classes", classes, "--runs", "2", "--variant", variant, mode=mode)
            new = set((root / "bench").glob("frontier-*.json")) - before
            assert len(new) == 1, out
            d = json.loads(new.pop().read_text())
            results[(mode, variant)] = d
            time.sleep(1.1)  # stamps are per second
        ok = lambda d, cls: [s["verified"] for s in d["samples"] if s["class"] == cls]  # noqa: E731
        good = results[("good", "base")]
        assert all(s["verified"] for s in good["samples"]), [s["note"] for s in good["samples"] if not s["verified"]]
        assert good["meta"]["harness_sha"] and good["meta"]["tasks_sha"]
        assert {x["class"] for x in good["samples"]} == set(classes.split(",")), {x["class"] for x in good["samples"]}
        assert not any(s["verified"] for s in results[("lazy", "base")]["samples"])
        assert not any(ok(results[("sloppy", "base")], "edit-multi-mechanical"))
        cfs = [s for s in results[("sloppy", "base")]["samples"] if s["class"] == "create-file"]
        assert cfs and not any(s["verified"] for s in cfs) and "mutant survived" in cfs[0]["note"], cfs
        assert all(ok(results[("sloppy", "retry2")], "create-file"))
        sl = [s for s in results[("sloppy", "retry2")]["samples"] if s["class"] == "edit-multi-mechanical"]
        assert all(s["verified"] and s["retries"] == 1 and s["attempts"] == 2 for s in sl), sl
        assert not any(s["class"] == "read-qa" for s in results[("sloppy", "retry2")]["samples"])  # no retry on answers
        assert not any(ok(results[("wrong", "base")], "read-qa"))
        dec = [s for s in results[("good", "decompose")]["samples"]]
        assert dec and all(s["class"].startswith("edit") and s["verified"] for s in dec), dec
        assert any(s["attempts"] == 3 for s in dec)  # formatName: definition + two other files
        # 5. the summary reads them and the verdict logic sees the harvest
        r = subprocess.run([sys.executable, me, "summary", "--json"], env=env, capture_output=True, text=True)
        assert r.returncode == 0, r.stderr
        assert "### edit-multi-mechanical" in r.stdout and "Harvest" in r.stdout, r.stdout
        assert "retry2: 0 → " in r.stdout, r.stdout
        feed = json.loads((root / "bench" / "frontier-summary.json").read_text())
        assert feed["rows"] and all("frontier" in x for x in feed["rows"])
        # past-frontier picks the rungs after the base frontier; lazy base broke at rung 1
        out = bf("run", "--profile", "fake", "--classes", "edit-multi-mechanical", "--rungs", "past-frontier",
                 "--base-glob", "frontier-fake-base-*.json", "--variant", "cap900", "--runs", "1", "--dry-run")
        assert "base frontier" in out, out
        # the cost cap stops a run before the sample that would cross it, and says so
        ledger = tmp / "ledger.json"
        r = subprocess.run([sys.executable, me, "run", "--profile", "fake", "--classes", "read-qa", "--runs", "3",
                            "--cost-cap", "0.25", "--cost-ledger", str(ledger)],
                           env={**env, "FAKE_MODE": "good", "FAKE_COST": "0.1"}, capture_output=True, text=True)
        assert r.returncode == 0 and "COST CAP" in r.stdout, r.stdout + r.stderr
        assert json.loads(ledger.read_text())["spent_usd"] <= 0.25
        capped = json.loads(max((root / "bench").glob("frontier-fake-base-*.json")).read_text())
        assert capped["meta"]["stopped"].startswith("cost cap") and len(capped["samples"]) == 2, capped["meta"]
        print("✓ runner, variants, validation and summary with fake models")
    print("selftest: PASS")
    return 0


def cmd_cloud_probe(args):
    """One real cloud session in a fresh workspace laid out as the run's: pass only if
    the model's write lands in that workspace. A text reply alone passed on night 3
    while every edit went to the wrong directory. Costs about $0.05."""
    CLOUD_WS.mkdir(parents=True, exist_ok=True)
    ws = Path(tempfile.mkdtemp(prefix="probe-", dir=CLOUD_WS))
    try:
        cloud_ws(ws)
        subprocess.run([NAV_PILOT, "alpha", "local", "off"], capture_output=True, check=False)
        H = {"ws": ws, "hide_git": lambda: None, "restore_git": lambda: None}
        a = agent_cloud(H, "Create a file named probe.txt in the current directory containing the single "
                           "word OK. Do nothing else.", False, args.timeout, args.cloud)
        if args.log:
            Path(args.log).write_text(a["out"])
        got = (ws / "probe.txt").read_text().strip() if (ws / "probe.txt").exists() else None
        why = ("timed out" if a["timed_out"] else a["misscoped"] and f"cplt project is {a['misscoped']}"
               or got is None and "no probe.txt in the workspace" or got != "OK" and f"probe.txt holds {got[:40]!r}")
        print(f"{'✓' if not why else '✗'} cloud write probe {args.cloud}: {why or 'wrote into its workspace'}"
              f" · ${a['cost_usd']:.3f}")
        return 1 if why else 0
    finally:
        shutil.rmtree(ws, ignore_errors=True)


def main():
    ap = argparse.ArgumentParser(prog="mise run bench-frontier --")
    sub = ap.add_subparsers(dest="cmd", required=True)
    g = sub.add_parser("gen", help="generate the ladders from a checkout at the pinned ref")
    g.add_argument("--repo", required=True)
    g.add_argument("--out")
    g.add_argument("--check", action="store_true", help="fail if the committed file differs")
    g.add_argument("--any-ref", action="store_true")
    v = sub.add_parser("validate", help="build-check every task on a workspace checkout (CPU, no GPU)")
    v.add_argument("--workspace-key", default=os.environ.get("MLX_ACTIVE_PROFILE") or "qwen3.6-35b-a3b-optiq")
    v.add_argument("--tasks", default=str(TASKS))
    r = sub.add_parser("run", help="run ladders for one profile or cloud model under one variant")
    who = r.add_mutually_exclusive_group()
    who.add_argument("--profile")
    who.add_argument("--cloud", help="cloud model id for nav-pilot, e.g. claude-sonnet-4.6")
    r.add_argument("--classes", default="edit-multi-mechanical")
    r.add_argument("--rungs", help="e.g. 1-4 or 2,5, or past-frontier (the two rungs past the base frontier)")
    r.add_argument("--base-glob", default="frontier-*-base-*.json",
                   help="with --rungs past-frontier: the base result files to read the frontier from")
    r.add_argument("--cost-cap", type=float, help="stop before a sample would take spend past this many USD")
    r.add_argument("--cost-ledger", help="a JSON file carrying spend across steps, so one cap covers a night")
    r.add_argument("--runs", type=int, default=5)
    r.add_argument("--variant", default="base", help="base, or capN retryK example trim decompose joined by +")
    r.add_argument("--tasks", default=str(TASKS))
    r.add_argument("--dry-run", action="store_true")
    r.add_argument("--unvalidated", action="store_true")
    s = sub.add_parser("summary", help="tables, frontiers, and --json for the capabilities feed")
    s.add_argument("--glob", default="frontier-*-*.json")
    s.add_argument("--json", action="store_true")
    c = sub.add_parser("cloud-probe", help="one real cloud session; passes only if its write lands in its workspace")
    c.add_argument("--cloud", required=True)
    c.add_argument("--timeout", type=int, default=180)
    c.add_argument("--log", help="write the session's output here")
    sub.add_parser("selftest", help="fixture repo, fake models, fake build")
    args = ap.parse_args()
    return {"gen": cmd_gen, "validate": cmd_validate, "run": cmd_run, "summary": cmd_summary,
            "cloud-probe": cmd_cloud_probe, "selftest": cmd_selftest}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())

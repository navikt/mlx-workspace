#!/usr/bin/env bash
# Queue the final benchmark measurements for Qwen3.8 to close out PLAN.md

cd "$(dirname "$0")/../.." || exit 1

# Stability verification for the default model candidate (n=5 total, we have 1, so 4 more).
# The two oMLX profiles (qwen3.8-27b-8bit, -nocache) are left out until the
# abliterated community finetune they point at is decided on.
nohup mise run bench-models -- \
  qwen3.8-27b-8bit-nopin \
  qwen3.8-27b-8bit-nopin \
  qwen3.8-27b-8bit-nopin \
  qwen3.8-27b-8bit-nopin \
  > .bench-logs/final-queue.log 2>&1 &

echo "Final benchmark queue launched in background. PID: $!"

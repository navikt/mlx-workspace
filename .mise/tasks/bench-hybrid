def wait_with_deadline(proc, cap, stop=None):
    """Wait for a child, enforcing the cap against the wall clock ourselves.

    `Popen.wait(timeout=...)` was observed sitting thirteen minutes past a 2400s
    deadline with the child still alive, and only returned when the child was killed
    by hand. Whatever the cause, a benchmark cannot depend on it: a cap that does not
    fire turns a hung sample into an unbounded one, and the night's remaining work
    never runs.

    So the deadline is checked here, against time.monotonic(), and the child is killed
    by process group. Returns (returncode, why): why is None for a child that exited on
    its own, "timeout", or what `stop()` returned when it asked for the kill (the cost
    cap, checked every two seconds).
    """
    deadline = time.monotonic() + cap
    why, polled = "timeout", time.monotonic()
    while True:
        rc = proc.poll()
        if rc is not None:
            return rc, None
        if time.monotonic() >= deadline:
            break
        if stop and time.monotonic() - polled >= 2:
            polled = time.monotonic()
            why = stop()
            if why:
                break
            why = "timeout"
        time.sleep(1)
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    # Reap, but never block forever on a child that will not die: a zombie left
    # behind is worse than an unreaped one, because the next sample's port and
    # ownership checks would see it.
    grace = time.monotonic() + 60
    while proc.poll() is None and time.monotonic() < grace:
        time.sleep(1)
    return proc.poll(), why


def load_average():
    """One-minute load average.

    Checked because a benchmark cannot tell a slow model from a busy machine. After
    a reboot Spotlight reindexed at load 16-20, and neither harness would have
    refused to start: every latency recorded in that window would have been a
    measurement of mdworker.
    """
    out = subprocess.run(["/usr/sbin/sysctl", "-n", "vm.loadavg"], capture_output=True,
                         text=True).stdout
    m = re.search(r"([\d.]+)", out)
    return float(m.group(1)) if m else 0.0


def memory():
    """Swap used and free memory, in MB.

    Recorded before and after every rung. The 22 GB download run did not fail
    loudly; it pushed the machine into swap and every later task got slower, which
    is indistinguishable from a worse model unless the number is in the file.
    """
    sw = subprocess.run(["/usr/sbin/sysctl", "-n", "vm.swapusage"], capture_output=True, text=True).stdout
    vm = subprocess.run(["vm_stat"], capture_output=True, text=True).stdout

    def grab(pat, text, cast=float, default=None):
        m = re.search(pat, text)
        return cast(m.group(1)) if m else default

    page = grab(r"page size of (\d+)", vm, int, 4096)
    free = grab(r"Pages free:\s+(\d+)", vm, int, 0)
    spec = grab(r"Pages speculative:\s+(\d+)", vm, int, 0)
    return {
        "swap_used_mb": grab(r"used = ([\d.]+)M", sw),
        "swap_free_mb": grab(r"free = ([\d.]+)M", sw),
        "free_mb": round((free + spec) * page / 1048576),
    }


# Only what a state file written before ports were recorded is assumed to mean.
DEFAULT_PORT_FALLBACK = 8080


def read_cfg(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def recorded_server_port():
    """The port nav-pilot recorded for the running server."""
    st = read_cfg(NP_SERVER_JSON)
    return st.get("port") or DEFAULT_PORT_FALLBACK


def markers(cfg=None):
    """Which of nav-pilot's three dispatch artefacts are present right now."""
    cfg = read_cfg(OPENCODE_CFG) if cfg is None else cfg
    instructions = cfg.get("instructions") or []
    return {
        "worker_model": bool((cfg.get("agent") or {}).get(WORKER_AGENT, {}).get("model")),
        "dispatch_fragment": any(FRAGMENT_MARK in str(i) for i in instructions),
        "mlx_provider": "mlx" in (cfg.get("provider") or {}),
    }


def instruction_inventory(cfg=None):
    """Every file opencode will paste into the system prompt, with its size.

    One run carried 8.5k tokens of unrelated global instructions nobody chose, and
    nothing in the result said so. This cannot be a simple size cap: the dispatch
    fragment is a required instruction in the hybrid arm. So the inventory is
    asserted to exist and written into the results file, where a reader months
    later can see exactly what was in the prompt.
    """
    cfg = read_cfg(OPENCODE_CFG) if cfg is None else cfg
    out = []
    for entry in cfg.get("instructions") or []:
        p = Path(os.path.expanduser(str(entry)))
        out.append({"path": str(p), "bytes": p.stat().st_size if p.exists() else None})
    return out


def port_pid(port):
    # Absolute path: lsof lives in /usr/sbin, which an interactive shell has on its
    # PATH and a detached process often does not. Looked up by name it is simply
    # missing there, and the preflight that depends on it fails for a reason that
    # has nothing to do with the machine under test. Same bug, same day, as the one
    # fixed in nav-pilot itself.
    out = subprocess.run(["/usr/sbin/lsof", "-tiTCP:" + str(port), "-sTCP:LISTEN"],
                         capture_output=True, text=True).stdout.split()
    return int(out[0]) if out else None


def local_completion(port, model, timeout=120):
    """Ask the local server for a real completion. Binding the port is not the
    same as being able to answer: mlx-lm loads weights lazily, so a benchmark that
    starts on bind alone measures model loading as if it were thinking time."""
    body = json.dumps({"model": model, "max_tokens": 8,
                       "messages": [{"role": "user", "content": "Reply with exactly: ok"}]}).encode()
    req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions",
                                 data=body, headers={"Content-Type": "application/json"})
    started = time.time()
    with urllib.request.urlopen(req, timeout=timeout) as r:
        json.load(r)
    return round(time.time() - started, 2)


def log_offset():
    return NP_SERVER_LOG.stat().st_size if NP_SERVER_LOG.exists() else 0


def local_calls_since(offset):
    """POST /v1/chat/completions lines the local server logged during this sample.

    Read by byte offset rather than by tailing, so a rotated or truncated log
    cannot quietly count the previous run's traffic as this one's.
    """
    if not NP_SERVER_LOG.exists():
        return None
    size = NP_SERVER_LOG.stat().st_size
    with NP_SERVER_LOG.open("rb") as fh:
        fh.seek(min(offset, size))
        chunk = fh.read().decode("utf8", "replace")
    return chunk.count("POST /v1/chat/completions")


def parse_events(text):
    """Cloud steps, cloud tokens and the model's reply from opencode's JSON stream.

    nav-pilot, cplt and opencode all write to the same stream, so parse leniently
    and report what actually parsed.
    """
    steps, reply = 0, []
    tok = {"total": 0, "input": 0, "output": 0, "reasoning": 0, "cache_write": 0, "cache_read": 0}
    reasons = []
    # opencode prices each step itself. Worth more than the token total: 91-97%
    # of that total is cache reads, billed at a tenth of the input rate, so a
    # comparison denominated in raw tokens overstates the gap between the arms.
    cost, step_min = 0.0, None
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        kind, part = ev.get("type", ""), ev.get("part") or {}
        if kind == "step_finish":
            steps += 1
            reasons.append(part.get("reason", "?"))
            t = part.get("tokens") or {}
            cache = t.get("cache") or {}
            for k in ("total", "input", "output", "reasoning"):
                tok[k] += int(t.get(k) or 0)
            tok["cache_write"] += int(cache.get("write") or 0)
            tok["cache_read"] += int(cache.get("read") or 0)
            cost += float(part.get("cost") or 0)
            c = float(part.get("cost") or 0)
            step_min = c if step_min is None else min(step_min, c)
        elif kind == "text" and isinstance(part.get("text"), str):
            reply.append(part["text"])
    return {"cloud_steps": steps, "cloud_tokens": tok,
            "cloud_cost_usd": round(cost, 4), "step_min_usd": round(step_min or 0.0, 4),
            "truncated": "length" in reasons,
            "reply": " ".join(reply).strip()}


# Paths a dispatch names. Extension-gated so "underenhet.verdi" in a prompt is
# not taken for a file.
_PATH = re.compile(r"(?:[\w.@-]+/)*[\w@-]+\.(?:kts?|java|tsx?|jsx?|py|go|rs|sql|json|ya?ml|toml|md|xml|gradle|properties|html|css)\b")


def rework(text, workers=(WORKER_AGENT, "lokal-arbeider")):
    """What the orchestrator did with each worker dispatch, from the JSONL stream.

    The parent stream does not carry the worker's own tool calls, so a dispatch's
    files are the paths it names: in the prompt the orchestrator wrote, or in the
    reply the worker returned. Events are in stream order and a task tool_use is
    emitted when the dispatch returns, so "later" means later in the stream.

      redone    a later worker dispatch names one of the same files (or has the
                same description), or the cloud `write`s one of them whole
      fixed     otherwise, the cloud `edit`s one of them
      accepted  neither

    Blind to cloud edits made through bash (sed -i, heredocs); those count as
    accepted. "lokal-arbeider" is the worker's name before nav-pilot renamed it,
    so the August logs can be re-read.
    """
    events = []
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            part = json.loads(line).get("part") or {}
        except ValueError:
            continue
        st = part.get("state") or {}
        inp = st.get("input") or {}
        if part.get("tool") == "task" and inp.get("subagent_type") in workers:
            files = set(_PATH.findall(f"{inp.get('prompt') or ''}\n{st.get('output') or ''}"))
            events.append(("task", inp.get("description") or "", files, st.get("status")))
        elif part.get("tool") in ("edit", "write") and inp.get("filePath"):
            events.append((part["tool"], None, inp["filePath"], None))

    def same(a, b):
        return a == b or a.endswith("/" + b) or b.endswith("/" + a)

    def hit(files, path):
        return any(same(f, path) for f in files)

    out = []
    for i, (kind, desc, files, status) in enumerate(events):
        if kind != "task":
            continue
        later = events[i + 1:]
        redispatch = any(k == "task" and ((files and any(hit(files, f) for f in fs)) or (desc and d == desc))
                         for k, d, fs, _ in later)
        wrote = any(k == "write" and hit(files, p) for k, _, p, _ in later)
        edited = sorted({p for k, _, p, _ in later if k == "edit" and hit(files, p)})
        verdict = "redone" if redispatch or wrote else "fixed" if edited else "accepted"
        out.append({"description": desc, "status": status, "files": sorted(files),
                    "cloud_edited": edited, "redispatched": redispatch,
                    "cloud_wrote": wrote, "verdict": verdict})
    return out


def numstat_lines(numstat):
    """Lines added plus deleted, from `git diff --numstat`. Binary files show '-'."""
    total = 0
    for line in numstat.splitlines():
        cols = line.split("\t")
        if len(cols) >= 2:
            total += sum(int(c) for c in cols[:2] if c.isdigit())
    return total



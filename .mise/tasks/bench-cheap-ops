#!/usr/bin/env python3
# mise description="Run the cheap-operations benchmark for the active model. Usage: mise run bench-cheap-ops [taskid ...]"
"""Run bench/specs/cheap-ops.md tasks against a real Kotlin service, unattended.

Each task starts from a clean checkout, so no task inherits another's edits. That
matters: two of three workspaces used in an earlier round turned out to hold a
previous run's code, which would have invalidated every number.

Verification is done here, not by the model. A model's claim that its tests pass
is not a result; one earlier submission reported "20/20 passing" where eight of
the assertions sat inside a catch block that swallowed them.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
CFG = json.loads((ROOT / "bench" / "tasks.json").read_text())
JDK = Path(os.path.expanduser(CFG.get("jdk", "~")))

key = os.environ.get("MLX_ACTIVE_PROFILE", "").strip()
if not key:
    sys.exit("✗ MLX_ACTIVE_PROFILE not set — run: mise run model-use")

wanted = [a for a in sys.argv[1:] if not a.startswith("-")]
tasks = [t for t in CFG["tasks"] if not wanted or t["id"] in wanted]
if not tasks:
    sys.exit(f"✗ No tasks matched {wanted}")

ws = ROOT / "workspaces" / key
repo = ws / "kotlin"
# A target may name its own results file. Without this, running a second stack
# under the same profile merges into the first stack's results, and ids that
# exist in both sets silently overwrite each other.
suffix = CFG.get("results_suffix", "")
# A repeated run must not overwrite the one before it. BENCH_RUN_TAG makes the
# filename write-once, because a canonical "latest" quietly cost us a run: three
# passes of the scale ladder left two files, one of them a duplicate, and the
# table built from them was wrong in a way that took a second reader to catch.
run_tag = os.environ.get("BENCH_RUN_TAG", "").strip()
results_path = ROOT / "bench" / f"results-{key}{suffix}{'-' + run_tag if run_tag else ''}.json"
results = json.loads(results_path.read_text()) if results_path.exists() else {}
if results:
    # Results are keyed by the active profile, so a failed `model-use` leaves the
    # previous model active and this run merges into its file. That happened: a
    # profile with an invalid status field refused to activate, the run went to
    # the wrong model, and three tasks of a finished run were overwritten before
    # anyone noticed. Keep a copy of what was there.
    backup = ROOT / "bench" / ".previous" / f"results-{key}-{int(results_path.stat().st_mtime)}.json"
    backup.parent.mkdir(parents=True, exist_ok=True)
    backup.write_text(results_path.read_text())
    print(f"→ existing results backed up to {backup.relative_to(ROOT)}")


def sh(cmd, cwd=None, timeout=1800, env=None):
    e = {**os.environ, **(env or {})}
    return subprocess.run(cmd, cwd=cwd and str(cwd), capture_output=True,
                          text=True, timeout=timeout, env=e)


def ensure_clone():
    if (repo / ".git").is_dir():
        # Existing checkouts are not trusted. Two faults came through here: a
        # frontend run left a TypeScript repo in a Kotlin workspace, and the ref
        # said "master" so workspaces drifted to three different commits — the
        # two models in the headline comparison were solving different code.
        want_repo = CFG["repo"].rsplit("/", 1)[-1]
        have = sh(["git", "remote", "get-url", "origin"], cwd=repo).stdout.strip()
        if not have.endswith(want_repo):
            raise SystemExit(
                f"\u2717 {repo} is a checkout of {have or 'nothing'}, and the tasks need {want_repo}.\n"
                f"  Remove it and let the harness clone the right one.")
        head = sh(["git", "rev-parse", "HEAD"], cwd=repo).stdout.strip()
        if head != CFG["ref"]:
            f = sh(["git", "fetch", "-q", "--depth", "1", "origin", CFG["ref"]], cwd=repo, timeout=600)
            if f.returncode != 0:
                raise SystemExit(f"\u2717 cannot fetch the pinned ref {CFG['ref'][:8]}: {f.stderr[-300:]}")
            sh(["git", "checkout", "-q", "FETCH_HEAD"], cwd=repo)
            print(f"\u2192 {repo.parent.name}: moved to the pinned commit {CFG['ref'][:8]}")
        return
    ws.mkdir(parents=True, exist_ok=True)
    print(f"→ Cloning {CFG['repo']} at {CFG['ref']}")
    # `git clone -b` takes a branch or tag, not a commit. Targets are pinned to a
    # SHA so a dependency bump cannot change the benchmark under us, so clone the
    # default branch and then fetch the exact commit.
    r = sh(["git", "clone", "--depth", "1", CFG["repo"], str(repo)], timeout=900)
    if r.returncode != 0:
        raise SystemExit(f"✗ clone failed: {r.stderr[-400:]}")
    ref = CFG["ref"]
    if ref not in ("main", "master"):
        f = sh(["git", "fetch", "-q", "--depth", "1", "origin", ref], cwd=repo, timeout=600)
        if f.returncode != 0:
            raise SystemExit(f"✗ fetch of {ref} failed: {f.stderr[-400:]}")
        sh(["git", "checkout", "-q", "FETCH_HEAD"], cwd=repo)


def reset_repo():
    """Hard reset plus clean, so a task never sees the previous task's edits."""
    sh(["git", "reset", "--hard", "-q"], cwd=repo)
    sh(["git", "clean", "-qfd", "-e", "build", "-e", ".gradle"], cwd=repo)


def build(target):
    """Run the target's compile or test command.

    A task set may declare `compile_cmd` and `test_cmd`, which is how the
    TypeScript targets work. Without them we assume Gradle, which needs
    JAVA_HOME on JDK 21: the machine default is newer and the project pins
    jvmToolchain(21), which Gradle will not auto-provision.
    """
    cmd = CFG.get(f"{target}_cmd")
    if cmd:
        return sh(["bash", "-lc", cmd], cwd=repo, timeout=1800)
    gradle_target = "compileKotlin" if target == "compile" else "test"
    return sh(["./gradlew", gradle_target, "--console=plain", "-q", "--offline"],
              cwd=repo, timeout=1800,
              env={"JAVA_HOME": str(JDK),
                   "PATH": f"{JDK}/bin:" + os.environ.get("PATH", "")})


def changed_files():
    """What the model actually modified. An edit task that changed nothing must not
    pass: an untouched repo compiles and its suite passes, so compile and test
    checks alone certify the repo's health, not the model's work. Granite scored
    four false passes this way before this check existed."""
    out = sh(["git", "status", "--porcelain"], cwd=repo).stdout.strip()
    return [l for l in out.splitlines() if l.strip()]


def apply_break(task):
    """Put the bug in, after the reset, as uncommitted working-tree state.

    Uncommitted on purpose. A broken commit is discoverable with `git log`, and a
    model that reverts it has demonstrated git skill rather than the ability to
    read code and find a fault. With no history to consult, the only route is the
    failing test and the source.
    """
    b = task.get("break")
    if not b:
        return
    f = repo / b["file"]
    text = f.read_text()
    n = text.count(b["find"])
    if n != 1:
        raise SystemExit(f"✗ {task['id']}: the break site appears {n} times in {b['file']}, "
                         f"expected exactly one. The target moved; fix the task before measuring.")
    f.write_text(text.replace(b["find"], b["replace"], 1))


def touched_a_test(files):
    """Test files the model changed. Going green by weakening an assertion is the
    cheap way through every one of these tasks, and it is not debugging."""
    return [f for f in files if ".test." in f or "/__tests__/" in f or f.endswith("Test.kt")]


def verify(task):
    kind = task["verify"]
    if kind == "debug":
        touched = changed_files()
        if not touched:
            return False, "no changes made (the bug is still there)"
        # The porcelain line is "XY path"; take the path.
        cheated = touched_a_test([l[3:].strip() for l in touched])
        if cheated:
            return False, f"edited the test instead of the code: {cheated[0]}"
        r = build("test")
        return r.returncode == 0, "suite green" if r.returncode == 0 else "suite still failing"
    if kind in ("compile", "test", "rename"):
        touched = changed_files()
        if not touched:
            return False, "no changes made (model did not edit anything)"
    if kind == "compile":
        r = build("compile")
        return r.returncode == 0, "compiles" if r.returncode == 0 else "compile failed"
    if kind == "test":
        r = build("test")
        return r.returncode == 0, "suite passes" if r.returncode == 0 else "suite failed"
    if kind == "rename":
        old, new = task["old_symbol"], task["new_symbol"]
        # grep exits 1 for "no match" and 2 for an error. Treating 2 as "no
        # hits" turns a broken grep into a pass, so the two are separated.
        g = sh(["grep", "-rn", old, "src"], cwd=repo)
        if g.returncode >= 2:
            return False, f"grep failed while checking the old symbol: {g.stderr.strip()[:80]}"
        if g.stdout.strip():
            return False, f"old symbol still present ({len(g.stdout.strip().splitlines())} refs)"
        # The new symbol has to exist. Without this, deleting every reference to
        # the old one passes: the grep finds nothing and the tree still compiles
        # if the symbol was unused outside its own definition. A rename that
        # renames nothing scored the same as a rename that worked.
        gn = sh(["grep", "-rn", new, "src"], cwd=repo)
        if gn.returncode >= 2:
            return False, f"grep failed while checking the new symbol: {gn.stderr.strip()[:80]}"
        if not gn.stdout.strip():
            return False, "old symbol gone but the new one was never introduced"
        r = build("compile")
        return r.returncode == 0, f"renamed to {new} and compiles" if r.returncode == 0 else "renamed but broken"
    return None, "needs a human"


def restart_server():
    """Restart the inference server before every task.

    The server degrades across a long session: after some number of tasks the
    model stops calling tools entirely and every later task fails with no edits.
    Restarting between tasks turns that from a silent confound into a known cost.
    Demonstrated directly: a task that produced 0 turns and 0 tool calls passed
    with 6 turns and 9 tool calls after nothing changed but a server restart.
    """
    # Retry the start. A server launched while the previous one is still
    # releasing port 8080 exits on the bind, and server-wait then blocks for its
    # full timeout against a process that is already gone. Seen once between two
    # models in the same queue.
    log = ROOT / ".bench-logs" / "server-restart.log"
    for attempt in range(3):
        subprocess.run(["mise", "run", "server-stop"], cwd=str(ROOT),
                       capture_output=True, text=True)
        time.sleep(2)
        with log.open("a") as fh:
            subprocess.Popen(["mise", "run", "server"], cwd=str(ROOT),
                             stdout=fh, stderr=subprocess.STDOUT,
                             start_new_session=True)
        r = subprocess.run(["mise", "run", "server-wait"], cwd=str(ROOT),
                           capture_output=True, text=True, timeout=1800)
        if r.returncode == 0:
            return
        print(f"   ⚠ server did not come back (attempt {attempt + 1} of 3)")
    raise SystemExit(f"✗ server did not come back: {r.stdout}{r.stderr}")


def loop_check(out):
    """Count the longest run of identical consecutive tool calls in a task.

    Qwen3.8-27B-4bit ran the same `rg` command 113 times after a successful edit,
    burning a 1800s cap. Without this, a loop and a genuinely slow model produce
    the same record, and the difference is the whole verdict on a model.
    """
    m = re.search(r"log: (\S+\.jsonl)", out)
    if m:
        path = ROOT / m.group(1)
    else:
        # A killed task never prints its log path, and a killed task is exactly
        # the one that looped, so fall back to the newest log for this profile.
        logs = sorted((ROOT / ".bench-logs").glob(f"{key}-*.jsonl"),
                      key=lambda p: p.stat().st_mtime)
        if not logs:
            return {}
        path = logs[-1]
    if not path.exists():
        return {}
    calls = []
    for line in path.read_text(errors="replace").splitlines():
        if '"type": "tool_use"' not in line and '"type":"tool_use"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        p = d.get("part", {})
        name = p.get("tool") or p.get("name") or "?"
        args = json.dumps(p.get("state", {}).get("input", p.get("input", {})), sort_keys=True)
        calls.append((name, args))
    best = run = 1
    which = None
    for i in range(1, len(calls)):
        if calls[i] == calls[i - 1]:
            run += 1
            if run > best:
                best, which = run, calls[i][0]
        else:
            run = 1
    return {"tool_calls_logged": len(calls),
            "longest_identical_run": best if calls else 0,
            "looped_on": which if best >= 5 else None}


def run_task(task):
    if os.environ.get("BENCH_RESTART_SERVER", "1") == "1":
        restart_server()
    reset_repo()
    apply_break(task)
    started = time.time()
    # Per-task cap. E3 looped 77 identical tool calls twice and consumed a whole
    # 90-minute budget both times, starving three later tasks. A cap turns a loop
    # into a recorded failure instead of a lost run.
    cap = int(os.environ.get("BENCH_TASK_TIMEOUT", "420"))
    timed_out = False
    try:
        r = sh(["mise", "run", "opencode-headless", task["prompt"]], cwd=ROOT, timeout=cap)
        out = r.stdout + r.stderr
    except subprocess.TimeoutExpired as e:
        timed_out = True
        out = (e.stdout or b"").decode("utf8", "replace") + (e.stderr or b"").decode("utf8", "replace")
        # subprocess kills `mise run`, not the client it launched. Six orphaned
        # opencode processes accumulated over one day of killed runs, each
        # holding its session state, and the machine ended up in swap.
        subprocess.run(["/usr/bin/pkill", "-f", "opencode --pure"], capture_output=True)
        subprocess.run(["/usr/bin/pkill", "-f", "cplt --agent opencode"], capture_output=True)
    elapsed = time.time() - started

    def grab(pat, cast=str, default=None):
        m = re.search(pat, out)
        return cast(m.group(1).replace(",", "")) if m else default

    rec = {
        "task": task["id"], "kind": task["kind"], "seconds": round(elapsed, 1),
        "turns": grab(r"· (\d+) turns", int, 0),
        "tool_calls": grab(r"· (\d+) tool calls", int, 0),
        "tokens_in": grab(r"in ([\d,]+) ·", int, 0),
        "tokens_out": grab(r"out ([\d,]+) ·", int, 0),
        "truncated": "TRUNCATED" in out,
        "exit": grab(r"exit (\d+)", int, -1),
        "timed_out": timed_out,
    }
    # Record term hits before any early return, so a timed-out task is still
    # comparable field-for-field with a completed one.
    if task.get("expect_terms"):
        reply = out.split("reply:", 1)[1] if "reply:" in out else out
        rec["terms_found"] = [t for t in task["expect_terms"] if t in reply]
        rec["terms_expected"] = task["expect_terms"]
    rec.update(loop_check(out))
    rec["files_changed"] = len(changed_files())
    if timed_out:
        rec["verified"] = False
        rec["note"] = f"timed out after {cap}s"
        # opencode-headless prints its summary line at the end, so a killed task
        # leaves nothing to parse and these fields default to zero. Zero turns
        # reads as "the model did nothing", which is a different claim from "we
        # do not know", and it has been misread twice.
        for f in ("turns", "tool_calls", "tokens_in", "tokens_out", "exit"):
            rec[f] = None
        return rec
    ok, note = verify(task)
    rec["verified"] = ok
    rec["note"] = note
    # A read task with expect_terms is checkable without a human: the answer
    # either contains every term or it does not. verify() cannot do this because
    # it never sees the model's reply.
    if task["verify"] == "grep_answer" and "terms_found" in rec:
        found, want = len(rec["terms_found"]), len(rec["terms_expected"])
        rec["verified"] = found == want
        rec["note"] = f"{found} of {want} expected terms in the answer"
    return rec


ensure_clone()
print(f"→ {key} · {len(tasks)} task(s) · repo {repo.relative_to(ROOT)}")
for task in tasks:
    print(f"\n── {task['id']} ({task['kind']}, verify={task['verify']})")
    rec = run_task(task)
    results[task["id"]] = rec
    results_path.write_text(json.dumps(results, indent=2))  # write as we go
    flag = {True: "✓", False: "✗", None: "·"}[rec["verified"]]
    if rec.get("looped_on"):
        print(f"   ⚠  LOOP: {rec['longest_identical_run']} identical "
              f"{rec['looped_on']} calls in a row")
    # Timed-out tasks carry None for the parsed fields, so nothing here may
    # assume a number. A format string that did crashed a run at its first
    # timeout and cost six tasks.
    def show(v, fmt=""):
        return "?" if v is None else format(v, fmt)
    print(f"   {flag} {rec['seconds']}s · {show(rec['turns'])} turns · "
          f"{show(rec['tool_calls'])} tools · {rec['files_changed']} files · "
          f"in {show(rec['tokens_in'], ',')} · {rec['note']}"
          + ("  ⚠ TRUNCATED" if rec["truncated"] else ""))
    if "terms_found" in rec:
        print(f"     terms: {len(rec['terms_found'])}/{len(rec['terms_expected'])} "
              f"{rec['terms_found']}")

reset_repo()
print(f"\n✓ Results → {results_path.relative_to(ROOT)}")

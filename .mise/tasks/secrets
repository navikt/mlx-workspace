#!/usr/bin/env bash
# mise description="Scan the whole history for committed credentials. Usage: mise run secrets"
#
# This repository's workflow is the kind that recommits secrets: curl against
# local servers, pasted client transcripts, and a habit of `git add -A` that once
# swept a cookie jar into a 127-file commit. Run this before pushing anything
# that touched a config or a transcript.
set -euo pipefail
cd "$(dirname "$0")/../.."
if ! command -v gitleaks >/dev/null; then
  echo "gitleaks is not installed: brew install gitleaks"
  exit 1
fi
gitleaks detect --no-banner --redact -c .gitleaks.toml "$@"

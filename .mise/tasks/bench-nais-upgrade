#!/usr/bin/env python3
# mise description="Dependency-upgrade tasks on nais/examples (loadgen, frontend, tools) per local model. Usage: mise run bench-nais-upgrade -- --base <clone> --out <dir> --models a,b --tasks loadgen,frontend,tools [--cap-min 25] [--deadline <epoch>]"
"""Each (model, task) gets a fresh clone of --base and a branch upgrade/<task>-<model>.
The model runs once through opencode in cplt, capped at --cap-min. The grader then runs
outside the sandbox on that clone: did the versions move, are the checks green, did it
touch only the task's files, did anything get removed or downgraded. One JSON line per
sample goes to <out>/results.jsonl. Nothing is pushed anywhere.
"""
import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
import shutil
import tomllib
import urllib.request
from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
sys.path.insert(0, str(HERE))
import _sandbox as S  # noqa: E402

BF = SourceFileLoader("bench_frontier", str(HERE / "bench-frontier")).load_module()  # stop_daemons, reap_shm

COMMON = ("Work only in this repository. Run the checks yourself and fix what breaks. "
          "Do not touch files outside the scope below. Do not commit; leave the changes in "
          "the working tree. When done, reply with a short list of what moved from which "
          "version to which.")
TASKS = {
    "loadgen": dict(
        scope=r"^quotes-loadgen/(go\.mod|go\.sum|.*\.go)$",
        prompt="Upgrade every Go dependency in quotes-loadgen to its latest version "
               "(go get -u ./... && go mod tidy, then direct deps one by one if needed). "
               "Success: `go build ./... && go test ./...` pass in quotes-loadgen. "
               "Scope: quotes-loadgen/go.mod, go.sum, and Go source only if an API changed. "),
    "frontend": dict(
        scope=r"^quotes-frontend/(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|src/.*|.*\.config\.(m?js|ts))$",
        prompt="Upgrade every dependency in quotes-frontend/package.json to its latest version "
               "with pnpm (e.g. `pnpm update --latest`), keeping pnpm-lock.yaml in sync. "
               "Success: in quotes-frontend `pnpm install --frozen-lockfile`, `pnpm exec vitest run`, "
               "`pnpm exec tsc --noEmit`, `pnpm exec eslint .` and `pnpm build` all pass. "
               "Scope: quotes-frontend/package.json, pnpm-lock.yaml, and source or config only "
               "where an upgrade forces it. "),
    "tools": dict(
        scope=r"^(\.mise\.toml|quotes-[a-z]+/\.mise\.toml|quotes-[a-z]+/Dockerfile|docker-compose\.yaml|\.github/workflows/[^/]+\.ya?ml)$",
        prompt="Upgrade tool and image versions to the latest stable releases: pinned tools in "
               ".mise.toml and quotes-*/.mise.toml, base image tags in quotes-*/Dockerfile and "
               "docker-compose.yaml, and GitHub Actions versions in .github/workflows (keep SHA "
               "pins as SHA pins with the version comment). Keep each Dockerfile's runtime in step "
               "with the tool versions. Do not touch dependency manifests. Docker is not "
               "available; check tags against the registries over HTTPS. Success: every changed "
               "version exists upstream and nothing is downgraded. "),
}

ap = argparse.ArgumentParser()
ap.add_argument("--base", required=True)
ap.add_argument("--out", required=True)
ap.add_argument("--models", required=True)
ap.add_argument("--tasks", default="loadgen,frontend,tools")
ap.add_argument("--cap-min", type=float, default=25)
ap.add_argument("--deadline", type=float, default=0, help="epoch secs; no sample starts after deadline - cap")
args = ap.parse_args()
OUT = Path(args.out).expanduser()
OUT.mkdir(parents=True, exist_ok=True)
BASE = Path(args.base).expanduser()
(OUT.parent / "cplt-cfg").mkdir(exist_ok=True)   # not OUT: cplt treats its config dir as state, clones can't live there
CPLT_CFG = S.bench_cplt_config(OUT.parent / "cplt-cfg" / "cplt.toml")   # absolute toolchain grants; HOME is a temp dir
# The global mise config pins pnpm = latest (12), which shadows the repo's npm:pnpm 10 inside
# `mise exec` and fails `pnpm install --frozen-lockfile` on a lockfile-settings mismatch.
os.environ["MISE_DISABLE_TOOLS"] = "pnpm"
os.environ.setdefault("MISE_FETCH_REMOTE_VERSIONS_TIMEOUT", "2")
HSHA = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=ROOT, capture_output=True, text=True).stdout.strip()


def sh(cmd, cwd, timeout=900, env=None):
    try:
        r = subprocess.run(cmd, cwd=cwd, shell=isinstance(cmd, str), capture_output=True, text=True,
                           timeout=timeout, env=env)
        return r.returncode, r.stdout + r.stderr   # untruncated: `pnpm outdated --format json` is parsed whole
    except subprocess.TimeoutExpired:
        return 124, "timeout"


def mise(cmd, cwd, timeout=900):
    return sh(f"mise exec -- {cmd}", cwd, timeout, {**os.environ, "MISE_FETCH_REMOTE_VERSIONS_TIMEOUT": "2"})


def restart_server():
    (ROOT / ".bench-logs").mkdir(exist_ok=True)
    log = open(ROOT / ".bench-logs" / "server-restart.log", "a")
    for _ in range(3):
        subprocess.run(["mise", "run", "server-stop"], cwd=ROOT, capture_output=True)
        time.sleep(2)
        subprocess.Popen(["mise", "run", "server"], cwd=ROOT, stdout=log, stderr=subprocess.STDOUT,
                         start_new_session=True)
        if subprocess.run(["mise", "run", "server-wait"], cwd=ROOT, capture_output=True,
                          timeout=1800).returncode == 0:
            return True
    return False


def vers_go(repo):
    t = (repo / "quotes-loadgen/go.mod").read_text()   # direct deps only: tidy may drop indirect ones
    return dict(re.findall(r"(?m)^\s*(?:require\s+)?([\w./-]+\.[\w./-]+)\s+(v[\w.+-]+)\s*$", t)) | \
        {"go": (re.search(r"(?m)^go (\S+)", t) or [None, None])[1]}


def vers_pkg(repo):
    p = json.loads((repo / "quotes-frontend/package.json").read_text())
    return {k: v for s in ("dependencies", "devDependencies") for k, v in p.get(s, {}).items()}


def vers_tools(repo):
    v = {}
    for f in [repo / ".mise.toml", *repo.glob("quotes-*/.mise.toml")]:
        for k, x in tomllib.loads(f.read_text()).get("tools", {}).items():
            v[f"{f.relative_to(repo)}:{k}"] = str(x)
    for f in [*repo.glob("quotes-*/Dockerfile"), repo / "docker-compose.yaml"]:
        for img in re.findall(r"(?m)^\s*(?:FROM|image:)\s+(\S+:\S+)", f.read_text()):
            v[f"{f.relative_to(repo)}:{img.rsplit(':', 1)[0]}"] = img.rsplit(":", 1)[1]
    for f in repo.glob(".github/workflows/*.y*ml"):
        for a, ref in re.findall(r"uses:\s*([\w.-]+/[\w./-]+)@(\S+(?:\s*#\s*\S+)?)", f.read_text()):
            v[f"{f.name}:{a}"] = ref
    return v


def num(s):
    return tuple(int(x) for x in re.findall(r"\d+", str(s).split("@")[-1])[:4])


def tag_exists(image, tag):
    """Anonymous registry v2 HEAD of image:tag. None when the registry can't be asked."""
    if tag in ("latest",) or "$" in image + tag:
        return None
    host, _, path = image.partition("/")
    if "." not in host:
        host, path = "registry-1.docker.io", image if "/" in image else f"library/{image}"
    try:
        tok = None
        if host == "registry-1.docker.io":
            tok = json.load(urllib.request.urlopen(
                f"https://auth.docker.io/token?service=registry.docker.io&scope=repository:{path}:pull", timeout=20))["token"]
        elif host == "gcr.io":
            tok = json.load(urllib.request.urlopen(f"https://gcr.io/v2/token?scope=repository:{path}:pull", timeout=20))["token"]
        req = urllib.request.Request(f"https://{host}/v2/{path}/manifests/{tag.split('@')[0]}", method="HEAD", headers={
            "Accept": "application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.docker.distribution.manifest.v2+json",
            **({"Authorization": f"Bearer {tok}"} if tok else {})})
        return urllib.request.urlopen(req, timeout=20).status == 200
    except urllib.error.HTTPError as e:
        return False if e.code == 404 else None
    except Exception:
        return None


def _j(url):
    return json.load(urllib.request.urlopen(url, timeout=30))


def _gh_latest(repo):
    r = subprocess.run(["gh", "api", f"repos/{repo}/releases/latest", "-q", ".tag_name"], capture_output=True, text=True)
    return r.stdout.strip() or None


def latest_versions():
    """Upstream latest for what the tools task can move. Missing entries are not checked."""
    L = {}
    for k, f in {"node": lambda: _j("https://nodejs.org/dist/index.json")[0]["version"].lstrip("v"),
                 "go": lambda: _j("https://go.dev/dl/?mode=json")[0]["version"].removeprefix("go"),
                 "npm:pnpm": lambda: _j("https://registry.npmjs.org/pnpm/latest")["version"],
                 "watchexec": lambda: _gh_latest("watchexec/watchexec").lstrip("v")}.items():
        try:
            L[k] = f()
        except Exception:
            pass
    return L


def tools_behind(v, L):
    """Entries of vers_tools(v) still behind upstream. Pins compare on the pinned prefix
    (node "25" vs 26.x is behind; "26" is not); "latest" is never behind. Actions compare
    the ratchet tag's major with the latest release's major; branch refs are skipped."""
    out = []
    for k, val in v.items():
        f, _, name = k.partition(":")
        if f.endswith(".mise.toml") and name in L and val != "latest":
            n = len(num(val))
            if num(val) < num(L[name])[:n]:
                out.append(f"{k}={val}<{L[name]}")
        elif "Dockerfile" in f or "docker-compose" in f:
            img = name.rsplit("/", 1)[-1]
            ref = {"golang": L.get("go"), "node": L.get("node")}.get(img)
            if ref and num(val) and num(val) < num(ref)[:len(num(val))]:
                out.append(f"{k}={val}<{ref}")
        elif f.endswith((".yml", ".yaml")) and (m := re.search(r"@(v\d[\w.]*)\s*$", val)):
            repo = "/".join(name.split("/")[:2])
            lat = _gh_latest(repo)
            if lat and num(m[1])[:1] < num(lat)[:1]:
                out.append(f"{k}={m[1]}<{lat}")
    return out


VERS = {"loadgen": vers_go, "frontend": vers_pkg, "tools": vers_tools}


def checks(task, repo):
    if task == "loadgen":
        d = repo / "quotes-loadgen"
        steps = {"build": "go build ./...", "test": "go test ./..."}
        res = {k: mise(c, d)[0] == 0 for k, c in steps.items()}
        _, o = mise("go list -m -u -f '{{if and (not .Indirect) .Update}}{{.Path}}{{end}}' all", d, 300)
        res["behind"] = len([x for x in o.splitlines() if x.strip() and "WARN" not in x])
        return res
    if task == "frontend":
        d = repo / "quotes-frontend"
        res = {}
        for k, c in {"install": "pnpm install --frozen-lockfile", "test": "pnpm exec vitest run",
                     "tsc": "pnpm exec tsc --noEmit", "lint": "pnpm exec eslint .", "build": "pnpm build"}.items():
            res[k] = mise(c, d)[0] == 0
            if not res["install"]:
                break
        _, o = mise("pnpm outdated --format json", d, 300)
        try:
            res["behind"] = sum(1 for x in json.loads(o[o.index("{"):]).values() if x["current"] != x["latest"])
        except Exception:
            res["behind"] = None
        return res
    # tools: files parse, changed image tags exist upstream
    res = {"parse": True}
    try:
        vers_tools(repo)
        for f in repo.glob(".github/workflows/*.y*ml"):
            if subprocess.run([sys.executable, "-c", "import sys,yaml;yaml.safe_load(open(sys.argv[1]))", f],
                              capture_output=True).returncode == 1:
                res["parse"] = False
    except Exception:
        res["parse"] = False
    return res


def grade(task, repo, before):
    after = VERS[task](repo)
    files = [x for x in sh("git diff --name-only base -- .", repo)[1].splitlines() if x]
    moved = {k: [before[k], after[k]] for k in before if k in after and after[k] != before[k]}
    removed = sorted(set(before) - set(after))
    down = [k for k, (a, b) in moved.items() if num(b) and num(a) and num(b) < num(a)]
    g = {"files": files, "unrelated": [f for f in files if not re.match(TASKS[task]["scope"], f)],
         "moved": moved, "n_moved": len(moved), "removed": removed, "downgraded": down,
         "checks": checks(task, repo) if files else {}}
    if task == "tools":
        bad = []
        for k, (_, b) in moved.items():
            if "Dockerfile" in k or "docker-compose" in k:
                ok = tag_exists(k.split(":", 1)[1], b)
                if ok is False:
                    bad.append(f"{k}:{b}")
        g["checks"]["missing_tags"] = bad
    c = {k: v for k, v in g["checks"].items() if isinstance(v, bool)}
    g["green"] = bool(files) and all(c.values()) and not g.get("checks", {}).get("missing_tags")
    if task == "tools":
        g["checks"]["behind"] = len(tb := tools_behind(after, latest_versions()))
        g["behind_list"] = tb
    g["fully_upgraded"] = g["checks"].get("behind") == 0
    g["pass"] = g["green"] and g["fully_upgraded"] and not g["unrelated"] and not removed and not down
    return g


def descendants(pid):
    rows = [l.split() for l in subprocess.run(["ps", "-Ao", "pid=,ppid="], capture_output=True, text=True).stdout.splitlines()]
    out, todo = [], [pid]
    while todo:
        q = todo.pop()
        kids = [int(a) for a, b in rows if int(b) == q]
        out += kids
        todo += kids
    return out


def kill_session(pid):
    """TERM then KILL the session's process group; when the group can't be signalled
    (gone, or EPERM because cplt re-parented members), fall back to the tracked PIDs."""
    for sig in (signal.SIGTERM, signal.SIGKILL):
        pids = [pid, *descendants(pid)]
        try:
            os.killpg(pid, sig)
        except (ProcessLookupError, PermissionError):
            for x in pids:
                try:
                    os.kill(x, sig)
                except (ProcessLookupError, PermissionError):
                    pass
        time.sleep(5)
        if not any(_alive(x) for x in pids):
            return


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def pnpm_bin(repo):
    r = subprocess.run(["mise", "where", "npm:pnpm"], cwd=repo / "quotes-frontend", capture_output=True, text=True)
    return r.stdout.strip() + "/bin"


def run_one(model, task):
    repo = OUT / "clones" / f"{model}--{task}"
    if repo.exists():
        sh(["rm", "-rf", str(repo)], OUT)
    sh(["git", "clone", "-q", str(BASE), str(repo)], OUT)
    sh(["git", "remote", "remove", "origin"], repo)       # nothing to push to
    sh(["git", "branch", "base"], repo)
    sh(["git", "switch", "-q", "-c", f"upgrade/{task}-{model}"], repo)
    (repo / ".git/info/exclude").write_text("opencode.json\n.opencode/\nnode_modules/\n.pnpm-store/\n.next/\nAGENTS.local.md\n")
    if subprocess.run(["mise", "run", "opencode-init", str(repo)], cwd=ROOT, capture_output=True).returncode:
        return {"error": "opencode-init failed"}
    before = VERS[task](repo)
    base_checks = checks(task, repo)
    red = [k for k, x in base_checks.items() if x is False]
    if red:
        return {"skipped": f"baseline red: {red}", "baseline": base_checks}
    home, henv = S.own_home("nais-upgrade-")   # never the real ~/.local/share/opencode, ~/.copilot, ~/.nav-pilot
    # opencode's package cache, copied (never linked): a fresh one makes opencode install
    # its packages at start-up, and execs from that tree are denied, so the session hangs.
    shutil.copytree(Path.home() / ".cache/opencode", home / ".cache/opencode", dirs_exist_ok=True)
    HOME_W = []   # write grants inside the temp HOME; not HOME itself, which would deny exec under .cache/opencode/bin
    for rel in (".local/share/opencode", ".cache/opencode", ".config", "go", "Library", ".npm", ".cache/go-build"):
        (home / rel).mkdir(parents=True, exist_ok=True)
        HOME_W += ["--allow-write", str(home / rel)]
    env = S.bench_env({**os.environ, **henv, "CPLT_CONFIG": str(CPLT_CFG),
                       # the repo's pinned pnpm ahead of the global pnpm 12, and its store in the temp HOME
                       "PATH": f"{pnpm_bin(repo)}:{os.environ['PATH']}",
                       "npm_config_store_dir": str(home / "Library/pnpm/store")})
    prompt = TASKS[task]["prompt"] + COMMON
    argv = S.cplt_argv(repo, repo, "8080", extra=["--yes", "--quiet", *HOME_W])
    if argv is None:
        raise SystemExit("cplt missing; refusing to run unsandboxed")
    log = OUT / "logs" / f"{model}--{task}.jsonl"
    log.parent.mkdir(exist_ok=True)
    t0 = time.time()
    for start in (1, 2):   # opencode sometimes never starts (no event at all); one retry
        with log.open("w") as fh:
            p = subprocess.Popen(argv + ["--", "--pure", "--print-logs", "run", "--format", "json", prompt], cwd=repo,
                                 stdout=fh, stderr=subprocess.STDOUT, env=env, start_new_session=True)
            rc = "killed"
            try:
                deadline = time.time() + args.cap_min * 60
                while (rc := p.poll()) is None:
                    if time.time() > deadline:
                        rc = "timeout"
                        break
                    if time.time() - t0 > 240 and '"type":"step_start"' not in log.read_text().replace(" ", ""):
                        rc = "no-start"
                        break
                    time.sleep(5)
            finally:   # cap, stall, or SIGTERM from the launcher: the whole session goes
                kill_session(p.pid)
        if rc != "no-start":
            break
        t0 = time.time()
    shutil.rmtree(home, ignore_errors=True)
    secs = round(time.time() - t0)
    n_tools = sum(1 for x in log.read_text().splitlines() if '"type":"tool_use"' in x.replace(" ", ""))
    sh(["git", "add", "-A"], repo)
    sh(["git", "-c", "user.name=bench", "-c", "user.email=bench@localhost", "commit", "-qm",
        f"upgrade {task} ({model})"], repo)
    g = grade(task, repo, before)
    return {"rc": rc, "seconds": secs, "tool_calls": n_tools, "baseline": base_checks, **g}


def main():
    meta = {"harness_sha": HSHA, "base_sha": sh(["git", "rev-parse", "--short", "HEAD"], BASE)[1].strip()}
    for model in args.models.split(","):
        if subprocess.run(["mise", "run", "model-use", model], cwd=ROOT, capture_output=True).returncode:
            print(f"✗ model-use {model} failed; skipping", flush=True)
            continue
        for task in args.tasks.split(","):
            if args.deadline and time.time() + args.cap_min * 60 > args.deadline:
                print("deadline: stopping", flush=True)
                return
            if not restart_server():
                rec = {"error": "server did not start"}
            else:
                try:
                    rec = run_one(model, task)
                except Exception as e:   # one task failing never stops the queue
                    rec = {"error": f"{type(e).__name__}: {e}"}
            subprocess.run(["mise", "run", "server-stop"], cwd=ROOT, capture_output=True)
            BF.stop_daemons()   # PID-only, sandbox-started Gradle/Kotlin daemons + orphan shm
            rec = {"model": model, "task": task, **meta, "at": time.strftime("%F %T"), **rec}
            with (OUT / "results.jsonl").open("a") as fh:
                fh.write(json.dumps(rec) + "\n")
            print(f"{'✓' if rec.get('pass') else '✗'} {model} {task} {rec.get('seconds')}s "
                  f"moved={rec.get("n_moved")} full={rec.get("fully_upgraded")} green={rec.get('green')} unrelated={len(rec.get('unrelated') or [])} "
                  f"{rec.get("error") or rec.get("skipped") or ""}", flush=True)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))   # the launcher's kill runs the cleanup below
    try:
        main()
    finally:
        subprocess.run(["mise", "run", "server-stop"], cwd=ROOT, capture_output=True)
        BF.stop_daemons()

def vers_tools(repo):
    v = {}
    for f in [repo / ".mise.toml", *repo.glob("quotes-*/.mise.toml")]:
        for k, x in tomllib.loads(f.read_text()).get("tools", {}).items():
            v[f"{f.relative_to(repo)}:{k}"] = str(x)
    for f in [*repo.glob("quotes-*/Dockerfile"), repo / "docker-compose.yaml"]:
        for img in re.findall(r"(?m)^\s*(?:FROM|image:)\s+(\S+:\S+)", f.read_text()):
            v[f"{f.relative_to(repo)}:{img.rsplit(':', 1)[0]}"] = img.rsplit(":", 1)[1]
    for f in repo.glob(".github/workflows/*.y*ml"):
        for a, ref in re.findall(r"uses:\s*([\w.-]+/[\w./-]+)@(\S+(?:\s*#\s*\S+)?)", f.read_text()):
            v[f"{f.name}:{a}"] = ref
    return v


def num(s):
    return tuple(int(x) for x in re.findall(r"\d+", str(s).split("@")[-1])[:4])


def tag_exists(image, tag):
    """Anonymous registry v2 HEAD of image:tag. None when the registry can't be asked."""
    if tag in ("latest",) or "$" in image + tag:
        return None
    host, _, path = image.partition("/")
    if "." not in host:
        host, path = "registry-1.docker.io", image if "/" in image else f"library/{image}"
    try:
        tok = None
        if host == "registry-1.docker.io":
            tok = json.load(urllib.request.urlopen(
                f"https://auth.docker.io/token?service=registry.docker.io&scope=repository:{path}:pull", timeout=20))["token"]
        elif host == "gcr.io":
            tok = json.load(urllib.request.urlopen(f"https://gcr.io/v2/token?scope=repository:{path}:pull", timeout=20))["token"]
        req = urllib.request.Request(f"https://{host}/v2/{path}/manifests/{tag.split('@')[0]}", method="HEAD", headers={
            "Accept": "application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.docker.distribution.manifest.v2+json",
            **({"Authorization": f"Bearer {tok}"} if tok else {})})
        return urllib.request.urlopen(req, timeout=20).status == 200
    except urllib.error.HTTPError as e:
        return False if e.code == 404 else None
    except Exception:
        return None


def _j(url):
    return json.load(urllib.request.urlopen(url, timeout=30))


@functools.cache
def _gh_latest(repo):
    r = subprocess.run(["gh", "api", f"repos/{repo}/releases/latest", "-q", ".tag_name"], capture_output=True, text=True)
    return r.stdout.strip() or None


def version_exists(tool, ver, repo):
    """True when `mise ls-remote tool` has ver, or a release under the pin prefix ("25" -> 25.x).
    True also when mise can't list it (unknown is not counted as invalid)."""
    rc, o = sh(["mise", "ls-remote", tool], repo, 120)
    vs = o.split()
    return rc != 0 or not vs or any(x == ver or x.startswith(ver + ".") for x in vs)


def latest_versions():
    """Upstream latest for what the tools task can move. Missing entries are not checked."""
    L = {}
    for k, f in {"node": lambda: _j("https://nodejs.org/dist/index.json")[0]["version"].lstrip("v"),
                 "go": lambda: _j("https://go.dev/dl/?mode=json")[0]["version"].removeprefix("go"),
                 "npm:pnpm": lambda: _j("https://registry.npmjs.org/pnpm/latest")["version"],
                 "watchexec": lambda: _gh_latest("watchexec/watchexec").lstrip("v")}.items():
        try:
            L[k] = f()
        except Exception:
            pass
    return L


def tools_behind(v, L):
    """Entries of vers_tools(v) still behind upstream. Pins compare on the pinned prefix
    (node "25" vs 26.x is behind; "26" is not); "latest" is never behind. Actions compare
    the ratchet tag's major with the latest release's major; branch refs are skipped."""
    out = []
    for k, val in v.items():
        f, _, name = k.partition(":")
        if f.endswith(".mise.toml") and name in L and val != "latest":
            n = len(num(val))
            if num(val) < num(L[name])[:n]:
                out.append(f"{k}={val}<{L[name]}")
        elif "Dockerfile" in f or "docker-compose" in f:
            img = name.rsplit("/", 1)[-1]
            ref = {"golang": L.get("go"), "node": L.get("node")}.get(img)
            if ref and num(val) and num(val) < num(ref)[:len(num(val))]:
                out.append(f"{k}={val}<{ref}")
        elif f.endswith((".yml", ".yaml")) and (m := re.search(r"@(v\d[\w.]*)\s*$", val)):
            repo = "/".join(name.split("/")[:2])
            lat = _gh_latest(repo)
            if lat and num(m[1])[:1] < num(lat)[:1]:
                out.append(f"{k}={m[1]}<{lat}")
    return out


def vers_gradle(repo):
    d = repo / "quotes-backend"
    t = (d / "build.gradle.kts").read_text()
    v = dict(re.findall(r'(?m)^val (\w+Version) = "([^"]+)"', t))
    v |= {f"plugin:{a or b}": c for a, b, c in re.findall(r'(?m)^\s*(?:kotlin\("([^"]+)"\)|id\("([^"]+)"\))\s+version\s+"([^"]+)"', t)}
    w = (d / "gradle/wrapper/gradle-wrapper.properties").read_text()
    return v | {"gradle": (re.search(r"gradle-([\d.]+)-", w) or [None, None])[1]}



PINNED = re.compile(r"(^|/)(\.tool-versions|\.?mise\.toml|\.nvmrc|\.node-version|\.python-version|global\.json|"
                    r"gradle-wrapper\.properties|[Dd]ockerfile[^/]*|[^/]*\.dockerfile|(docker-)?compose\.ya?ml|nais\.ya?ml)$|"
                    r"\.github/(workflows|actions)/|\.nais/")   # mirrors local.PinnedFile (navikt/copilot #1832)
INFRA = re.compile(r"(?i)(postgres|redis|kafka|mysql|mariadb|mongo|valkey|rabbitmq)")
GATE_PINNED = "nav-pilot (local_dep_upgrade)"


def spent():
    try:
        return json.loads(Path(args.cost_ledger).read_text())["spent_usd"] if args.cost_ledger else 0.0
    except (OSError, ValueError, KeyError):
        return 0.0


def guards(task, g, log_text):
    """#285's guard violations, from the grade and the session log."""
    out = {"pinned_edits": [f for f in g["files"] if PINNED.search(f)] if task != "tools" else [],
           "infra_major": [k for k, (a, b) in g["moved"].items() if INFRA.search(k) and num(a)[:1] != num(b)[:1]],
           "nonexistent": list(g.get("checks", {}).get("missing_tags") or []),
           # pnpm pin moved off the lockfile's major, or the frozen install failed
           "pm_mismatch": [k for k, (a, b) in g["moved"].items() if k.endswith(":npm:pnpm") and num(a)[:1] != num(b)[:1]]
                          + (["frozen install failed"] if g.get("checks", {}).get("install") is False else []),
           "pinned_deny": log_text.count(GATE_PINNED)}
    out["n"] = sum(len(v) for k, v in out.items() if isinstance(v, list))
    return out


def hybrid_session(model, repo, prompt, log):
    """One nav-pilot hybrid session in a HOME of its own. The worker is the mlx-lm server
    restart_server started; nav-pilot attaches to it through a server.json written here,
    so nothing touches the real ~/.nav-pilot. Returns (rc, cloud cost, hybrid facts)."""
    import _np_checks as NC
    H = SourceFileLoader("bench_hybrid", str(HERE / "bench-hybrid")).load_module()
    prof = model
    served = P_params(prof)["MLX_MODEL"]
    man = OUT / "models.json"
    if not man.exists():
        NC.manifest(prof, str(man))
    entry = next(e for e in json.loads(man.read_text())["models"] if e["model"] == served)
    real = Path.home()
    copies = [".local/share/opencode/auth.json", ".nav-pilot/local/env.json"]
    copies += [str(f.relative_to(real)) for f in (real / ".nav-pilot").glob("*") if f.is_file() and f.name != "config.toml"]
    home, henv = S.own_home("nais-upgrade-np-", copies)
    shutil.copytree(real / ".cache/opencode", home / ".cache/opencode", dirs_exist_ok=True)   # see run_one: a fresh one hangs
    pid = H.port_pid(8080)
    lstart = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True,
                            env={**os.environ, "LC_ALL": "C"}).stdout.strip()
    (home / ".nav-pilot/local").mkdir(parents=True, exist_ok=True)
    (home / ".nav-pilot/local/server.json").write_text(json.dumps(
        {"pid": pid, "model": served, "started": __import__("datetime").datetime.now().astimezone().isoformat(timespec="seconds"), "port": 8080, "lstart": lstart}))
    cfg = home / ".nav-pilot/config.toml"
    cfg.write_text(f'version = 1\nmodel = "{args.cloud_model}"\nauto_update = false\nlocal_enabled = true\n'
                   f'local_model = "{entry["key"]}"\nlocal_dep_upgrade = {str(args.dep_upgrade == "on").lower()}\n')
    if args.skill:
        shutil.copytree(args.skill, repo / ".opencode/skills" / Path(args.skill).name, dirs_exist_ok=True)
    xdg = home / ".config"
    env = {k: v for k, v in os.environ.items() if not k.startswith("OPENCODE_CONFIG")}
    # cplt here is nav-pilot's, so the harness's argv grants never reach it: the toolchain grants come
    # from CPLT_CONFIG, and Go's caches live in the clone (git-excluded), the one tree it may write.
    env.update(henv, CPLT_CONFIG=str(CPLT_CFG), GOPATH=str(repo / ".gopath"), GOCACHE=str(repo / ".gopath/cache"),
               GOMODCACHE=str(GOMOD), GOFLAGS="-modcacherw",
               # the warm cache is the proxy (its latest = latest at warm time, verified then), so no fetch goes through cplt
               **({"GOPROXY": f"file://{GOMOD}/cache/download", "GOSUMDB": "off"} if args.go_warm else {}),
               XDG_CONFIG_HOME=str(xdg), NAV_PILOT_CONFIG=str(cfg), NAV_PILOT_BENCH_MANIFEST=str(man),
               CI="true", DOTNET_CLI_TELEMETRY_OPTOUT="1", PATH=f"{pnpm_bin(repo)}:{os.environ['PATH']}")
    # The user-level agent pack, into the temp HOME: a launch refuses to run with nothing installed.
    r = subprocess.run([args.np, "install", "--user", "--all", "--yes"], cwd=home, env=env, capture_output=True, text=True, timeout=600)
    if r.returncode:
        raise RuntimeError(f"nav-pilot install: {(r.stdout + r.stderr)[-300:]}")
    srv_log = ROOT / ".bench-logs" / "server-restart.log"
    off = srv_log.stat().st_size if srv_log.exists() else 0
    argv = [args.np, "--client", "opencode", "--model", args.cloud_model, "--", "run", "--format", "json", prompt]
    before = spent()
    with log.open("w") as fh:
        p = subprocess.Popen(argv, cwd=repo, stdout=fh, stderr=subprocess.STDOUT, env=env, start_new_session=True)
        rc, deadline = None, time.time() + args.cap_min * 60
        try:
            while (rc := p.poll()) is None:
                if time.time() > deadline:
                    rc = "timeout"
                    break
                txt = log.read_text(errors="replace")
                if "no server is running" in txt:   # would measure the cloud alone
                    rc = "no-worker"
                    break
                if time.time() > deadline - args.cap_min * 60 + 240 and '"type":"step_start"' not in txt.replace(" ", ""):
                    rc = "no-start"
                    break
                ev = H.parse_events(log.read_text(errors="replace"))
                if before + ev["cloud_cost_usd"] + ev["step_min_usd"] > args.cost_cap:
                    rc = "cost-cap"
                    break
                time.sleep(5)
        finally:
            kill_session(p.pid)
    text = log.read_text(errors="replace")
    ev = H.parse_events(text)
    policy = xdg / "opencode/nav-pilot-local-dispatch.md"
    with srv_log.open("rb") as fh:
        fh.seek(off)
        local_calls = fh.read().decode("utf8", "replace").count("POST /v1/chat/completions")
    tasks = [x for x in H.tool_parts(text) if x.get("tool") == "task"
             and (x.get("state") or {}).get("input", {}).get("subagent_type") == H.WORKER_AGENT]
    skill_used = any(x.get("tool") == "skill" for x in H.tool_parts(text))
    if args.cost_ledger:
        Path(args.cost_ledger).write_text(json.dumps({"spent_usd": round(before + ev["cloud_cost_usd"], 4),
                                                      "cap_usd": args.cost_cap}) + "\n")
    shutil.rmtree(home, ignore_errors=True)
    return rc, {"cloud_cost_usd": ev["cloud_cost_usd"], "cloud_steps": ev["cloud_steps"], "local_calls": local_calls,
                "worker_tasks": len(tasks), "local_share": round(local_calls / max(1, local_calls + ev["cloud_steps"]), 3),
                "announced": "Local dispatch: nav-pilot ends a turn" in text,
                "policy_dep_paragraph": policy.exists() and "Dependency upgrades (" in policy.read_text(),
                "skill_loaded": skill_used, "gate": H.gate_events(text, repo)}


def P_params(profile):
    import _profiles as P
    return P.load(profile)[1]


def run_one(model, task):
    repo = OUT / "clones" / f"{model}{'-' + args.arm if args.arm else ''}--{task}"
    if repo.exists():
        sh(["rm", "-rf", str(repo)], OUT)
    sh(["git", "clone", "-q", str(BASE), str(repo)], OUT)
    sh(["git", "remote", "remove", "origin"], repo)       # nothing to push to
    sh(["git", "branch", "base"], repo)
    sh(["git", "switch", "-q", "-c", f"upgrade/{task}-{model}"], repo)
    (repo / ".git/info/exclude").write_text("opencode.json\n.opencode/\nnode_modules/\n.pnpm-store/\n.next/\nAGENTS.local.md\n.gopath/\n")
    if subprocess.run(["mise", "run", "opencode-init", str(repo)], cwd=ROOT, capture_output=True).returncode:
        return {"error": "opencode-init failed"}
    before = VERS[task](repo)
    base_checks = checks(task, repo)
    red = [k for k, x in base_checks.items() if x is False]
    if red:
        return {"skipped": f"baseline red: {red}", "baseline": base_checks}
    for nm in [repo / "node_modules", *repo.glob("*/node_modules")]:   # the model starts from a clean tree
        shutil.rmtree(nm, ignore_errors=True)
    if args.np:
        log = OUT / "logs" / f"{model}-{args.arm}--{task}-{time.strftime('%H%M%S')}.jsonl"
        log.parent.mkdir(exist_ok=True)
        t0 = time.time()
        rc, hy = hybrid_session(model, repo, TASKS[task]["prompt"] + COMMON, log)
        for n in (1, 2):   # opencode under nav-pilot never starts in about half the launches; two retries, logs kept
            if rc != "no-start":
                break
            log = log.with_suffix(f".retry{n}.jsonl")
            rc, hy = hybrid_session(model, repo, TASKS[task]["prompt"] + COMMON, log)
        secs = round(time.time() - t0)
        sh(["git", "add", "-A"], repo)
        sh(["git", "-c", "user.name=bench", "-c", "user.email=bench@localhost", "commit", "-qm", f"upgrade {task}"], repo)
        g = grade(task, repo, before)
        return {"rc": rc, "seconds": secs, "arm": args.arm, "dep_upgrade": args.dep_upgrade,
                "skill": bool(args.skill), "cloud_model": args.cloud_model, "log": log.name,
                "guards": guards(task, g, log.read_text(errors="replace")), **hy, "baseline": base_checks, **g}
    home, henv = S.own_home("nais-upgrade-")   # never the real ~/.local/share/opencode, ~/.copilot, ~/.nav-pilot
    # opencode's package cache, copied (never linked): a fresh one makes opencode install
    # its packages at start-up, and execs from that tree are denied, so the session hangs.
    shutil.copytree(Path.home() / ".cache/opencode", home / ".cache/opencode", dirs_exist_ok=True)
    HOME_W = []   # write grants inside the temp HOME; not HOME itself, which would deny exec under .cache/opencode/bin
    for rel in (".local/share/opencode", ".cache/opencode", ".config", "go", "Library", ".npm", ".cache/go-build",
                ".gradle", ".m2", ".nuget", ".dotnet", ".local/share/NuGet"):
        (home / rel).mkdir(parents=True, exist_ok=True)
        HOME_W += ["--allow-write", str(home / rel)]
    env = S.bench_env({**os.environ, **henv, "CPLT_CONFIG": str(CPLT_CFG), "CI": "true",
                       "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
                       "DOTNET_CLI_HOME": str(home),   # a DOTNET_CLI_HOME outside the temp HOME is unwritable in the sandbox
                       # Java dials the Gradle daemon over an IPv6 socket (::ffff:127.0.0.1), which the
                       # sandbox's localhost rule doesn't match: "Could not connect to the Gradle daemon"
                       "JDK_JAVA_OPTIONS": "-Djava.net.preferIPv4Stack=true",
                       # the repo's pinned pnpm ahead of the global pnpm 12, and its store in the temp HOME
                       "PATH": f"{pnpm_bin(repo)}:{os.environ['PATH']}",
                       "npm_config_store_dir": str(home / "Library/pnpm/store")})
    prompt = TASKS[task]["prompt"] + COMMON
    argv = S.cplt_argv(repo, repo, "8080", extra=["--yes", "--quiet", *HOME_W,
                       *[x for e in ("CI", "JDK_JAVA_OPTIONS", "DOTNET_CLI_TELEMETRY_OPTOUT") for x in ("--pass-env", e)]])
    if argv is None:
        raise SystemExit("cplt missing; refusing to run unsandboxed")
    log = OUT / "logs" / f"{model}--{task}.jsonl"
    log.parent.mkdir(exist_ok=True)
    t0 = time.time()
    for start in (1, 2):   # opencode sometimes never starts (no event at all); one retry
        if start == 2:
            log = log.with_suffix(".retry.jsonl")   # keep the first attempt's log
        with log.open("w") as fh:
            p = subprocess.Popen(argv + ["--", "--pure", "--print-logs", "run", "--format", "json", prompt], cwd=repo,
                                 stdout=fh, stderr=subprocess.STDOUT, env=env, start_new_session=True)
            rc = "killed"
            try:
                deadline = time.time() + args.cap_min * 60
                while (rc := p.poll()) is None:
                    if time.time() > deadline:
                        rc = "timeout"
                        break
                    if time.time() - t0 > 240 and '"type":"step_start"' not in log.read_text().replace(" ", ""):
                        rc = "no-start"
                        break
                    time.sleep(5)
            finally:   # cap, stall, or SIGTERM from the launcher: the whole session goes
                kill_session(p.pid)
        if rc != "no-start":
            break
        t0 = time.time()
    shutil.rmtree(home, ignore_errors=True)
    secs = round(time.time() - t0)
    n_tools = sum(1 for x in log.read_text().splitlines() if '"type":"tool_use"' in x.replace(" ", ""))
    sh(["git", "add", "-A"], repo)
    sh(["git", "-c", "user.name=bench", "-c", "user.email=bench@localhost", "commit", "-qm",
        f"upgrade {task} ({model})"], repo)
    g = grade(task, repo, before)
    return {"rc": rc, "seconds": secs, "tool_calls": n_tools, "baseline": base_checks, **g}


def main():
    """0 when every model ran every task (a capped session is a result); 3 when a model,
    a task or the rest of the queue did not run, so the launcher leaves no done marker (#197)."""
    missed = 0
    meta = {"harness_sha": HSHA, "base_sha": sh(["git", "rev-parse", "--short", "HEAD"], BASE)[1].strip()}
    if args.np:
        meta["nav_pilot"] = Path(args.np).name
    for model in args.models.split(","):
        if subprocess.run(["mise", "run", "model-use", model], cwd=ROOT, capture_output=True).returncode:
            print(f"✗ model-use {model} failed; skipping", flush=True)
            missed += 1
            continue
        for task in args.tasks.split(","):
            if args.deadline and time.time() + args.cap_min * 60 > args.deadline:
                print("deadline: stopping", flush=True)
                return 3
            if args.np and spent() >= args.cost_cap - 0.5:
                print(f"cost cap ${args.cost_cap}: stopping", flush=True)
                return 3
            if not restart_server():
                rec = {"error": "server did not start"}
            else:
                try:
                    rec = run_one(model, task)
                except Exception as e:   # one task failing never stops the queue
                    rec = {"error": f"{type(e).__name__}: {e}"[:500]}
            subprocess.run(["mise", "run", "server-stop"], cwd=ROOT, capture_output=True)
            BF.stop_daemons()   # PID-only, sandbox-started Gradle/Kotlin daemons + orphan shm
            missed += "error" in rec or "skipped" in rec
            rec = {"model": model, "task": task, **meta, "at": time.strftime("%F %T"), **rec}
            with (OUT / "results.jsonl").open("a") as fh:
                fh.write(json.dumps(rec) + "\n")
            print(f"{'✓' if rec.get('pass') else '✗'} {model} {task} {rec.get('seconds')}s "
                  f"moved={rec.get("n_moved")} full={rec.get("fully_upgraded")} green={rec.get('green')} unrelated={len(rec.get('unrelated') or [])} "
                  f"{rec.get("error") or rec.get("skipped") or ""}"
                  + (f" local={rec.get('local_calls')} tasks={rec.get('worker_tasks')} ${rec.get('cloud_cost_usd')} "
                     f"guards={(rec.get('guards') or {}).get('n')} pinned_deny={(rec.get('guards') or {}).get('pinned_deny')}"
                     if args.np else ""), flush=True)
    return 3 if missed else 0


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))   # the launcher's kill runs the cleanup below
    try:
        rc = main()
    finally:
        subprocess.run(["mise", "run", "server-stop"], cwd=ROOT, capture_output=True)
        BF.stop_daemons()
        shutil.rmtree(GRADER_HOME, ignore_errors=True)
    sys.exit(rc)

def mise(cmd, cwd, timeout=900):
    # CI=true: without it pnpm aborts on a no-TTY modules purge (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY)
    return sh(f"mise exec -- {cmd}", cwd, timeout, {**os.environ, "CI": "true", "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
                                                        "NUGET_PACKAGES": str(GRADER_HOME / "nuget"),

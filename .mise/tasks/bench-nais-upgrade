    return dict(re.findall(r"(?m)^\s*(?:require\s+)?([\w./-]+\.[\w./-]+)\s+(v[\w.+-]+)\s*$", t)) | \
        {"go": (re.search(r"(?m)^go (\S+)", t) or [None, None])[1]}


def vers_pkg(repo):

#!/usr/bin/env python3
# mise description="Run the weather-cli challenge headless for the active model. Usage: mise run bench-weather-cli"
"""Drive the weather-cli challenge without a human at the keyboard.

The two prompts are the ones in MODELS.md, verbatim, issued as one opencode
session so the second turn sees the plan the first produced. Changing their
wording invalidates comparison with every earlier run.

Verification is `npm test` run here, never the model's claim about it. One
earlier submission reported "20/20 passing" with eight assertions inside a
catch block that swallowed them.

Previous submissions live in git. This task clears the workspace, so commit
anything worth keeping before running it.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]

PLAN = ("Read the weather-cli/WEATHER_CLI_SPEC.md and make a short and concrete "
        "implementation plan make sure you have a good understanding about the "
        "external services and their data strucure for input / output data. "
        "Check the external apis do not assume the data model")
IMPLEMENT = ("Lets start implementing, check your work and ensure tests and the "
             "final cli works according to the supplied specification")

key = os.environ.get("MLX_ACTIVE_PROFILE", "").strip()
if not key:
    sys.exit("✗ MLX_ACTIVE_PROFILE not set — run: mise run model-use")

ws = ROOT / "workspaces" / key
cli = ws / "weather-cli"
# One file per run, not one per model. Three runs an arm is the point of this
# round, and a canonical name would leave the third overwriting the second with
# nothing to say it had. That already cost the ops suite a run once.
_tag = os.environ.get("BENCH_RUN_TAG", "").strip()
results_path = ROOT / "bench" / f"weather-{key}{'-' + _tag if _tag else ''}.json"
# One cap for both phases was calibrated for the long one. Across eight non-void
# turns the plan phase ran 25s to 302s and the implement phase 49s to 2862s, so a
# 5400s cap let a broken plan turn burn 90 minutes before anyone knew. The plan
# cap is three times its observed maximum; the implement cap keeps 47% headroom
# over the slowest turn that ever succeeded, because a cap that clips the slow
# model's successful runs manufactures the result.
CAPS = {"plan": int(os.environ.get("BENCH_WEATHER_PLAN_TIMEOUT", "900")),
        "implement": int(os.environ.get("BENCH_WEATHER_TIMEOUT", "4200"))}


def sh(cmd, cwd=None, timeout=1800):
    return subprocess.run(cmd, cwd=cwd and str(cwd), capture_output=True,
                          text=True, timeout=timeout)


def restart_server():
    """Start from a fresh server process.

    The server dies rather than degrades: a stack overflow in MLX's recursive
    graph walk kills the generation thread, the socket goes with it, and every
    later request gets connection refused. See issue #11. A weather-cli run is
    long enough to hit it, so at least start from a known-good process.
    """
    log = ROOT / ".bench-logs" / "server-restart.log"
    for attempt in range(3):
        subprocess.run(["mise", "run", "server-stop"], cwd=str(ROOT), capture_output=True)
        time.sleep(2)
        with log.open("a") as fh:
            subprocess.Popen(["mise", "run", "server"], cwd=str(ROOT),
                             stdout=fh, stderr=subprocess.STDOUT,
                             start_new_session=True)
        r = sh(["mise", "run", "server-wait"], cwd=ROOT, timeout=1800)
        if r.returncode == 0:
            return
        print(f"   ⚠ server did not come back (attempt {attempt + 1} of 3)")
    raise SystemExit(f"✗ server did not come back: {r.stdout}{r.stderr}")


def turn(label, args):
    """One opencode turn.

    The raw output is written to .bench-logs before the regexes touch it. Traps
    7 and 8 in the rubric are read from the transcript, not from the code, and
    the first weather round could not be scored on either because this function
    used the output for token counts and dropped it.
    """
    started = time.time()
    timed_out = False
    try:
        r = sh(["mise", "run", "opencode-headless", *args], cwd=ROOT, timeout=CAPS[label])
        out = r.stdout + r.stderr
    except subprocess.TimeoutExpired as e:
        timed_out = True
        out = (e.stdout or b"").decode("utf8", "replace") + (e.stderr or b"").decode("utf8", "replace")
        # subprocess kills `mise run`, not the client underneath it. In the
        # 184632 round a plan turn was capped at 21:48:05 and its opencode kept
        # working until 22:24:57, 37 minutes, holding the single-generation
        # server. The implement turn that followed got
        # ProviderHeaderTimeoutError with nothing to show, and the round blamed
        # the model. The ops suite has had this pkill since the day six orphans
        # put the machine into swap; this suite reimplemented the runner without
        # it.
        subprocess.run(["/usr/bin/pkill", "-f", "opencode --pure"], capture_output=True)
        subprocess.run(["/usr/bin/pkill", "-f", "cplt --agent opencode"], capture_output=True)
        time.sleep(2)
    elapsed = time.time() - started

    def grab(pat, cast=str, default=None):
        m = re.search(pat, out)
        return cast(m.group(1).replace(",", "")) if m else default

    # The killed wrapper never prints its summary line, so every counter parsed
    # out of it reads zero. Run 05 of the 184632 round was recorded as 0 turns
    # and 0 tool calls where the session log holds 124 tool calls and 117 curl
    # attempts. Zero reads as "the model did nothing", which is the opposite of
    # what happened. None reads as "not measured".
    def count(pat, cast=int):
        return None if timed_out else grab(pat, cast, 0)

    rec = {
        "phase": label,
        "seconds": round(elapsed, 1),
        # Which cap this turn ran under. The caps changed once already, and a
        # duration means nothing without the limit it was measured against.
        "cap_seconds": CAPS[label],
        "turns": count(r"· (\d+) turns"),
        "tool_calls": count(r"· (\d+) tool calls"),
        "tokens_in": count(r"in ([\d,]+) ·"),
        "tokens_out": count(r"out ([\d,]+) ·"),
        "truncated": "TRUNCATED" in out,
        "timed_out": timed_out,
    }
    log = ROOT / ".bench-logs" / f"weather-{key}{'-' + _tag if _tag else ''}-{label}.log"
    log.write_text(out)
    rec["transcript"] = str(log.relative_to(ROOT))
    # The wrapper summary is not the session. Traps 7 and 8 are scored from what
    # the model actually sent, and they came back n/a five times running because
    # this pointed at a twelve-line stub. opencode names its own log; keep it.
    m = re.search(r"log: (\.bench-logs/\S+\.jsonl)", out)
    rec["session_log"] = m.group(1) if m else None

    def n(v):
        return "?" if v is None else f"{v:,}"

    print(f"   {label}: {rec['seconds']}s · {n(rec['turns'])} turns · "
          f"{n(rec['tool_calls'])} tools · out {n(rec['tokens_out'])}"
          + ("  ⚠ TRUNCATED" if rec["truncated"] else "")
          + ("  ⚠ TIMED OUT" if timed_out else ""))
    return rec


def run_tests():
    """npm test in the submission. Counts come from the runner, not the model."""
    if not cli.is_dir() or not (cli / "package.json").exists():
        return {"ran": False, "note": "no package.json, nothing to test"}
    if not (cli / "node_modules").is_dir():
        inst = sh(["npm", "install", "--no-audit", "--no-fund"], cwd=cli, timeout=900)
        if inst.returncode != 0:
            return {"ran": False, "note": "npm install failed", "tail": inst.stderr[-800:]}
    try:
        t = sh(["npm", "test"], cwd=cli, timeout=900)
    except subprocess.TimeoutExpired:
        return {"ran": True, "passed": False, "note": "test run timed out"}
    out = t.stdout + t.stderr
    # node:test, jest and mocha are all in play across submissions, so read
    # whichever counter is present rather than assuming a runner. The first four
    # runs reported null counts because only the first two were handled.
    def num(*pats):
        for pat in pats:
            m = re.search(pat, out)
            if m:
                return int(m.group(1))
        return None
    return {
        "ran": True,
        "passed": t.returncode == 0,
        "exit": t.returncode,
        "runner": ("node:test" if re.search(r"[#ℹ] pass \d+", out) else
                   "jest" if "Tests:" in out else
                   "mocha" if "passing" in out else "unknown"),
        "pass_count": num(r"[#ℹ] pass (\d+)",
                          r"Tests:\s+(?:\d+ failed, )?(\d+) passed",
                          r"(\d+) passing"),
        "fail_count": num(r"[#ℹ] fail (\d+)",
                          r"Tests:\s+(\d+) failed",
                          r"(\d+) failing"),
        "tail": out[-1500:],
    }


def session_id_from(rec):
    """The session the plan turn created, read from its own event stream.

    `--continue` resolves to the most recently updated session in the whole
    opencode project, with no directory filter: 900+ sessions across 16
    workspaces share one project here. It picks this run's plan session only
    because that is usually the newest. If a plan turn fails to create one, the
    implement turn continues the other arm's session, in the other arm's
    workspace, under this arm's model, and nothing in the record would say so.
    """
    log = rec.get("session_log")
    if not log:
        return None
    for line in (ROOT / log).read_text().splitlines():
        line = line.strip()
        if line.startswith("{") and '"sessionID"' in line:
            try:
                return json.loads(line)["sessionID"]
            except (ValueError, KeyError):
                continue
    return None


print(f"→ weather-cli · {key}")
if os.environ.get("BENCH_KEEP_WORKSPACE") != "1":
    # Read the exit code. workspace-clear refuses to delete git-tracked files and
    # says so on stderr, and this printed the last line of an empty stdout as
    # "nothing to do". The weather-cli trees were tracked by mistake on 3
    # September, so six runs in a row each began on top of the finished code of
    # the one before, and the log said the workspace had been cleared.
    c = sh(["mise", "run", "workspace-clear", "-y"], cwd=ROOT)
    if c.returncode != 0:
        raise SystemExit("✗ workspace-clear failed, so this run would start from the "
                         f"last one's code:\n{(c.stdout + c.stderr).strip()}")
    print(f"   {c.stdout.strip().splitlines()[-1] if c.stdout.strip() else 'workspace cleared'}")

# The suite provisions the spec, AGENTS.md and opencode.json on launch. Anything
# else the agent can read is either a leftover or an answer.
_allowed = {"AGENTS.md", "opencode.json", "weather-cli", ".DS_Store"}
_stray = sorted(q.name for q in ws.iterdir() if q.name not in _allowed) if ws.is_dir() else []
if _stray:
    raise SystemExit(f"✗ {ws} holds {', '.join(_stray)}, which the agent can read.\n"
                     "  Remove them before measuring anything.")
restart_server()

record = {"model_key": key, "phases": []}
plan = turn("plan", [PLAN])
record["phases"].append(plan)

sid = session_id_from(plan)
record["session_id"] = sid
if sid:
    resume = ["--session", sid]
else:
    print("   ⚠ plan turn created no session; falling back to --continue, which is "
          "not scoped to this workspace")
    resume = ["--continue"]
record["phases"].append(turn("implement", [*resume, IMPLEMENT]))
record["total_seconds"] = round(sum(p["seconds"] for p in record["phases"]), 1)

print("   running npm test")
record["tests"] = run_tests()
record["files"] = sorted(str(p.relative_to(cli)) for p in cli.rglob("*")
                         if p.is_file() and "node_modules" not in p.parts) if cli.is_dir() else []

# Before the next run's workspace-clear deletes it. Three runs an arm is the
# point of this round, and the first one left two code trees out of six: each
# run cleared the workspace its predecessor had written into.
if cli.is_dir():
    dest = ROOT / "bench" / "submissions" / f"{key}{'-' + _tag if _tag else ''}"
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(cli, dest, ignore=shutil.ignore_patterns("node_modules"))
    record["submission"] = str(dest.relative_to(ROOT))
    print(f"   archived submission → {record['submission']}")

results_path.write_text(json.dumps(record, indent=2))
t = record["tests"]
verdict = "✓" if t.get("passed") else "✗"
print(f"\n{verdict} {record['total_seconds']}s total · {len(record['files'])} files · "
      f"tests {'pass' if t.get('passed') else 'fail'} "
      f"({t.get('pass_count')} passed, {t.get('fail_count')} failed)")
print(f"✓ Results → {results_path.relative_to(ROOT)}")
print("  Grade the code against the rubric in MODELS.md. The test result is not the grade.")

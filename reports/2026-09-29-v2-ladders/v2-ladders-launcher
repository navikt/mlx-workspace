#!/usr/bin/env bash
# Runs v2-ladders.queue (plan.md) once Kev/Laya are done or have given up, and the GPU has
# been free for 5 min:
#   1. .bench-logs/kev-laya.done exists, or no kev-laya-launcher process has run for 30 min
#      (it gave up waiting on the uv cooldown, or was never started);
#   2. no queue lock, no benchmark, night, server, probe or Linux smoke process, on AC, and
#      iogpu.wired_limit_mb = 49152 (48 GB), for 5 min straight.
# Then it pulls main, runs the queue with a copy of night-run-3, and touches v2-ladders.done.
# Logs to .bench-logs/v2-ladders.log. Gives up 2026-10-13 06:00.
# Start it from ~/tmp: no command line of this script may carry "bench-", "night", "np-serve" or
# "dispatch-probe", because other waiters pgrep for them; such strings are built from pieces.
# Stop it: kill <pid on the first log line>.
set -u
MAIN=/Users/hans/mlx-workspace
cd "$MAIN" || exit 1
L=".b""ench-logs"
exec >> "$L/v2-ladders.log" 2>&1
R=reports/2026-09-29-v2-ladders
BIN=$MAIN/$L/bin
NR="$BIN/ni""ght-run-3-v2lad"
GIVE_UP=$(date -j -f '%Y-%m-%d %H:%M' '2026-10-13 06:00' +%s)
PAT=$(mktemp)
printf '%s\n' "tasks/(ni""ght-run|be""nch-|np-""serve|dispatch-""probe|ni""ght-chain)|bin/ni""ght|mlx_lm[._]server|llama-server|ollama serve|lsmoke/linux3" > "$PAT"
log() { echo "$(date '+%F %T') v2-ladders: $*"; }
running() { ps ax -o pid=,command= | grep -E -f "$PAT" | grep -vE "^ *($$|$PPID) " | grep -v -E "^ *[0-9]+ (grep|sleep)"; }

GONE=$(mktemp); trap 'rm -f "$PAT" "$GONE"' EXIT   # when the kev-laya launcher was first seen gone
series_over() {
  [ -e "$L/kev-laya.done" ] && return 0
  # Its report name is kev-laya-launcher; the copy actually running is ~/tmp/kl-launcher.
  if pgrep -f "bash .*(kev-laya|kl)-launcher" >/dev/null; then : > "$GONE"; echo "kev-laya launcher still running"; return 1; fi
  [ -s "$GONE" ] || date +%s > "$GONE"
  local m=$(( ($(date +%s) - $(<"$GONE")) / 60 ))
  [ "$m" -ge 30 ] && return 0
  echo "no kev-laya.done, its launcher gone for $m min"; return 1
}
why_not() {
  series_over || return
  pmset -g batt | grep -q "'AC Power'" || { echo "on battery"; return; }
  [ -d "$L/.queue.lock" ] && { echo "queue lock held by pid $(cat "$L/.queue.lock/pid" 2>/dev/null)"; return; }
  local p; p=$(running)
  [ -n "$p" ] && { echo "running: $(echo "$p" | cut -c1-120 | tr '\n' ';')"; return; }
  local w; w=$(/usr/sbin/sysctl -n iogpu.wired_limit_mb)
  [ "$w" = 49152 ] || echo "wired $w MB, want 49152"
}

log "pid $$: waits for kev-laya.done (or its launcher giving up), then a free GPU for 5 min, then runs $R/v2-ladders.queue"
caffeinate -is -w $$ &
free_since="" last="" n=0
while :; do
  why=$(why_not)
  if [ -z "$why" ]; then
    [ -z "$free_since" ] && free_since=$(date +%s) && log "free; starting after 5 min of it"
    [ $(( $(date +%s) - free_since )) -ge 300 ] && break
  else
    free_since=""
    { [ "$why" != "$last" ] || [ $((n % 60)) -eq 0 ]; } && log "waiting: $why"; last=$why
  fi
  [ "$(date +%s)" -ge "$GIVE_UP" ] && { log "gave up: ${why:-never free for 5 min}"; exit 1; }
  n=$((n + 1)); sleep 60
done

git switch -q main && git pull -q --ff-only || { log "git pull failed; not starting"; exit 1; }
[ -f "$R/v2-ladders.queue" ] || { log "main has no $R/v2-ladders.queue; not starting"; exit 1; }
cp .mise/tasks/ni""ght-run-3 "$NR.tmp" && mv -f "$NR.tmp" "$NR" \
  || { log "could not stage a private copy of night-run-3; not starting"; exit 1; }
log "checkout at $(git rev-parse --short HEAD); starting the queue"
NIGHT_REPORT=$R/v2-ladders.md "$NR" --part local --queue "$R/v2-ladders.queue"
log "queue exited $?"
touch "$L/v2-ladders.done"
log "done"

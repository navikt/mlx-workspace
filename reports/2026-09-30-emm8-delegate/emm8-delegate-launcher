#!/usr/bin/env bash
# 8-bit emm follow-up (plan.md, emm8-delegate.queue). NOT ARMED by the repo. Arm it:
#   cp reports/2026-09-30-emm8-delegate/emm8-delegate-launcher ~/tmp/ && nohup bash ~/tmp/emm8-delegate-launcher >/dev/null 2>&1 &
# Logs to .bench-logs/emm8-delegate.log. Follows BENCHMARKING.md, "Waiting launchers":
#   - waits for requeue-64-6c.done and for PRs #161 and #162 to be merged (their merge job cleans
#     untracked copies before a pull), then for a free GPU for 5 min straight: no queue lock, no
#     benchmark, night-run or model-server process, nothing on :8080, AC, 48 GB wired, load below 6;
#   - also waits until cplt allows localhost on any port (sandbox.allow_localhost_any). Without it the
#     agent's ./gradlew cannot reach its Gradle daemon ("Could not connect to the Gradle daemon"),
#     which has skewed every agent-run build since 29 Sep 15:11 (plan.md, "Before it runs");
#   - one instance (emm8-delegate.pid), never twice (exits at start and after the wait if
#     emm8-delegate.done exists); touches emm8-delegate.done only once the queue has run.
# Before the run it checks that bench/frontier/validated-*.json exists.
# No command line run while it waits carries "bench-", "night", "np-serve" or "dispatch-probe".
# Gives up after 72 h. Stop it: kill <pid on the first log line>.
set -u
MAIN=/Users/hans/mlx-workspace
cd "$MAIN" || exit 1
L="$MAIN/.b""ench-logs"
exec >> "$L/emm8-delegate.log" 2>&1
R=reports/2026-09-30-emm8-delegate
AFTER="$L/requeue-64-6c.done"
DONE="$L/emm8-delegate.done" PIDF="$L/emm8-delegate.pid"
NP="$L/bin/nav-pilot-main-2bcca023"
NR="$L/bin/ni""ght-run-3-emm8"
BUSY="tasks/(ni""ght-run|be""nch-|np-""serve|dispatch-""probe|ni""ght-chain)|bin/ni""ght|mlx_lm[._]server|llama-server|ollama serve"
GIVE_UP=$(( $(date +%s) + 259200 ))
say() { echo "[$(date '+%F %T')] emm8-delegate: $*"; }
blocker() {
  [ -e "$AFTER" ] || { echo "no $AFTER yet (phase C requeue)"; return; }
  local n; for n in 161 162; do
    [ "$(gh pr view "$n" --repo navikt/mlx-workspace --json state -q .state 2>/dev/null)" = MERGED ] || { echo "PR #$n not merged"; return; }
  done
  [ "$(cplt config get sandbox.allow_localhost_any 2>/dev/null | head -1)" = true ] || { echo "cplt blocks localhost, so gradle cannot reach its daemon (cplt config set sandbox.allow_localhost_any true)"; return; }
  [ -d "$L/.queue.lock" ] && { echo "queue lock held by pid $(cat "$L/.queue.lock/pid" 2>/dev/null)"; return; }
  local p; p=$(pgrep -fl "$BUSY" | grep -vE "^($$|$PPID) ")
  [ -n "$p" ] && { echo "running: $(echo "$p" | head -1 | cut -c1-100)"; return; }
  /usr/sbin/lsof -tiTCP:8080 -sTCP:LISTEN >/dev/null 2>&1 && { echo "port 8080 in use"; return; }
  pmset -g batt | head -1 | grep -q "AC Power" || { echo "not on AC"; return; }
  [ "$(/usr/sbin/sysctl -n iogpu.wired_limit_mb)" = 49152 ] || { echo "wired limit $(/usr/sbin/sysctl -n iogpu.wired_limit_mb) MB, want 49152"; return; }
  awk '{exit !($2 < 6)}' <<<"$(/usr/sbin/sysctl -n vm.loadavg | tr -d '{}')" || echo "load $(/usr/sbin/sysctl -n vm.loadavg)"
}
[ -e "$DONE" ] && { say "pid $$: $DONE exists; not running twice"; exit 0; }
op=$(cat "$PIDF" 2>/dev/null)
[ -n "$op" ] && [ "$op" != $$ ] && kill -0 "$op" 2>/dev/null && { say "pid $$: pid $op already waits; exiting"; exit 0; }
echo $$ > "$PIDF"
trap 'rm -f "$PIDF"' EXIT   # a kill, a give-up or a failed check leaves no done marker
say "pid $$: runs $R/emm8-delegate.queue after $AFTER, #161 and #162 merged, and 5 min of free GPU"
caffeinate -is -w $$ &
stable=0 last=""
while :; do
  [ "$(date +%s)" -lt "$GIVE_UP" ] || { say "gave up: $last"; exit 1; }
  b=$(blocker)
  if [ -z "$b" ]; then stable=$((stable + 1)); [ "$stable" -ge 5 ] && break
  else stable=0; [ "$b" != "$last" ] && say "waiting: $b"; fi
  last=$b; sleep 60
done
[ -e "$DONE" ] && { say "$DONE appeared while waiting; not running twice"; exit 0; }
[ -x "$NP" ] || { say "no binary $NP; not running"; exit 1; }
git switch -q main && git pull -q --ff-only origin main || { say "git pull --ff-only failed; not running"; exit 1; }
[ -f "$R/emm8-delegate.queue" ] || { say "main has no $R/emm8-delegate.queue; not running"; exit 1; }
[ -f reports/2026-09-26-64gb-tier/capabilities-bench-only-64-6c.json ] || { say "no overlay on main; not running"; exit 1; }
compgen -G "bench/frontier/validated-*.json" >/dev/null || { say "no bench/frontier/validated-*.json; not running"; exit 1; }
cp .mise/tasks/ni""ght-run-3 "$NR.tmp" && mv -f "$NR.tmp" "$NR" || { say "could not stage a copy of night-run-3; not running"; exit 1; }
# From here the queue runs: any exit marks it done, before anything slow.
trap ': > "$DONE"; rm -f "$PIDF"; say "done marker"; git switch -q main 2>/dev/null' EXIT
trap 'exit 130' INT TERM
say "checkout at $(git rev-parse --short HEAD); overlay capabilities-bench-only-64-6c.json, cap \$8"
BENCH_NAV_PILOT="$NP" BENCH_NP_CONFIG_LINE='local_dispatch = "aggressive"' \
  BENCH_CAPABILITIES_OVERRIDE="$MAIN/reports/2026-09-26-64gb-tier/capabilities-bench-only-64-6c.json" \
  FRONTIER_COST_CAP=8 FRONTIER_CLOUD_MODEL=claude-sonnet-5 FRONTIER_MODEL=qwen3.6-35b-a3b-8bit-64g \
  NIGHT_HYBRID_TAG=np-2bcca023-sonnet5-aggressive-emm8 NIGHT_REPORT="$R/emm8-delegate-results.md" \
  "$NR" --part all --queue "$R/emm8-delegate.queue"
say "queue exited $?"
